{
  "$ref": "#/definitions/matches",
  "definitions": {
    "matches": {
      "type": "object",
      "properties": {
        "tournamentId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "roundId": {
          "type": "string",
          "minLength": 1
        },
        "team1Source": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "winner"
                },
                "matchId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "matchId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "loser"
                },
                "matchId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "matchId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "bye"
                },
                "byeId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "byeId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "team2Source": {
          "$ref": "#/definitions/matches/properties/team1Source"
        },
        "date": {
          "type": "string"
        },
        "team1Id": {
          "type": "string",
          "minLength": 1
        },
        "team2Id": {
          "type": "string",
          "minLength": 1
        },
        "score1": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "score2": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "winnerId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "upcoming",
            "live",
            "completed"
          ],
          "default": "upcoming"
        },
        "bracketSlot": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "roundDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round_number": {
                "type": "number"
              },
              "mapId": {
                "type": "string",
                "minLength": 1
              },
              "winnerId": {
                "type": "string",
                "minLength": 1
              },
              "resultNote": {
                "type": "string",
                "minLength": 1
              },
              "mvp": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "round_number",
              "mapId"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "duration": {
          "type": "string"
        },
        "mvp": {
          "type": "string"
        },
        "stats1": {
          "type": "object",
          "properties": {
            "kills": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "deaths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "assists": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false,
          "default": {
            "kills": 0,
            "deaths": 0,
            "assists": 0
          }
        },
        "stats2": {
          "type": "object",
          "properties": {
            "kills": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "deaths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "assists": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false,
          "default": {
            "kills": 0,
            "deaths": 0,
            "assists": 0
          }
        },
        "playerStats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "teamId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ign": {
                "type": "string"
              },
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "round_number": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "kills": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "deaths": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "assists": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "teamId"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "tournamentId",
        "stageId",
        "roundId",
        "date",
        "bracketSlot"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}