{
  "$ref": "#/definitions/players",
  "definitions": {
    "players": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ign": {
          "type": "string"
        },
        "uid": {
          "type": [
            "string",
            "null"
          ]
        },
        "team": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "default": "Player"
        },
        "avatar": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "socials": {
          "type": "object",
          "properties": {
            "discord": {
              "type": "string"
            },
            "twitter": {
              "type": "string"
            },
            "youtube": {
              "type": "string"
            },
            "twitch": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "stats": {
          "type": "object",
          "properties": {
            "kills": {
              "type": "number",
              "default": 0
            },
            "deaths": {
              "type": "number",
              "default": 0
            },
            "assists": {
              "type": "number",
              "default": 0
            },
            "matchesPlayed": {
              "type": "number",
              "default": 0
            },
            "mvpCount": {
              "type": "number",
              "default": 0
            }
          },
          "additionalProperties": false,
          "default": {
            "kills": 0,
            "deaths": 0,
            "assists": 0,
            "matchesPlayed": 0,
            "mvpCount": 0
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "ign"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}