        "name": {
          "type": "string"
        },
        "game": {
          "type": "string",
          "default": "crossfire-legends"
        },
        "region": {
          "type": "string",
          "default": "ID"
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "status": {
