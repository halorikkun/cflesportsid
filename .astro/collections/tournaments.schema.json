{
  "$ref": "#/definitions/tournaments",
  "definitions": {
    "tournaments": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "game": {
          "type": "string",
          "default": "crossfire-legends"
        },
        "region": {
          "type": "string",
          "default": "ID"
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "upcoming",
            "ongoing",
            "completed"
          ],
          "default": "upcoming"
        },
        "format": {
          "type": "string",
          "const": "single-elimination"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "const": "single-elimination"
              },
              "bracketSize": {
                "type": "integer",
                "minimum": 2
              },
              "series": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "fixed-maps"
                  },
                  "mapCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "type",
                  "mapCount"
                ],
                "additionalProperties": false
              },
              "veto": {
                "type": "object",
                "properties": {
                  "mapPoolIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 3
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "team": {
                          "type": "string",
                          "enum": [
                            "A",
                            "B"
                          ]
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "ban",
                            "pick"
                          ]
                        }
                      },
                      "required": [
                        "team",
                        "action"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 2
                  },
                  "finalMap": {
                    "type": "string",
                    "const": "random"
                  },
                  "actionSeconds": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "reserveSeconds": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "mapPoolIds",
                  "steps",
                  "finalMap",
                  "actionSeconds",
                  "reserveSeconds"
                ],
                "additionalProperties": false
              },
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "round_number": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "placement": {
                      "type": "number",
                      "enum": [
                        1,
                        3
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "order"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "byes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "roundId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slot": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "teamId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "roundId",
                    "slot",
                    "teamId"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "name",
              "format",
              "bracketSize",
              "series",
              "rounds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "winner": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "startDate",
        "endDate",
        "format",
        "stages"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}