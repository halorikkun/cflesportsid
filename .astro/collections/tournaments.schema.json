            "upcoming",
            "ongoing",
            "completed"
          ],
          "default": "upcoming"
        },
        "format": {
          "type": "string"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "winner": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "startDate",
        "endDate",
        "format"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}