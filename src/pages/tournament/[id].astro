---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');
  const tournamentNames = [...new Set(matches.map(m => m.data.tournament || 'CFL Esports ID Tournament'))];
  return tournamentNames.map((name, i) => ({
    params: { id: String(i + 1) },
    props: { tournamentName: name },
  }));
}

const { tournamentName } = Astro.props;

const matches = await getCollection('matches');
const teams = await getCollection('teams');

const tMatches = matches.filter(m => (m.data.tournament || 'CFL Esports ID Tournament') === tournamentName);

const tournamentNames = [...new Set(matches.map(m => m.data.tournament || 'CFL Esports ID Tournament'))];
const tournaments = tournamentNames.map((name, i) => ({ name, id: i + 1 }));

const ROUND_ORDER = [
  'First Round', 'Second Round', 'Third Round',
  'Top 16', 'Quarter Final', 'Semi Final', 'Final'
];

const BRACKET_ROUNDS = ROUND_ORDER;
const SPECIAL_ROUNDS = ['Bronze Match'];

const bracketMatches = tMatches.filter(m => BRACKET_ROUNDS.includes(m.data.round));
const specialMatches = tMatches.filter(m => SPECIAL_ROUNDS.includes(m.data.round));

// Group bracket matches by round
const byRound = {};
bracketMatches.forEach(m => {
  const round = m.data.round;
  if (!byRound[round]) byRound[round] = [];
  byRound[round].push(m);
});

const rounds = Object.keys(byRound).sort((a, b) => {
  const ia = ROUND_ORDER.indexOf(a);
  const ib = ROUND_ORDER.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});

// Sort matches within each round by bracketSlot
rounds.forEach(r => {
  byRound[r].sort((a, b) => (a.data.bracketSlot || 0) - (b.data.bracketSlot || 0));
});

// Build combined entries (matches + byes) for each round
// A "bye" is auto-detected when a slot is missing but the next round expects it
const roundEntries = {};
rounds.forEach((round, roundIdx) => {
  const entries = [];
  const existingSlots = new Set();

  byRound[round].forEach(m => {
    const slot = m.data.bracketSlot || 0;
    existingSlots.add(slot);
    entries.push({ type: 'match', slot, match: m });
  });

  // If not the last bracket round, detect byes
  if (roundIdx < rounds.length - 1) {
    const nextRound = rounds[roundIdx + 1];
    const nextMatches = byRound[nextRound];
    const expectedSlots = nextMatches.length * 2;

    for (let slot = 1; slot <= expectedSlots; slot++) {
      if (!existingSlots.has(slot)) {
        // Find the bye team from the next round's match
        const targetSlot = Math.ceil(slot / 2);
        const targetMatch = nextMatches.find(m => (m.data.bracketSlot || 0) === targetSlot);

        if (targetMatch) {
          // The paired slot (sibling) has a winner
          const pairedSlot = slot % 2 === 1 ? slot + 1 : slot - 1;
          const pairedMatch = byRound[round].find(m => (m.data.bracketSlot || 0) === pairedSlot);
          const pairedWinner = pairedMatch?.data.winner;

          // Bye team = the QF participant that didn't come from the paired match
          const byeTeam = pairedWinner === targetMatch.data.team1
            ? targetMatch.data.team2
            : targetMatch.data.team1;

          entries.push({ type: 'bye', slot, team: byeTeam });
        }
      }
    }
  }

  entries.sort((a, b) => a.slot - b.slot);
  roundEntries[round] = entries;
});

const completedCount = tMatches.filter(m => m.data.status === 'completed').length;

function getTeam(teamId) {
  return teams.find(t => t.id === teamId);
}

function formatDate(d) {
  if (!d) return null;
  const date = new Date(d);
  if (isNaN(date)) return d;
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}
---

<Layout title={`CFL Esports ID - ${tournamentName}`} current="Tournaments">
  <div class="container">
    <div class="page-header">
      <h1>{tournamentName}</h1>
      <p>{completedCount} / {tMatches.length} matches played</p>
    </div>

    <div class="bracket-nav">
      <a href="/tournament" class="back-link">← All Tournaments</a>
      <select id="tourney-select">
        {tournaments.map(t => (
          <option value={t.id} selected={t.name === tournamentName}>{t.name}</option>
        ))}
      </select>
    </div>

    <div class="bracket-scroll">
      <div class="bracket-wrapper">
        <div class="bracket" id="bracket">
          {rounds.map((round, roundIdx) => {
            const entries = roundEntries[round];
            const roundMatches = byRound[round];
            const dates = [...new Set(roundMatches.map(m => m.data.date).filter(Boolean))];
            const dateStr = dates.length > 0 ? dates.map(formatDate).join(' & ') : '';
            return (
              <div class="bracket-round" data-round={round}>
                <div class="bracket-round-header">
                  <div class="bracket-round-title">{round}</div>
                  {dateStr && <div class="bracket-round-date">{dateStr}</div>}
                </div>
                <div class="bracket-round-matches">
                  {entries.map(entry => {
                    if (entry.type === 'bye') {
                      const team = getTeam(entry.team);
                      return (
                        <div class="bracket-match bye" data-slot={entry.slot} data-round={round}>
                          <div class="bracket-team-row winner">
                            <div class="bracket-team-info">
                              <span class="bracket-team-tag">{team?.data.tag || 'TBD'}</span>
                              <span class="bracket-team-name">{team?.data.name || 'TBD'}</span>
                            </div>
                            <span class="bracket-bye-label">BYE</span>
                          </div>
                          <div class="bracket-team-row empty">
                            <div class="bracket-team-info">
                              <span class="bracket-team-name" style="color: var(--text-muted); font-style: italic;">No opponent</span>
                            </div>
                          </div>
                        </div>
                      );
                    }
                    const m = entry.match;
                    const isCompleted = m.data.status === 'completed';
                    const team1 = getTeam(m.data.team1);
                    const team2 = getTeam(m.data.team2);
                    const win1 = isCompleted && m.data.winner === m.data.team1;
                    const win2 = isCompleted && m.data.winner === m.data.team2;
                    return (
                      <div class={`bracket-match ${isCompleted ? '' : 'upcoming'}`} data-slot={entry.slot} data-round={round} data-match-id={m.id}>
                        <div class={`bracket-team-row ${win1 ? 'winner' : (win2 ? 'loser' : '')}`}>
                          <div class="bracket-team-info">
                            <span class="bracket-team-tag">{team1?.data.tag || 'TBD'}</span>
                            <span class="bracket-team-name">{team1?.data.name || 'TBD'}</span>
                          </div>
                          <span class="bracket-team-score">{isCompleted ? m.data.score1 : '–'}</span>
                        </div>
                        <div class={`bracket-team-row ${win2 ? 'winner' : (win1 ? 'loser' : '')}`}>
                          <div class="bracket-team-info">
                            <span class="bracket-team-tag">{team2?.data.tag || 'TBD'}</span>
                            <span class="bracket-team-name">{team2?.data.name || 'TBD'}</span>
                          </div>
                          <span class="bracket-team-score">{isCompleted ? m.data.score2 : '–'}</span>
                        </div>
                        {isCompleted && (
                          <div class="bracket-link">
                            <a href={`/matches/${m.id}`}>Details →</a>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>

                {/* Bronze Match below Final in the last round column */}
                {roundIdx === rounds.length - 1 && specialMatches.length > 0 && (
                  <div class="bracket-bronze">
                    <div class="bracket-bronze-divider"></div>
                    <div class="bracket-round-title">Bronze Match</div>
                    {specialMatches.map(m => {
                      const isCompleted = m.data.status === 'completed';
                      const team1 = getTeam(m.data.team1);
                      const team2 = getTeam(m.data.team2);
                      const win1 = isCompleted && m.data.winner === m.data.team1;
                      const win2 = isCompleted && m.data.winner === m.data.team2;
                      return (
                        <div class={`bracket-match ${isCompleted ? '' : 'upcoming'}`} data-slot={m.data.bracketSlot || 0} data-round={m.data.round} data-match-id={m.id}>
                          <div class={`bracket-team-row ${win1 ? 'winner' : (win2 ? 'loser' : '')}`}>
                            <div class="bracket-team-info">
                              <span class="bracket-team-tag">{team1?.data.tag || 'TBD'}</span>
                              <span class="bracket-team-name">{team1?.data.name || 'TBD'}</span>
                            </div>
                            <span class="bracket-team-score">{isCompleted ? m.data.score1 : '–'}</span>
                          </div>
                          <div class={`bracket-team-row ${win2 ? 'winner' : (win1 ? 'loser' : '')}`}>
                            <div class="bracket-team-info">
                              <span class="bracket-team-tag">{team2?.data.tag || 'TBD'}</span>
                              <span class="bracket-team-name">{team2?.data.name || 'TBD'}</span>
                            </div>
                            <span class="bracket-team-score">{isCompleted ? m.data.score2 : '–'}</span>
                          </div>
                          {isCompleted && (
                            <div class="bracket-link">
                              <a href={`/matches/${m.id}`}>Details →</a>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          })}
        </div>
        <svg class="bracket-connectors" id="bracket-connectors"></svg>
      </div>
    </div>
  </div>
</Layout>

<style>
  .bracket-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .back-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent-hover); text-decoration: underline; }
  #tourney-select {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  #tourney-select:focus { outline: none; border-color: var(--accent); }

  .bracket-scroll { overflow-x: auto; padding-bottom: 1rem; }
  .bracket-wrapper {
    position: relative;
    min-width: max-content;
  }
  .bracket { display: flex; gap: 3rem; align-items: stretch; position: relative; z-index: 1; }

  .bracket-round {
    display: flex;
    flex-direction: column;
    min-width: 200px;
  }
  .bracket-round-header {
    margin-bottom: 1.5rem;
  }
  .bracket-round-title {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .bracket-round-date {
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .bracket-round-matches {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    gap: 1.5rem;
  }

  .bracket-match {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s;
  }
  .bracket-match:hover { border-color: var(--accent); }
  .bracket-match.upcoming { border-style: dashed; }
  .bracket-match.bye { border-style: dashed; border-color: var(--border-hover); opacity: 0.75; }

  .bracket-team-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
  }
  .bracket-team-row + .bracket-team-row { border-top: 1px solid var(--border); }
  .bracket-team-row.winner { background: rgba(250, 204, 21, 0.06); }
  .bracket-team-row.loser { opacity: 0.5; }
  .bracket-team-row.empty { opacity: 0.4; }
  .bracket-team-info { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .bracket-team-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--bg-card-hover);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .bracket-team-row.winner .bracket-team-tag { background: rgba(250, 204, 21, 0.2); color: #facc15; }
  .bracket-team-name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bracket-team-score { font-weight: 800; font-size: 1rem; min-width: 24px; text-align: right; }
  .bracket-team-row.winner .bracket-team-score { color: #facc15; }
  .bracket-team-row.loser .bracket-team-score { color: var(--text-muted); }
  .bracket-bye-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-card-hover);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }
  .bracket-link { text-align: center; margin-top: 0.4rem; padding-bottom: 0.3rem; }
  .bracket-link a {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .bracket-link a:hover { color: var(--accent-hover); text-decoration: underline; }

  .bracket-connectors {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .bracket-bronze {
    margin-top: 2rem;
  }
  .bracket-bronze-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 1.5rem;
  }
  .bracket-bronze .bracket-round-title {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-orange);
    margin-bottom: 1rem;
  }
  .bracket-bronze .bracket-match { margin-top: 1rem; }

  @media (max-width: 768px) {
    .bracket-round { min-width: 170px; }
    .bracket { gap: 2rem; }
  }
</style>

<script>
  function drawConnectors() {
    const svg = document.getElementById('bracket-connectors');
    if (!svg) return;
    svg.innerHTML = '';

    const wrapper = document.querySelector('.bracket-wrapper');
    const rounds = document.querySelectorAll('.bracket-round');

    if (rounds.length < 2) return;

    const wrapperRect = wrapper.getBoundingClientRect();
    svg.setAttribute('width', wrapperRect.width);
    svg.setAttribute('height', wrapperRect.height);
    svg.setAttribute('viewBox', `0 0 ${wrapperRect.width} ${wrapperRect.height}`);

    const roundData = Array.from(rounds).map(round => {
      const roundRect = round.getBoundingClientRect();
      const matches = round.querySelectorAll('.bracket-match');
      return {
        name: round.dataset.round,
        right: roundRect.right - wrapperRect.left,
        matches: Array.from(matches).map(m => {
          const r = m.getBoundingClientRect();
          return {
            el: m,
            slot: parseInt(m.dataset.slot || '0'),
            round: m.dataset.round,
            left: r.left - wrapperRect.left,
            right: r.right - wrapperRect.left,
            top: r.top - wrapperRect.top,
            bottom: r.bottom - wrapperRect.top,
            centerY: r.top - wrapperRect.top + r.height / 2,
          };
        }),
      };
    });

    const NS = 'http://www.w3.org/2000/svg';

    for (let i = 0; i < roundData.length - 1; i++) {
      const currentRound = roundData[i];
      const nextRound = roundData[i + 1];

      currentRound.matches.forEach(match => {
        const targetSlot = Math.ceil(match.slot / 2);
        const targetMatch = nextRound.matches.find(m => m.slot === targetSlot);

        if (!targetMatch) return;

        const startX = match.right;
        const startY = match.centerY;
        const endX = targetMatch.left;
        const endY = targetMatch.centerY;
        const midX = (startX + endX) / 2;

        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', `M ${startX} ${startY} L ${midX} ${startY} L ${midX} ${endY} L ${endX} ${endY}`);
        path.setAttribute('stroke', '#2a3142');
        path.setAttribute('stroke-width', '2');
        path.setAttribute('fill', 'none');
        path.setAttribute('opacity', '0.6');
        svg.appendChild(path);
      });
    }
  }

  window.addEventListener('load', drawConnectors);
  window.addEventListener('resize', drawConnectors);
  setTimeout(drawConnectors, 100);
</script>
