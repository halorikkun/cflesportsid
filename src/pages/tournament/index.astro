---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getMatchRound } from '../../utils/tournament';
import {
  getMatchTournamentId,
  getMatchWinnerId,
} from '../../utils/content';

const matches = await getCollection('matches');
const teams = await getCollection('teams');
const allTournaments = await getCollection('tournaments');

const tournamentPosters: Record<string, string> = {
  'clash-for-glory-s1': '/tournaments/clash-for-glory-s1.webp',
};

const tournaments = allTournaments.map((tournament) => {
  const tMatches = matches.filter(
    (match) => getMatchTournamentId(match) === tournament.id
  );

  const completedMatches = tMatches.filter(
    (match) => match.data.status === 'completed'
  );

  let status = 'upcoming';
  let statusLabel = 'Upcoming';

  if (
    tMatches.length > 0 &&
    completedMatches.length === tMatches.length
  ) {
    status = 'completed';
    statusLabel = 'Completed';
  } else if (completedMatches.length > 0) {
    status = 'ongoing';
    statusLabel = 'Ongoing';
  }

  const matchDates = tMatches
    .map((match) => match.data.date)
    .filter(Boolean)
    .sort();

  const startDate =
    matchDates[0] ||
    tournament.data.startDate ||
    null;

  const endDate =
    matchDates[matchDates.length - 1] ||
    tournament.data.endDate ||
    null;

  const finalMatch = tMatches.find(
    (match) =>
      getMatchRound(match, tournament)?.placement === 1 &&
      match.data.status === 'completed'
  );

  const winner = finalMatch
    ? teams.find(
        (team) =>
          team.id === getMatchWinnerId(finalMatch)
      )
    : null;

  const season =
    tournament.data.name
      .match(/\bS\d+\b/i)?.[0]
      ?.toUpperCase() ?? null;

  const month = startDate
    ? new Date(startDate).toLocaleDateString(
        'en-GB',
        {
          month: 'long',
          timeZone: 'UTC',
        }
      )
    : null;

  return {
    id: tournament.id,
    name: tournament.data.name,
    status,
    statusLabel,
    startDate,
    endDate,
    season,
    month,
    winner,
    poster: tournamentPosters[tournament.id] ?? null,
  };
});

const statusOrder = {
  ongoing: 0,
  upcoming: 1,
  completed: 2,
};

tournaments.sort((a, b) => {
  const statusDifference =
    statusOrder[a.status] - statusOrder[b.status];

  if (statusDifference !== 0) {
    return statusDifference;
  }

  const dateA = a.startDate
    ? new Date(a.startDate).getTime()
    : 0;

  const dateB = b.startDate
    ? new Date(b.startDate).getTime()
    : 0;

  if (a.status === 'upcoming') {
    return dateA - dateB;
  }

  return dateB - dateA;
});
---

<Layout
  title="CFL Esports ID Tournament Hub - Tournaments"
  current="Tournaments"
>
  <div class="container">
    <div class="page-header">
      <h1>Tournaments</h1>
      <p>Choose a tournament to view its bracket and results</p>
    </div>

    <div class="tourney-grid">
      {tournaments.map((tournament) => (
        <a
          href={`/tournament/${tournament.id}`}
          class="tourney-card"
        >
          <div class="poster-meta">
            <span class="poster-season">
              {[
                tournament.season,
                tournament.month,
              ]
                .filter(Boolean)
                .join(' · ')}
            </span>

            <span
              class:list={[
                'status-badge',
                `status-${tournament.status}`,
              ]}
            >
              {tournament.statusLabel}
            </span>
          </div>

          {tournament.poster ? (
            <img
              class="tourney-poster-image"
              src={tournament.poster}
              alt={`${tournament.name} tournament poster`}
              loading="lazy"
              width="768"
              height="1024"
            />
          ) : (
            <div class="poster-placeholder">
              <span>{tournament.name}</span>
            </div>
          )}

          <div class="tourney-content">
            <h2>{tournament.name}</h2>

            {tournament.winner && (
              <div class="tourney-champion">
                <div class="champion-name">
                  <img
                    src="/icons/gold-medal.webp"
                    alt=""
                    width="18"
                    height="18"
                  />

                  <strong>
                    {tournament.winner.data.name}
                  </strong>
                </div>
              </div>
            )}
          </div>

          <div class="tourney-cta">
            <span>View Bracket & Results</span>
            <span
              class="tourney-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .tourney-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fill, minmax(280px, 340px));
    gap: 24px;
    align-items: start;
  }

  .tourney-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    color: inherit;

    /* ONE card surface */
    background: var(--bg-secondary);

    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 10px;
    text-decoration: none;

    transition:
      border-color .18s,
      transform .18s;
  }

  .tourney-card:hover {
    border-color: rgba(255, 116, 46, .5);
    transform: translateY(-2px);
  }

  /* Season + tournament status */

  .poster-meta {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    background: transparent;
  }

  .poster-season {
    margin-right: auto;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-align: left;
  }

  .status-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 25px;
    padding: 0 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .poster-meta .status-badge {
    margin-left: auto;
  }

  .status-completed {
    color: #22c55e;
    background: rgba(34, 197, 94, .08);
    border-color: rgba(34, 197, 94, .32);
  }

  .status-ongoing {
    color: var(--accent);
    background: rgba(255, 116, 46, .08);
    border-color: rgba(255, 116, 46, .30);;
  }

  .status-upcoming {
    color: #e7bf59;
    background: rgba(231, 191, 89, .08);
    border-color: rgba(231, 191, 89, .30);
  }

  /* Poster */

  .tourney-card > .tourney-poster-image {
    display: block;
    width: 100% !important;
    max-width: none;
    height: auto;
    margin: 0 !important;
    padding: 0 !important;
    border: 0;
    border-radius: 0;
    object-fit: initial;
  }

  .tourney-poster-image {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 0;

    /* don't crop */
    object-fit: initial;
  }

  .poster-placeholder {
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 3 / 4;
    margin: 0;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: var(--bg-card);
    text-align: center;
    font-size: 14px;
    font-weight: 700;
  }

  /* Tournament info */

  .tourney-content {
    padding: 20px 20px 22px;
  }

  .tourney-content h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.02em;
    text-align: center;
    white-space: nowrap;
  }

  /* Winner */

  .tourney-champion {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .champion-name {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: #e7bf59;
  }

  .champion-name img {
    display: block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .champion-name strong {
    min-width: 0;
    overflow: hidden;
    color: inherit;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* CTA */

  .tourney-cta {
    min-height: 50px;
    margin-top: auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--accent);
    background: rgba(255, 116, 46, .025);
    border-top: 1px solid var(--border);
    font-size: 12px;
    font-weight: 800;
  }

  .tourney-arrow {
    flex-shrink: 0;
    font-size: 16px;
    transition: transform .18s;
  }

  .tourney-card:hover .tourney-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .tourney-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .poster-meta {
      min-height: 50px;
      padding: 0 16px;
    }

    .poster-season {
      font-size: 8px;
    }

    .status-badge {
      min-height: 24px;
      padding: 0 8px;
      font-size: 8px;
    }

    .tourney-content {
      padding: 18px 18px 20px;
    }

    .tourney-content h2 {
      font-size: 15px;
    }

    .tourney-champion {
      margin-top: 18px;
      padding-top: 14px;
    }

    .champion-name strong {
      font-size: 14px;
    }

    .tourney-cta {
      min-height: 50px;
      padding: 0 18px;
    }
  }
</style>