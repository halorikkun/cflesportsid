---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getMatchRound } from '../../utils/tournament';
import { getMatchTournamentId, getMatchWinnerId } from '../../utils/content';

const matches = await getCollection('matches');
const teams = await getCollection('teams');

const allTournaments = await getCollection('tournaments');

const tournaments = allTournaments.map((tournament) => {
  const tMatches = matches.filter(m => getMatchTournamentId(m) === tournament.id);
  const completed = tMatches.filter(m => m.data.status === 'completed');
  const upcoming = tMatches.filter(m => m.data.status !== 'completed');
  const rounds = [...new Set(tMatches.map(m => `${m.data.stageId}/${m.data.roundId}`).filter(Boolean))];

  let status = 'upcoming';
  let statusLabel = 'Upcoming';
  if (tMatches.length > 0 && completed.length === tMatches.length) {
    status = 'completed';
    statusLabel = 'Completed';
  } else if (completed.length > 0) {
    status = 'ongoing';
    statusLabel = 'Ongoing';
  }

  const dates = tMatches.map(m => m.data.date).filter(Boolean).sort();
  const finalMatch = tMatches.find(m => getMatchRound(m, tournament)?.placement === 1 && m.data.status === 'completed');
  const winner = finalMatch ? teams.find(t => t.id === getMatchWinnerId(finalMatch)) : null;

  return {
    name: tournament.data.name,
    id: tournament.id,
    totalMatches: tMatches.length,
    completedMatches: completed.length,
    upcomingMatches: upcoming.length,
    rounds,
    status,
    statusLabel,
    startDate: dates[0] || null,
    endDate: dates[dates.length - 1] || null,
    winner,
  };
});

const statusOrder = { ongoing: 0, upcoming: 1, completed: 2 };
tournaments.sort((a, b) => statusOrder[a.status] - statusOrder[b.status]);

function formatDate(d) {
  if (!d) return null;
  const date = new Date(d);
  if (isNaN(date)) return d;
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Layout title="CFL Esports ID Tournament Hub - Tournaments" current="Tournaments">
  <div class="container">
    <div class="page-header">
      <h1>Tournaments</h1>
      <p>Choose a tournament to view its bracket and results</p>
    </div>

    <div class="tourney-grid">
      {tournaments.map(t => (
        <a href={`/tournament/${t.id}`} class="tourney-card">
          <div class="tourney-header">
            <div class="tourney-icon"><img src="/icons/trophy.png" alt="" /></div>
            <h3>{t.name}</h3>
          </div>
          
          {t.startDate && (
            <div class="tourney-date">
              {t.endDate && t.endDate !== t.startDate
                ? `${formatDate(t.startDate)} – ${formatDate(t.endDate)}`
                : formatDate(t.startDate)}
            </div>
          )}
          
          <div class="tourney-meta">
            <span class={`badge badge-${t.status}`}>{t.statusLabel}</span>
            <span class="badge badge-secondary">{t.rounds.length} Rounds</span>
            <span class="badge badge-secondary">{t.completedMatches}/{t.totalMatches} Matches</span>
          </div>
          
          {t.winner && (
            <div class="tourney-winner">
              <span class="winner-icon"><img src="/icons/gold-medal.png" alt="" /></span> 
              <span>Champion: <strong>{t.winner.data.name}</strong></span>
            </div>
          )}
          
          <div class="tourney-cta">View Bracket & Results →</div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .tourney-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .tourney-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%; /* Ensures equal height in grid */
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .tourney-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(255, 77, 46, 0.12);
  }

  .tourney-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .tourney-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tourney-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .winner-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .winner-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .tourney-card h3 { 
    font-size: 1.15rem; 
    font-weight: 800; 
    line-height: 1.3;
    margin: 0;
  }

  .tourney-date { 
    color: var(--text-secondary); 
    font-size: 0.85rem; 
    font-weight: 500;
  }

  .tourney-meta { 
    display: flex; 
    gap: 0.5rem; 
    flex-wrap: wrap; 
    margin-top: 0.25rem; 
  }

  /* Reusing global badge styles, adding specific variants */
  .badge-ongoing { background: rgba(245, 158, 11, 0.15); color: var(--live); }
  .badge-upcoming { background: var(--accent-dim); color: var(--accent); }
  .badge-completed { background: rgba(34, 197, 94, 0.15); color: var(--win); }
  .badge-secondary { background: var(--bg-card-hover); color: var(--text-secondary); }

  .tourney-winner { 
    font-size: 0.85rem; 
    color: var(--text-secondary); 
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .tourney-winner strong { color: var(--accent-orange); }

  .tourney-cta { 
    margin-top: auto; /* Pushes CTA to the bottom of the card */
    color: var(--accent); 
    font-weight: 700; 
    font-size: 0.9rem;
    padding-top: 0.5rem;
    transition: color 0.2s;
  }
  .tourney-card:hover .tourney-cta {
    color: var(--accent-hover);
  }

  @media (max-width: 640px) {
    .tourney-grid { grid-template-columns: 1fr; }
  }
</style>