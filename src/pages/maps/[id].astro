---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyMapStats, kdRatio } from '../../utils/statistics';
import { getRoundName } from '../../utils/tournament';
export async function getStaticPaths() {
  return (await getCollection('maps')).map(map => ({ params: { id: map.id }, props: { map } }));
}
const { map } = Astro.props;
const matches = await getCollection('matches');
const calculated = calculateStatistics(matches);
const stats = calculated.maps.get(map.id) ?? emptyMapStats();
const players = new Map((await getCollection('players')).map(p => [p.data.uid || p.id, p]));
const teams = new Map((await getCollection('teams')).map(t => [t.id, t]));
const tournaments = new Map((await getCollection('tournaments')).map(t => [t.id, t]));
const topPlayers = [...stats.players].sort((a, b) => b[1].kills - a[1].kills || a[0].localeCompare(b[0]));
const teamStats = [...stats.teams].sort((a, b) => b[1].kills - a[1].kills || a[0].localeCompare(b[0]));
const frequentTeams = [...teamStats].sort((a,b)=>b[1].mapsPlayed-a[1].mapsPlayed);
const mostPlayed = frequentTeams[0]?.[1].mapsPlayed;
const favoriteTeams = frequentTeams.filter(([,s])=>s.mapsPlayed===mostPlayed);
const mostKills = topPlayers[0]?.[1].kills;
const leadingPlayers = topPlayers.filter(([,s])=>s.kills===mostKills);
const bestAssists = Math.max(0, ...topPlayers.map(([,s])=>s.assists));
const assistLeaders = topPlayers.filter(([,s])=>s.assists === bestAssists);
const mapKda = s => (s.kills + s.assists) / Math.max(s.deaths, 1);
const bestKda = Math.max(0, ...topPlayers.map(([,s])=>mapKda(s)));
const kdaLeaders = topPlayers.filter(([,s])=>mapKda(s) === bestKda);
const mapMatches = matches.filter(m => m.data.status === 'completed' && m.data.roundDetails.some(rd => rd.mapId === map.id))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id));
---
<Layout title={`${map.data.name} Statistics - CFL Esports ID`} current="Maps">
  <div class="container">
    <div class="page-header"><h1>{map.data.name}</h1><p>Map statistics from completed matches</p></div>
    <div class="stat-grid map-leaders section">
      <article class="stat-box"><h2>Most played by</h2>{favoriteTeams.map(([id,s])=><p><a href={`/teams/${id}`}>{teams.get(id)?.data.name ?? id}</a> · {s.mapsPlayed} matches</p>)}{!favoriteTeams.length && <p>No matches yet</p>}</article>
      <article class="stat-box"><h2>Top Fragger</h2>{leadingPlayers.map(([uid,s])=><p><a href={`/players/${players.get(uid)?.id ?? uid}`}>{players.get(uid)?.data.ign ?? uid}</a> · {s.kills} kills</p>)}{!leadingPlayers.length && <p>No recorded stats</p>}</article>
      <article class="stat-box"><h2>Top Assists</h2>{assistLeaders.map(([uid,s])=><p><a href={`/players/${players.get(uid)?.id ?? uid}`}>{players.get(uid)?.data.ign ?? uid}</a> · {s.assists} assists</p>)}{!assistLeaders.length && <p>No recorded stats</p>}</article>
      <article class="stat-box"><h2>Best KDA</h2>{kdaLeaders.map(([uid,s])=><p><a href={`/players/${players.get(uid)?.id ?? uid}`}>{players.get(uid)?.data.ign ?? uid}</a> · {mapKda(s).toFixed(2)}</p>)}{!kdaLeaders.length && <p>No recorded stats</p>}</article>
    </div>
    <div class="stat-grid map-totals section">{[['Matches',stats.matchesPlayed],['Total Kills',stats.kills],['Total Deaths',stats.deaths],['Total Assists',stats.assists]].map(([label,value])=><article class="stat-box"><div class="stat-value">{value}</div><div class="stat-label">{label}</div></article>)}</div>
    <p class="coverage">KDA = (kills + assists) / max(deaths, 1). K/D/A totals include only entries assigned to this map. A dash in match stats means the map number is unknown or the player did not play that map. {stats.knownResults} of {stats.mapsPlayed} map winners are known. Win rates use known results only: explicit map winners or a 3–0 sweep. Split scores alone do not identify map winners.</p>
    {stats.mapsPlayed === 0 ? <p class="section">No completed matches recorded on this map yet.</p> : (
      <>
        <div class="map-tabs" role="tablist" aria-label="Map statistics">
          <button id="tab-players" role="tab" aria-selected="true" aria-controls="panel-players" tabindex="0">Player Statistics</button>
          <button id="tab-teams" role="tab" aria-selected="false" aria-controls="panel-teams" tabindex="-1">Team Statistics</button>
          <button id="tab-matches" role="tab" aria-selected="false" aria-controls="panel-matches" tabindex="-1">Match History</button>
        </div>
        <section id="panel-players" role="tabpanel" aria-labelledby="tab-players" class="section"><h2>Player Statistics</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Statistics table"><table class="sortable-map-table">
            <thead><tr><th>Player</th><th>Recorded Maps</th><th>Kills</th><th>Deaths</th><th>Assists</th><th>K/D</th><th>MVP Awards</th></tr></thead>
            <tbody>{topPlayers.map(([uid, s]) => {
              const player = players.get(uid);
              return <tr><td>{player ? <a href={`/players/${player.id}`}>{player.data.ign}</a> : uid}</td><td>{s.mapsPlayed}</td><td>{s.mapsPlayed ? s.kills : '—'}</td><td>{s.mapsPlayed ? s.deaths : '—'}</td><td>{s.mapsPlayed ? s.assists : '—'}</td><td>{s.mapsPlayed ? kdRatio(s).toFixed(2) : '—'}</td><td>{s.mvpCount}</td></tr>;
            })}</tbody>
          </table></div>
        </section>
        <section id="panel-teams" role="tabpanel" aria-labelledby="tab-teams" class="section" hidden><h2>Team Statistics</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Statistics table"><table class="sortable-map-table">
            <thead><tr><th>Team</th><th>Matches</th><th>Recorded Kills</th><th>Recorded Deaths</th><th>Recorded Assists</th><th>Known Wins</th><th>Known Losses</th><th>Win Rate (Known Results)</th></tr></thead>
            <tbody>{teamStats.map(([id, s]) => <tr><td><a href={`/teams/${id}`}>{teams.get(id)?.data.name ?? id}</a></td><td>{s.mapsPlayed}</td><td>{s.kills}</td><td>{s.deaths}</td><td>{s.assists}</td><td>{s.wins}</td><td>{s.losses}</td><td>{s.wins + s.losses > 0 ? `${(100 * s.wins / (s.wins + s.losses)).toFixed(1)}%` : '—'}</td></tr>)}</tbody>
          </table></div>
        </section>
        <section id="panel-matches" role="tabpanel" aria-labelledby="tab-matches" class="section" hidden><h2>Match History</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Statistics table"><table class="sortable-map-table">
            <thead><tr><th>Date</th><th>Tournament</th><th>Round</th><th>Match</th><th>Map Number</th></tr></thead>
            <tbody>{mapMatches.map(m => <tr>
              <td>{m.data.date}</td><td><a href={`/tournament/${m.data.tournamentId}`}>{tournaments.get(m.data.tournamentId)?.data.name ?? m.data.tournamentId}</a></td>
              <td>{getRoundName(m, tournaments)}</td>
              <td><a href={`/matches/${m.id}`}>{teams.get(m.data.team1Id ?? '')?.data.name ?? 'TBD'} vs {teams.get(m.data.team2Id ?? '')?.data.name ?? 'TBD'}</a></td>
              <td>{m.data.roundDetails.filter(rd => rd.mapId === map.id).map(rd => rd.round_number).join(', ')}</td>
            </tr>)}</tbody>
          </table></div>
        </section>
      </>
    )}
  </div>
</Layout>
<style>.section { margin-top: 1.5rem; margin-bottom: 2rem; } h2 { margin-bottom: 1rem; } .coverage { color: var(--text-secondary); line-height: 1.6; }</style>

<script>
 document.querySelectorAll<HTMLTableElement>('.sortable-map-table').forEach(table=>{
   const headings=Array.from(table.querySelectorAll('thead th'));
   headings.forEach((heading,index)=>{
     const label=heading.textContent || '';
     const button=document.createElement('button');button.type='button';button.textContent=label+' ↕';
     heading.textContent='';heading.append(button);heading.setAttribute('aria-sort','none');
     button.addEventListener('click',()=>{
       const ascending=heading.getAttribute('aria-sort')!=='ascending';
       headings.forEach(h=>h.setAttribute('aria-sort','none'));heading.setAttribute('aria-sort',ascending?'ascending':'descending');
       const body=table.tBodies[0];const rows=Array.from(body.rows);
       const value=(row:HTMLTableRowElement)=>row.cells[index].textContent?.trim() || '';
       const numeric=rows.every(row=>value(row)==='—'||/^[-+]?\d+(?:\.\d+)?%?$/.test(value(row)));
       rows.sort((a,b)=>{const x=value(a),y=value(b);if(x==='—')return y==='—'?0:1;if(y==='—')return -1;const difference=numeric?parseFloat(x)-parseFloat(y):x.localeCompare(y,undefined,{numeric:true});return ascending?difference:-difference;});
       rows.forEach(row=>body.append(row));
     });
   });
 });
</script>
<style is:global>
.sortable-map-table th button{background:none;border:0;color:inherit;font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;padding:4px 0;text-align:left}.sortable-map-table th button:hover{color:var(--accent)}
</style>
<style>.stat-box h2{font-size:17px}.stat-box p{font-size:14px;margin:8px 0}</style>

<style is:global>
.interior-page .map-leaders,.interior-page .map-totals{grid-template-columns:repeat(4,minmax(0,1fr))}
@media(max-width:900px){.interior-page .map-leaders,.interior-page .map-totals{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:420px){.interior-page .map-leaders{grid-template-columns:minmax(0,1fr)}}
</style>

<script>
const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.map-tabs [role="tab"]'));
function activateTab(tab: HTMLButtonElement, focus = false) {
  tabs.forEach(item => {
    const active = item === tab;
    item.setAttribute('aria-selected', String(active));
    item.tabIndex = active ? 0 : -1;
    document.getElementById(item.getAttribute('aria-controls')!)!.hidden = !active;
  });
  if (focus) tab.focus();
}
tabs.forEach((tab,index) => {
  tab.addEventListener('click',()=>activateTab(tab));
  tab.addEventListener('keydown',event=>{
    let next=index;
    if(event.key==='ArrowRight') next=(index+1)%tabs.length;
    else if(event.key==='ArrowLeft') next=(index+tabs.length-1)%tabs.length;
    else if(event.key==='Home') next=0;
    else if(event.key==='End') next=tabs.length-1;
    else return;
    event.preventDefault(); activateTab(tabs[next],true);
  });
});
</script>
<style>
.map-tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--border);padding-bottom:12px;margin-top:28px}
.map-tabs button{background:var(--bg-secondary);color:var(--text-secondary);border:1px solid var(--border);border-radius:6px;padding:12px 16px;font:inherit;font-size:14px;cursor:pointer}
.map-tabs button:hover{border-color:var(--accent);color:var(--accent)}
.map-tabs button[aria-selected="true"]{background:var(--accent);color:#171719;border-color:var(--accent);font-weight:600}
[role="tabpanel"][hidden]{display:none}
</style>
