</style>

<style>
@media(max-width:640px){.standings-table{min-width:0}.standings-table th:nth-child(3),.standings-table th:nth-child(4),.standings-table td:nth-child(3),.standings-table td:nth-child(4){display:none}.team-identity .mobile-points{display:block!important;color:var(--text-muted)}.standings-table td,.standings-table th{padding-left:8px;padding-right:8px}.standings-table td:first-child{width:35px}}
</style>

<style>
.season-schedule > div { grid-template-columns: minmax(0, 1fr); }
.season-schedule > div > span { white-space: nowrap; overflow-wrap: normal; min-width: 0; }
</style>

<style>
.season-panel .competition-title .competition-number { color: #ff742e; }
.season-panel .competition-title .competition-word { color: #ffffff; }
.season-panel .competition-title br { display: initial; }
</style>

<style>
.dashboard a { transition: color .18s, background-color .18s, box-shadow .18s; }
.dashboard a:hover { color:var(--accent); text-decoration:none; }
.dashboard :is(.player-row,.podium-row,.fixture,.outline-link,.veto-cta):hover { background:var(--bg-card-hover); box-shadow:inset 3px 0 var(--accent); }
.dashboard .standings-table .top-four td { background:#463023; }
.dashboard .standings-table .top-ten td { background:#303039; }
.dashboard .standings-table .top-four td:first-child { border-left:3px solid var(--accent); }
.dashboard .standings-table .top-ten td:first-child { border-left:3px solid #9696a8; }
.dashboard .standings-table tr:hover td { background:#45454a; }
</style>

<style>
.dashboard .medal-1 { --medal-color:#e7bf59; --medal-bg:#443820; }
.dashboard .medal-2 { --medal-color:#c6cbd4; --medal-bg:#383c44; }
.dashboard .medal-3 { --medal-color:#d79b70; --medal-bg:#453126; }
.dashboard :is(.player-row,.podium-row)[class*="medal-"] { background:var(--medal-bg); border-left:3px solid var(--medal-color); border-radius:6px; padding-left:10px; padding-right:10px; margin:5px 0; }
.dashboard :is(.player-row,.podium-row)[class*="medal-"]:hover { background:var(--medal-bg); box-shadow:inset 0 0 0 1px var(--medal-color); }
.dashboard .player-row[class*="medal-"] > strong,.dashboard .player-row[class*="medal-"] .player-rank { color:var(--medal-color); }
</style>

<style>
.dashboard .leaderboard .player-row:not([class*="medal-"]) { border-left:3px solid transparent; padding-left:10px; padding-right:10px; margin:5px 0; border-radius:6px; }
</style>

<style is:global>
.dashboard .leaderboard a.player-row {
  box-sizing: border-box;
  border-left: 3px solid transparent;
  padding: 13px 10px;
  margin: 5px 0;
  border-radius: 6px;
}
.dashboard .leaderboard a.player-row[class*="medal-"] { border-left-color: var(--medal-color); }
.dashboard .leaderboard a.player-row:hover { box-shadow: none; }
.dashboard .leaderboard a.player-row:not(.medal-1):not(.medal-2):not(.medal-3):hover { background:var(--bg-card-hover); border-left-color:transparent; }
</style>
