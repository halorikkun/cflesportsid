---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
  getMatchTournamentId,
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchWinnerId,
} from '../utils/content';

const teams = await getCollection('teams');
const players = await getCollection('players');
const matches = await getCollection('matches');
const allTournaments = await getCollection('tournaments');

const totalTeams = teams.length;
const totalPlayers = players.length;
const totalMatches = matches.length;
const completedMatches = matches.filter(m => m.data.status === 'completed');
const upcomingMatches = matches.filter(m => m.data.status !== 'completed');
const totalKills = players.reduce((sum, p) => sum + p.data.stats.kills, 0);

// Resolve each tournament and its matches by canonical ID.
const tournaments = allTournaments.map(tournament => {
  const tMatches = matches.filter(m => getMatchTournamentId(m) === tournament.id);
  const finalMatch = tMatches.find(m => m.data.round === 'Final' && m.data.status === 'completed');
  const bronzeMatch = tMatches.find(m => m.data.round === 'Bronze Match' && m.data.status === 'completed');

  let winnerTeams = [];

  if (finalMatch) {
    const winner = teams.find(t => t.id === getMatchWinnerId(finalMatch));
    const finalWinnerId = getMatchWinnerId(finalMatch);
    const finalTeam1Id = getMatchTeam1Id(finalMatch);
    const finalTeam2Id = getMatchTeam2Id(finalMatch);
    const runnerUpId = finalWinnerId && finalWinnerId === finalTeam1Id
      ? finalTeam2Id
      : finalWinnerId && finalWinnerId === finalTeam2Id ? finalTeam1Id : null;
    const runnerUp = teams.find(t => t.id === runnerUpId);
    const thirdPlace = bronzeMatch ? teams.find(t => t.id === getMatchWinnerId(bronzeMatch)) : null;

    if (winner) winnerTeams.push({ team: winner, place: 1 });
    if (runnerUp) winnerTeams.push({ team: runnerUp, place: 2 });
    if (thirdPlace) winnerTeams.push({ team: thirdPlace, place: 3 });
  }

  return { id: tournament.id, name: tournament.data.name, winnerTeams };
});

// Calculate placement points from Final and Bronze Match
function getPlacementPoints(teamId) {
  const finalMatch = matches.find(m => m.data.round === 'Final' && m.data.status === 'completed');
  const bronzeMatch = matches.find(m => m.data.round === 'Bronze Match' && m.data.status === 'completed');
  if (finalMatch) {
    if (getMatchWinnerId(finalMatch) === teamId) return 10;
    if (getMatchTeam1Id(finalMatch) === teamId || getMatchTeam2Id(finalMatch) === teamId) return 6;
  }
  if (bronzeMatch) {
    if (getMatchWinnerId(bronzeMatch) === teamId) return 4;
    if (getMatchTeam1Id(bronzeMatch) === teamId || getMatchTeam2Id(bronzeMatch) === teamId) return 2;
  }
  return 0;
}

function getTeamKillPoints(teamId) {
  return players.filter(p => p.data.team === teamId).reduce((sum, p) => sum + p.data.stats.kills, 0);
}

function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (getMatchTeam1Id(m) === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (getMatchTeam2Id(m) === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

// Set of team IDs that won a tournament (1st place in any tournament's Final)
const tournamentWinnerIds = new Set(
  tournaments
    .flatMap(t => t.winnerTeams)
    .filter(wt => wt.place === 1)
    .map(wt => wt.team.id)
);

const standings = teams.map(team => {
  const killPoints = getTeamKillPoints(team.id);
  const placementPoints = getPlacementPoints(team.id);
  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    isTournamentWinner: tournamentWinnerIds.has(team.id),
    killPoints,
    placementPoints,
    totalScore: killPoints + placementPoints,
  };
}).sort((a, b) => b.totalScore - a.totalScore);

const topFraggers = [...players].sort((a, b) => b.data.stats.kills - a.data.stats.kills).slice(0, 5);
const topAssistsPlayers = [...players].sort((a, b) => b.data.stats.assists - a.data.stats.assists).slice(0, 5);

// Calculate MVP counts from roundDetails across all completed matches
const mvpCounts = new Map();
completedMatches.forEach(m => {
  (m.data.roundDetails || []).forEach(rd => {
    if (rd.mvp) {
      mvpCounts.set(rd.mvp, (mvpCounts.get(rd.mvp) || 0) + 1);
    }
  });
});
const totalMVPs = [...mvpCounts.values()].reduce((s, v) => s + v, 0);
const topMVPPlayers = players
  .map(p => ({ player: p, mvpCount: mvpCounts.get(p.data.uid) || 0 }))
  .filter(p => p.mvpCount > 0)
  .sort((a, b) => b.mvpCount - a.mvpCount)
  .slice(0, 5);
---

<Layout title="CFL Esports ID Tournament Hub - Home" current="Home">
  <div class="container">
    <div class="page-header">
      <h1>Overall Leaderboard</h1>
      <p>Team standings ranked by total score (kill points + placement points)</p>
    </div>

    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-box stat-teams">
        <div class="stat-value">{totalTeams}</div>
        <div class="stat-label">Total Teams</div>
      </div>
      <div class="stat-box stat-players">
        <div class="stat-value">{totalPlayers}</div>
        <div class="stat-label">Total Players</div>
      </div>
      <div class="stat-box stat-fixtures">
        <div class="stat-value">{totalMatches}</div>
        <div class="stat-label">Fixtures Played</div>
      </div>
      <div class="stat-box stat-upcoming">
        <div class="stat-value">{upcomingMatches.length}</div>
        <div class="stat-label">Upcoming</div>
      </div>
      <div class="stat-box stat-kills">
        <div class="stat-value">{totalKills}</div>
        <div class="stat-label">Total Kills</div>
      </div>
      <div class="stat-box stat-mvp">
        <div class="stat-value">{totalMVPs}</div>
        <div class="stat-label">MVP Awards</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem;">Team Standings</h2>
    <div class="table-wrap" style="margin-bottom: 2rem;">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Team</th>
            <th>Kill Points</th>
            <th>Placement Points</th>
            <th>Total Score</th>
          </tr>
        </thead>
        <tbody>
          {standings.map((team, index) => (
            <tr class={index === 0 ? 'rank-gold' : index === 1 ? 'rank-silver' : index === 2 ? 'rank-bronze' : ''}>
              <td><span class={`rank ${index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : 'rank-n'}`}>{index + 1}</span></td>
              <td><a href={`/teams/${team.id}`}><strong>{team.isTournamentWinner && '👑 '}{team.name}</strong></a></td>
              <td class="kda"><span class="kill">{team.killPoints}</span></td>
              <td>{team.placementPoints > 0 ? <span style="color: #f59e0b; font-weight: 700;">{team.placementPoints}</span> : '0'}</td>
              <td style="font-weight: 700; color: var(--text-primary);">{team.totalScore}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="grid grid-3" style="text-align: center;">
      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--text-primary);">Top Fraggers</h3>
        <div class="top-list">
          {topFraggers.map((p, i) => (
          <div class="top-list-item">
            <span class={`rank ${i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-n'}`}>{i + 1}</span>
              <div class="top-info">
                <a href={`/players/${p.id}`}><strong>{p.data.ign}</strong></a>
                <div style="color: var(--text-secondary); font-size: 0.85rem;">
                  <span class="kda"><span class="kill">{p.data.stats.kills}</span></span> kills
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--text-primary);">Top Assists</h3>
        <div class="top-list">
          {topAssistsPlayers.map((p, i) => (
          <div class="top-list-item">
            <span class={`rank ${i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-n'}`}>{i + 1}</span>
              <div class="top-info">
                <a href={`/players/${p.id}`}><strong>{p.data.ign}</strong></a>
                <div style="color: var(--text-secondary); font-size: 0.85rem;">
                  {p.data.stats.assists} assists
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--text-primary);">Top MVP</h3>
        {topMVPPlayers.length > 0 ? (
          <div class="top-list">
            {topMVPPlayers.map((p, i) => (
              <div class="top-list-item">
                <span class={`rank ${i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-n'}`}>{i + 1}</span>
                <div class="top-info">
                  <a href={`/players/${p.player.id}`}><strong>{p.player.data.ign}</strong></a>
                  <div style="color: var(--text-secondary); font-size: 0.85rem;">
                    {p.mvpCount} {p.mvpCount === 1 ? 'MVP' : 'MVPs'}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div style="color: var(--text-muted); text-align: center; padding: 1rem;">No MVPs yet</div>
        )}
      </div>
    </div>

    <div class="card" style="margin-top: 2rem;">
      <h3 style="margin-bottom: 1rem; color: var(--text-primary);">Tournament Winner</h3>
      {tournaments.length > 0 && tournaments.some(t => t.winnerTeams.length > 0) ? (
        <div class="carousel" id="tournament-carousel">
          <div class="carousel-track" id="carousel-track">
            {tournaments.filter(t => t.winnerTeams.length > 0).map((t) => (
              <div class="carousel-slide">
                <div class="tournament-name">
                  <div class="tournament-label">Tournament</div>
                  <div class="tournament-title">{t.name}</div>
                </div>
                {t.winnerTeams.map((wt) => (
                  <div class={`top-list-item ${wt.place === 1 ? 'rank-gold' : wt.place === 2 ? 'rank-silver' : 'rank-bronze'}`}>
                    <span class="top-rank">{wt.place === 1 ? '👑' : wt.place === 2 ? '🥈' : '🥉'}</span>
                    <div class="top-info">
                      <a href={`/teams/${wt.team.id}`}><strong>{wt.team.data.name}</strong></a>
                      <div style="color: var(--text-secondary); font-size: 0.85rem;">
                        {wt.place === 1 ? 'Champion' : wt.place === 2 ? 'Runner-up' : 'Third Place'}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>
          <button class="carousel-btn carousel-prev" id="carousel-prev" aria-label="Previous tournament">‹</button>
          <button class="carousel-btn carousel-next" id="carousel-next" aria-label="Next tournament">›</button>
          <div class="carousel-dots" id="carousel-dots"></div>
        </div>
      ) : (
        <div style="color: var(--text-muted); text-align: center; padding: 1rem;">Tournament in progress</div>
      )}
    </div>
  </div>
</Layout>

<style>
  /* Stat grid colors */
  .stat-teams { background: rgba(59, 130, 246, 0.12); border-color: rgba(59, 130, 246, 0.3); }
  .stat-teams .stat-value { color: #60a5fa; }
  .stat-players { background: rgba(34, 197, 94, 0.12); border-color: rgba(34, 197, 94, 0.3); }
  .stat-players .stat-value { color: #4ade80; }
  .stat-fixtures { background: rgba(168, 85, 247, 0.12); border-color: rgba(168, 85, 247, 0.3); }
  .stat-fixtures .stat-value { color: #c084fc; }
  .stat-upcoming { background: rgba(245, 158, 11, 0.12); border-color: rgba(245, 158, 11, 0.3); }
  .stat-upcoming .stat-value { color: #fbbf24; }
  .stat-kills { background: rgba(255, 77, 46, 0.12); border-color: rgba(255, 77, 46, 0.3); }
  .stat-kills .stat-value { color: var(--accent); }
  .stat-mvp { background: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.3); }
  .stat-mvp .stat-value { color: #facc15; }

  /* Top list */
  .top-list-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .top-list-item:last-child { border-bottom: none; }
  .top-rank {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 1.5rem;
    text-align: center;
  }
  .top-info { flex: 1; }

  /* Tournament carousel */
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    padding: 0 0.25rem;
  }
  .tournament-name {
    text-align: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .tournament-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .tournament-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Arrow buttons */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--bg-card-hover);
    border: 1px solid var(--border);
    color: var(--text-primary);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.2s, border-color 0.2s;
  }
  .carousel-btn:hover {
    background: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent);
  }
  .carousel-prev { left: 4px; }
  .carousel-next { right: 4px; }

  /* Dot indicators */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .carousel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-hover);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .carousel-dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('tournament-carousel');
    if (!carousel) return;

    const track = document.getElementById('carousel-track');
    const slides = track.querySelectorAll('.carousel-slide');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const dotsContainer = document.getElementById('carousel-dots');

    const totalSlides = slides.length;
    let current = 0;

    // Only show controls if more than 1 tournament
    if (totalSlides <= 1) {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
      dotsContainer.style.display = 'none';
      return;
    }

    // Create dots
    for (let i = 0; i < totalSlides; i++) {
      const dot = document.createElement('span');
      dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }

    const dots = dotsContainer.querySelectorAll('.carousel-dot');

    function goTo(index) {
      current = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // Touch / swipe support
    let startX = 0;
    let currentX = 0;
    let isSwiping = false;

    carousel.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      currentX = startX;
      isSwiping = true;
      track.style.transition = 'none';
    }, { passive: true });

    carousel.addEventListener('touchmove', (e) => {
      if (!isSwiping) return;
      currentX = e.touches[0].clientX;
      const diff = currentX - startX;
      const offset = -current * 100 + (diff / carousel.offsetWidth) * 100;
      track.style.transform = `translateX(${offset}%)`;
    }, { passive: true });

    carousel.addEventListener('touchend', () => {
      if (!isSwiping) return;
      isSwiping = false;
      track.style.transition = 'transform 0.35s ease';
      const diff = currentX - startX;
      const threshold = carousel.offsetWidth * 0.2;
      if (diff > threshold) {
        goTo(current - 1);
      } else if (diff < -threshold) {
        goTo(current + 1);
      } else {
        goTo(current);
      }
    });

    // Mouse drag support (desktop)
    let mouseStartX = 0;
    let mouseCurrentX = 0;
    let isMouseDragging = false;

    carousel.addEventListener('mousedown', (e) => {
      mouseStartX = e.clientX;
      mouseCurrentX = mouseStartX;
      isMouseDragging = true;
      track.style.transition = 'none';
      e.preventDefault();
    });

    carousel.addEventListener('mousemove', (e) => {
      if (!isMouseDragging) return;
      mouseCurrentX = e.clientX;
      const diff = mouseCurrentX - mouseStartX;
      const offset = -current * 100 + (diff / carousel.offsetWidth) * 100;
      track.style.transform = `translateX(${offset}%)`;
    });

    carousel.addEventListener('mouseup', () => {
      if (!isMouseDragging) return;
      isMouseDragging = false;
      track.style.transition = 'transform 0.35s ease';
      const diff = mouseCurrentX - mouseStartX;
      const threshold = carousel.offsetWidth * 0.2;
      if (diff > threshold) {
        goTo(current - 1);
      } else if (diff < -threshold) {
        goTo(current + 1);
      } else {
        goTo(current);
      }
    });

    carousel.addEventListener('mouseleave', () => {
      if (!isMouseDragging) return;
      isMouseDragging = false;
      track.style.transition = 'transform 0.35s ease';
      goTo(current);
    });
  });
</script>
