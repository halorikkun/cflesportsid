---
import Thumbnail from '../components/Thumbnail.astro';
import { getOverallStandings } from '../utils/standings';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats } from '../utils/statistics';
import { getMatchRound } from '../utils/tournament';
import {
  getMatchTournamentId,
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchWinnerId,
} from '../utils/content';

const teams = await getCollection('teams');
const allPlayers = await getCollection('players');
const matches = await getCollection('matches');
const allTournaments = await getCollection('tournaments');
const calculated = calculateStatistics(matches);
const players = allPlayers.map(player => ({ ...player, data: { ...player.data, stats: calculated.players.get(player.data.uid || player.id) ?? emptyStats() } }));

const totalTeams = teams.length;
const totalPlayers = players.length;
const totalMatches = matches.length;
const completedMatches = matches.filter(m => m.data.status === 'completed');
const upcomingMatches = matches.filter(m => m.data.status === 'upcoming').sort((a,b) => a.data.date.localeCompare(b.data.date));
const totalKills = calculated.totals.kills;

// Resolve each tournament and its matches by canonical ID.
const tournaments = allTournaments.map(tournament => {
  const tMatches = matches.filter(m => getMatchTournamentId(m) === tournament.id);
  const finalMatch = tMatches.find(m => getMatchRound(m, tournament)?.placement === 1 && m.data.status === 'completed');
  const bronzeMatch = tMatches.find(m => getMatchRound(m, tournament)?.placement === 3 && m.data.status === 'completed');

  let winnerTeams = [];

  if (finalMatch) {
    const winner = teams.find(t => t.id === getMatchWinnerId(finalMatch));
    const finalWinnerId = getMatchWinnerId(finalMatch);
    const finalTeam1Id = getMatchTeam1Id(finalMatch);
    const finalTeam2Id = getMatchTeam2Id(finalMatch);
    const runnerUpId = finalWinnerId && finalWinnerId === finalTeam1Id
      ? finalTeam2Id
      : finalWinnerId && finalWinnerId === finalTeam2Id ? finalTeam1Id : null;
    const runnerUp = teams.find(t => t.id === runnerUpId);
    const thirdPlace = bronzeMatch ? teams.find(t => t.id === getMatchWinnerId(bronzeMatch)) : null;

    if (winner) winnerTeams.push({ team: winner, place: 1 });
    if (runnerUp) winnerTeams.push({ team: runnerUp, place: 2 });
    if (thirdPlace) winnerTeams.push({ team: thirdPlace, place: 3 });
  }

  return { id: tournament.id, name: tournament.data.name, winnerTeams, finalMatch, bronzeMatch };
});

// Calculate placement points from Final and Bronze Match
function getPlacementPoints(teamId) {
  return tournaments.reduce((total, { finalMatch, bronzeMatch }) => {
    if (finalMatch) {
      if (getMatchWinnerId(finalMatch) === teamId) return total + 10;
      if (getMatchTeam1Id(finalMatch) === teamId || getMatchTeam2Id(finalMatch) === teamId) return total + 6;
    }
    if (bronzeMatch) {
      if (getMatchWinnerId(bronzeMatch) === teamId) return total + 4;
      if (getMatchTeam1Id(bronzeMatch) === teamId || getMatchTeam2Id(bronzeMatch) === teamId) return total + 2;
    }
    return total;
  }, 0);
}

function getTeamKillPoints(teamId) {
  return calculated.teams.get(teamId)?.kills ?? 0;
}

function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (getMatchTeam1Id(m) === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (getMatchTeam2Id(m) === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

// Set of team IDs that won a tournament (1st place in any tournament's Final)
const tournamentWinnerIds = new Set(
  tournaments
    .flatMap(t => t.winnerTeams)
    .filter(wt => wt.place === 1)
    .map(wt => wt.team.id)
);

const standings = getOverallStandings(teams, matches, allTournaments);

const topFraggers = [...players].sort((a, b) => b.data.stats.kills - a.data.stats.kills).slice(0, 5);
const topAssistsPlayers = [...players].sort((a, b) => b.data.stats.assists - a.data.stats.assists).slice(0, 5);

const totalMVPs = calculated.totals.mvpCount;
const topMVPPlayers = players
  .map(p => ({ player: p, mvpCount: p.data.stats.mvpCount }))
  .filter(p => p.mvpCount > 0)
  .sort((a, b) => b.mvpCount - a.mvpCount)
  .slice(0, 5);
const leaderboards = [
  { title: 'Top fraggers', label: 'Kills', entries: topFraggers.map(p => ({ player: p, value: p.data.stats.kills })) },
  { title: 'Top assists', label: 'Assists', entries: topAssistsPlayers.map(p => ({ player: p, value: p.data.stats.assists })) },
  { title: 'Top MVPs', label: 'Awards', entries: topMVPPlayers.map(p => ({ player: p.player, value: p.mvpCount })) },
];
const teamName = id => teams.find(t => t.id === id)?.data.name ?? id ?? 'TBD';
---

<Layout title="CFL Esports ID — Team Standings & Statistics" current="Home">
  <div class="container dashboard">
    <section class="home-hero">
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <span class="hero-eyebrow">CFL ESPORTS INDONESIA</span>

        <h1>
          CROSSFIRE
          <strong>LEGENDS</strong>
        </h1>

        <p class="hero-subtitle">TOURNAMENT HUB</p>

        <p class="hero-description">
          Teams, players, matches, tournaments. All in one place.
        </p>

        <div class="hero-actions">
          <a href="/tournament" class="hero-primary">
            View tournaments
          </a>

          <a href="/teams" class="hero-secondary">
            View Teams
          </a>
        </div>
      </div>
    </section>
    <div class="standings-layout">
      <aside class="season-panel">
        <span class="eyebrow">COMPETITION DETAILS</span><h2 class="competition-title"><span class="competition-number" style="color: #ff742e;">10</span> <span class="competition-word" style="color: #ffffff;">SPOTS</span><br /><span class="competition-number" style="color: #ff742e;">4</span> <span class="competition-word" style="color: #ffffff;">CHANCES</span></h2>
        
        <div class="season-counts" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));"><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalTeams}</strong><span>Teams</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalPlayers}</strong><span>Players</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{completedMatches.length}</strong><span>Matches</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalKills.toLocaleString('en-US')}</strong><span>Total Kills</span></div></div>
        <div class="season-schedule"><span class="eyebrow">ROAD TO ALL-STAR</span><div><span>S1 · August</span><span>S2 · September</span><span>S3 · October</span><span>S4 · November</span></div><p>One tournament each month.</p></div>
        <div class="scoring"><span class="eyebrow">HOW POINTS WORK</span><p>Kill points + placement points = total score.</p><dl><div><dt>Champion</dt><dd>+10</dd></div><div><dt>Runner-up</dt><dd>+6</dd></div><div><dt>Third place</dt><dd>+4</dd></div><div><dt>Fourth place</dt><dd>+2</dd></div></dl></div>
        <a href="/veto" class="veto-cta">Plan your next match <strong>Open map veto</strong></a>
      </aside>
      <section class="standings-panel" aria-labelledby="standings-title">
        <div class="section-heading"><div><span class="eyebrow">OVERALL RANKINGS</span><h2 id="standings-title">Team standings</h2></div><span class="count-badge">{totalTeams} teams</span></div>
        <div class="standings-scroll"
          tabindex="0"
          role="region"
          aria-label="Team standings, scroll horizontally on small screens">
          <table class="standings-table">
            <thead>
              <tr>
                <th scope="col">Rank</th>
                <th scope="col">Team</th>
                <th scope="col">Kills</th>
                <th scope="col">Placement</th>
                <th scope="col">Total</th>
              </tr>
            </thead>

            <tbody>
              {standings.map((team, index) => (
                <tr
                  class:list={[
                    index < 4
                      ? 'top-four'
                      : index < 10
                        ? 'top-ten'
                        : ''
                  ]}
                >
                  <td class="position">
                    {String(index + 1).padStart(2, '0')}
                  </td>

                  <td>
                    <a class="team-identity" href={`/teams/${team.id}`}>
                      <Thumbnail
                        src={team.logo}
                        width={34}
                        height="34"
                        alt=""
                        onerror="this.onerror=null; this.src='/logos/default.webp'"
                      />

                      <span>
                        <span class="team-name-line">
                          {team.name}
                          {team.isTournamentWinner && (
                            <span class="winner-crown" title="Tournament winner">👑</span>
                          )}
                        </span>

                        <small class="mobile-points">
                          {team.killPoints} kills · {team.placementPoints} placement
                        </small>
                      </span>
                    </a>
                  </td>

                  <td>{team.killPoints}</td>
                  <td>{team.placementPoints}</td>
                  <td class="total-points">{team.totalScore}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note"><Thumbnail src="/icons/crown.webp" width={24} alt="" class="inline-icon" /> Tournament winners qualify automatically. All-Star has 10 spots total; remaining spots are decided by standings placement. Repeat winners count once. Standings places remain provisional until all four monthly tournaments are complete.</p>
      </section>
    </div>
    <div class="section-heading below-heading"><div><span class="eyebrow">INDIVIDUAL PERFORMANCE</span><h2>Players making the difference</h2></div><a href="/players">All players</a></div>
    <section class="leaderboards" aria-label="Player leaders">
      {leaderboards.map(board => <article class="leaderboard"><div class="board-heading"><h3>{board.title}</h3><span>{board.label}</span></div>{board.entries.map(({player, value}, index) => <a class:list={['player-row', index < 3 && `medal-${index + 1}`]} href={`/players/${player.id}`}><span class="player-rank">{index + 1}</span><Thumbnail src={ player.data.avatar || (player.data.uid? `/players/${player.data.uid}.webp`: '/players/default.webp') } alt="" width={42} height="42" loading="lazy" onerror="this.onerror=null; this.src='/players/default.webp'" /><span class="player-name">{player.data.ign}<small>{teamName(player.data.team)}</small></span><strong>{value}</strong></a>)}{board.entries.length === 0 && <p class="empty-copy">No recorded awards yet.</p>}</article>)}
    </section>
    <div class="bottom-grid">
      <section class="bottom-panel"><div class="section-heading"><h2>Tournament winners</h2><a href="/tournament">View all</a></div>
        {tournaments.filter(t => t.winnerTeams.length).map(t => <article class="winner-event"><a class="event-name" href={`/tournament/${t.id}`}>{t.name}</a>{t.winnerTeams.map(w => <a class:list={['podium-row', `medal-${w.place}`]} href={`/teams/${w.team.id}`}><span class="podium-place"><Thumbnail width={24}
          src={
            w.place === 1
              ? '/icons/gold-medal.webp'
              : w.place === 2
              ? '/icons/silver-medal.webp'
              : '/icons/bronze-medal.webp'
          }
          alt=""
          class="podium-icon"
        /></span><span>{w.team.data.name}</span><small>{w.place === 1 ? 'Champion' : w.place === 2 ? 'Runner-up' : 'Third place'}</small></a>)}</article>)}
        {!tournaments.some(t => t.winnerTeams.length) && <p class="empty-copy">The next champion is yet to be decided.</p>}
      </section>
      <section class="bottom-panel"><div class="section-heading"><h2>Upcoming matches</h2><a href="/matches">Schedule</a></div>{upcomingMatches.slice(0,5).map(m => <a class="fixture" href={`/matches/${m.id}`}><time datetime={m.data.date}>{m.data.date}</time><strong>{teamName(m.data.team1Id)} <span>vs</span> {teamName(m.data.team2Id)}</strong></a>)}{!upcomingMatches.length && <div class="empty-fixtures"><span class="eyebrow">YOU'RE ALL CAUGHT UP</span><h3>Waiting for the next matchup</h3><p>Upcoming matches will appear here when the schedule is announced.</p><a href="/matches">Browse match results</a></div>}</section>
    </div>
  </div>
</Layout>
<style>
/* =========================================================
   HOME HERO
   ========================================================= */

.home-hero {
  position: relative;
  min-height: 390px;
  display: flex;
  align-items: center;
  overflow: hidden;
  margin-bottom: 28px;

  background-image: url('/images/cfl-hero.webp');
  background-size: cover;
  background-position: center;

  border: 1px solid var(--border);
  border-radius: 12px;
}

.hero-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(6, 10, 14, 0.12) 0%,
      rgba(6, 10, 14, 0.38) 25%,
      rgba(6, 10, 14, 0.72) 43%,
      rgba(6, 10, 14, 0.50) 58%,
      rgba(6, 10, 14, 0.08) 78%,
      transparent 100%
    ),
    linear-gradient(
      0deg,
      rgba(6, 10, 14, 0.62) 0%,
      transparent 55%
    );
}

.hero-content {
  position: relative;
  z-index: 1;

  width: 500px;
  max-width: 50%;

  margin: 0 auto;
  padding: 54px 0;

  text-align: center;
}

.hero-eyebrow {
  color: var(--accent);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.home-hero h1 {
  margin: 12px 0 0;
  font-size: clamp(38px, 4.2vw, 58px);
  line-height: 0.98;
  letter-spacing: -0.045em;
  font-weight: 800;
}

.home-hero h1 strong {
  display: block;
  color: var(--accent);
}

.hero-subtitle {
  margin-top: 10px;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hero-description {
  max-width: 430px;
  margin: 16px auto 0;

  color: rgba(255, 255, 255, 0.82);
  font-size: 14px;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 25px;
}

.hero-primary,
.hero-secondary {
  width: 190px;
  min-height: 44px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 16px;

  border-radius: 6px;

  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.hero-primary {
  background: var(--accent);
  color: #111;
}

.hero-primary:hover {
  background: var(--accent-hover);
  color: #111;
}

.hero-secondary {
  background: rgba(8, 12, 16, 0.45);
  color: var(--text-primary);

  border: 1px solid rgba(255, 255, 255, 0.2);

  backdrop-filter: blur(8px);
}

.hero-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
}


/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard {
  padding-top: 36px;
  padding-bottom: 28px;
}

.eyebrow {
  color: var(--text-muted);

  font-size: 12px;
  font-weight: 750;
  letter-spacing: 0.15em;
}

.mobile-points {
  display: none !important;
}

.dashboard a {
  transition:
    color 0.18s,
    background-color 0.18s,
    border-color 0.18s,
    box-shadow 0.18s;
}

.dashboard a:hover {
  color: var(--accent);
  text-decoration: none;
}


/* =========================================================
   OVERALL STANDINGS LAYOUT
   ========================================================= */

.standings-layout {
  display: grid;
  grid-template-columns: 215px minmax(0, 1fr);
  gap: 32px;
}


/* =========================================================
   COMPETITION DETAILS
   ========================================================= */

.season-panel {
  align-self: start;

  padding: 24px;

  background: var(--bg-secondary);

  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: 10px;
}

.season-panel h2 {
  margin: 15px 0;

  font-size: 25px;
  line-height: 1.2;
  letter-spacing: -0.8px;
}

.season-panel h2 span {
  color: var(--accent);
}

.season-panel p {
  color: var(--text-muted);
  font-size: 15px;
}

.season-panel .competition-title .competition-number {
  color: var(--accent);
  font-size: 25px;
}

.season-panel .competition-title .competition-word {
  color: #fff;
  margin-left: 6px;
  font-size: 25px;
}

.season-panel .competition-title br {
  display: initial;
}


/* Competition stats */

.season-counts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;

  margin: 25px 0;
}

.season-counts div:last-child {
  grid-column: auto;
}

.season-counts strong {
  display: block;

  color: var(--accent);

  font-size: 25px;
}

.season-counts span {
  color: var(--text-muted);
  font-size: 13px;
}


/* Road to All-Star */

.season-schedule {
  padding: 18px 0;

  border-top: 1px solid var(--border);
}

.season-schedule > div {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;

  margin: 12px 0;

  font-size: 13px;
}

.season-schedule > div > span {
  min-width: 0;

  padding: 8px 10px;

  background: var(--bg-card);

  border-radius: 4px;

  white-space: nowrap;
  line-height: 1.6;
}


/* Scoring */

.scoring {
  padding-top: 20px;

  border-top: 1px solid var(--border);
}

.scoring p {
  margin: 10px 0;
}

.scoring dl div {
  display: flex;
  justify-content: space-between;

  margin: 10px 0;

  font-size: 14px;
}

.scoring dd {
  color: var(--accent);
  font-weight: 700;
}


/* Veto */

.veto-cta {
  display: block;

  margin-top: 24px;
  padding: 14px;

  background: var(--accent-dim);
  color: var(--text-secondary);

  border-left: 2px solid var(--accent);

  font-size: 13px;
}

.veto-cta strong {
  display: block;

  margin-top: 4px;

  color: var(--accent);

  font-size: 15px;
}

.veto-cta:hover {
  background: var(--bg-card-hover);
  box-shadow: inset 3px 0 var(--accent);
}


/* =========================================================
   SECTION HEADINGS
   ========================================================= */

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-bottom: 16px;
}

.section-heading h2 {
  font-size: 20px;
  letter-spacing: -0.45px;
}

.section-heading a {
  font-size: 14px;
  white-space: nowrap;
}

.count-badge {
  padding: 5px 10px;

  color: var(--text-muted);

  border: 1px solid var(--border);
  border-radius: 20px;

  font-size: 13px;
}


/* Overall standings heading */

.standings-panel > .section-heading {
  position: relative;

  margin-bottom: 14px;
  padding-bottom: 15px;

  border-bottom: 1px solid var(--border);
}

.standings-panel > .section-heading::after {
  content: "";

  position: absolute;
  bottom: -1px;
  left: 0;

  width: 52px;
  height: 2px;

  background: var(--accent);
}

.standings-panel > .section-heading h2 {
  margin-top: 4px;

  font-size: 24px;
}


/* =========================================================
   STANDINGS TABLE
   ========================================================= */

.standings-scroll {
  overflow-x: auto;
}

.standings-table {
  width: 100%;

  border-collapse: separate;
  border-spacing: 0 6px;

  font-size: 15px;
}

.standings-table th {
  padding: 0 14px 6px;

  background: transparent;
  color: var(--text-muted);

  font-size: 12px;
  letter-spacing: 0.06em;
  text-align: right;
}

.standings-table th:nth-child(-n + 2) {
  text-align: left;
}

.standings-table td {
  padding: 11px 14px;

  background: var(--bg-card);

  border: 0;

  text-align: right;
  font-variant-numeric: tabular-nums;
}

.standings-table td:first-child {
  width: 50px;

  text-align: left;

  border-radius: 6px 0 0 6px;
}

.standings-table td:nth-child(2) {
  text-align: left;
}

.standings-table td:last-child {
  border-radius: 0 6px 6px 0;
}


/* Qualification zones */

.dashboard .standings-table .top-four td {
  background: rgba(255, 116, 46, 0.07);
}

.dashboard .standings-table .top-ten td {
  background: rgba(255, 255, 255, 0.035);
}

.dashboard .standings-table .top-four td:first-child {
  border-left: 3px solid var(--accent);
}

.dashboard .standings-table .top-ten td:first-child {
  border-left: 3px solid #9696a8;
}

.dashboard .standings-table tr:hover td {
  background: #45454a;
}


/* Table data */

.position {
  color: var(--text-muted);

  font-size: 14px;
  font-weight: 700;
}

.total-points {
  color: var(--accent);
  font-weight: 800;
}


/* Team */

.team-identity {
  display: flex;
  align-items: center;
  gap: 12px;

  color: var(--text-primary);

  font-weight: 650;
  line-height: 1.3;
}

.team-identity img {
  flex-shrink: 0;
  object-fit: contain;
}

.team-identity small {
  display: block;

  margin-top: 3px;

  color: var(--accent);

  font-size: 12px;
  font-weight: 500;
}


/* Qualification */

.table-note {
  margin-top: 10px;
  font-size: 11px;
  line-height: 1.5;
  color: var(--text-muted);
}

.team-name-line {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.winner-crown {
  display: inline-block;
  flex-shrink: 0;

  font-size: 12px;
  line-height: 1;

  transform: translateY(-1px);
}

/* =========================================================
   SMALL ICONS
   ========================================================= */

.inline-icon {
  width: 14px;
  height: 14px;

  margin-right: 4px;

  object-fit: contain;

  vertical-align: -2px;
}

.table-note .inline-icon {
  margin-right: 5px;
}


/* =========================================================
   PLAYER LEADERBOARDS
   ========================================================= */

.below-heading {
  position: relative;

  margin-top: 44px;
  padding-bottom: 14px;

  border-bottom: 1px solid var(--border);
}

.below-heading::after {
  content: "";

  position: absolute;
  bottom: -1px;
  left: 0;

  width: 52px;
  height: 2px;

  background: var(--accent);
}

.below-heading h2 {
  font-size: 24px;
}

.leaderboards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;

  margin-top: 18px;
}

.leaderboard {
  padding: 18px;

  background:
