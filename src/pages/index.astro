---
import { getOverallStandings } from '../utils/standings';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats } from '../utils/statistics';
import { getMatchRound } from '../utils/tournament';
import {
  getMatchTournamentId,
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchWinnerId,
} from '../utils/content';

const teams = await getCollection('teams');
const allPlayers = await getCollection('players');
const matches = await getCollection('matches');
const allTournaments = await getCollection('tournaments');
const calculated = calculateStatistics(matches);
const players = allPlayers.map(player => ({ ...player, data: { ...player.data, stats: calculated.players.get(player.data.uid || player.id) ?? emptyStats() } }));

const totalTeams = teams.length;
const totalPlayers = players.length;
const totalMatches = matches.length;
const completedMatches = matches.filter(m => m.data.status === 'completed');
const upcomingMatches = matches.filter(m => m.data.status === 'upcoming').sort((a,b) => a.data.date.localeCompare(b.data.date));
const totalKills = calculated.totals.kills;

// Resolve each tournament and its matches by canonical ID.
const tournaments = allTournaments.map(tournament => {
  const tMatches = matches.filter(m => getMatchTournamentId(m) === tournament.id);
  const finalMatch = tMatches.find(m => getMatchRound(m, tournament)?.placement === 1 && m.data.status === 'completed');
  const bronzeMatch = tMatches.find(m => getMatchRound(m, tournament)?.placement === 3 && m.data.status === 'completed');

  let winnerTeams = [];

  if (finalMatch) {
    const winner = teams.find(t => t.id === getMatchWinnerId(finalMatch));
    const finalWinnerId = getMatchWinnerId(finalMatch);
    const finalTeam1Id = getMatchTeam1Id(finalMatch);
    const finalTeam2Id = getMatchTeam2Id(finalMatch);
    const runnerUpId = finalWinnerId && finalWinnerId === finalTeam1Id
      ? finalTeam2Id
      : finalWinnerId && finalWinnerId === finalTeam2Id ? finalTeam1Id : null;
    const runnerUp = teams.find(t => t.id === runnerUpId);
    const thirdPlace = bronzeMatch ? teams.find(t => t.id === getMatchWinnerId(bronzeMatch)) : null;

    if (winner) winnerTeams.push({ team: winner, place: 1 });
    if (runnerUp) winnerTeams.push({ team: runnerUp, place: 2 });
    if (thirdPlace) winnerTeams.push({ team: thirdPlace, place: 3 });
  }

  return { id: tournament.id, name: tournament.data.name, winnerTeams, finalMatch, bronzeMatch };
});

// Calculate placement points from Final and Bronze Match
function getPlacementPoints(teamId) {
  return tournaments.reduce((total, { finalMatch, bronzeMatch }) => {
    if (finalMatch) {
      if (getMatchWinnerId(finalMatch) === teamId) return total + 10;
      if (getMatchTeam1Id(finalMatch) === teamId || getMatchTeam2Id(finalMatch) === teamId) return total + 6;
    }
    if (bronzeMatch) {
      if (getMatchWinnerId(bronzeMatch) === teamId) return total + 4;
      if (getMatchTeam1Id(bronzeMatch) === teamId || getMatchTeam2Id(bronzeMatch) === teamId) return total + 2;
    }
    return total;
  }, 0);
}

function getTeamKillPoints(teamId) {
  return calculated.teams.get(teamId)?.kills ?? 0;
}

function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (getMatchTeam1Id(m) === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (getMatchTeam2Id(m) === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

// Set of team IDs that won a tournament (1st place in any tournament's Final)
const tournamentWinnerIds = new Set(
  tournaments
    .flatMap(t => t.winnerTeams)
    .filter(wt => wt.place === 1)
    .map(wt => wt.team.id)
);

const standings = getOverallStandings(teams, matches, allTournaments);

const topFraggers = [...players].sort((a, b) => b.data.stats.kills - a.data.stats.kills).slice(0, 5);
const topAssistsPlayers = [...players].sort((a, b) => b.data.stats.assists - a.data.stats.assists).slice(0, 5);

const totalMVPs = calculated.totals.mvpCount;
const topMVPPlayers = players
  .map(p => ({ player: p, mvpCount: p.data.stats.mvpCount }))
  .filter(p => p.mvpCount > 0)
  .sort((a, b) => b.mvpCount - a.mvpCount)
  .slice(0, 5);
const leaderboards = [
  { title: 'Top fraggers', label: 'Kills', entries: topFraggers.map(p => ({ player: p, value: p.data.stats.kills })) },
  { title: 'Top assists', label: 'Assists', entries: topAssistsPlayers.map(p => ({ player: p, value: p.data.stats.assists })) },
  { title: 'Top MVPs', label: 'Awards', entries: topMVPPlayers.map(p => ({ player: p.player, value: p.mvpCount })) },
];
const teamName = id => teams.find(t => t.id === id)?.data.name ?? id ?? 'TBD';
---

<Layout title="CFL Esports ID — Team Standings & Statistics" current="Home">
  <div class="container dashboard">
    <div class="dashboard-heading"><div><span class="eyebrow">CROSSFIRE: LEGENDS · INDONESIA</span><h1>Clash for Glory: Road to All-Star</h1><p>Every match. Every point. Follow the teams on the rise.</p></div><a class="outline-link" href="/tournament">Explore tournaments ↗</a></div>
    <div class="standings-layout">
      <aside class="season-panel">
        <span class="eyebrow">COMPETITION DETAILS</span><h2 class="competition-title"><span class="competition-number" style="color: #ff742e;">10</span> <span class="competition-word" style="color: #ffffff;">SPOTS</span><br /><span class="competition-number" style="color: #ff742e;">4</span> <span class="competition-word" style="color: #ffffff;">CHANCES</span></h2>
        
        <div class="season-counts" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));"><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalTeams}</strong><span>Teams</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalPlayers}</strong><span>Players</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{completedMatches.length}</strong><span>Matches</span></div><div style="grid-column:auto;"><strong style="color:#ff742e;">{totalKills.toLocaleString('en-US')}</strong><span>Total Kills</span></div></div>
        <div class="season-schedule"><span class="eyebrow">ROAD TO ALL-STAR</span><div><span>S1 · August</span><span>S2 · September</span><span>S3 · October</span><span>S4 · November</span></div><p>One tournament each month.</p></div>
        <div class="scoring"><span class="eyebrow">HOW POINTS WORK</span><p>Kill points + placement points = total score.</p><dl><div><dt>Champion</dt><dd>+10</dd></div><div><dt>Runner-up</dt><dd>+6</dd></div><div><dt>Third place</dt><dd>+4</dd></div><div><dt>Fourth place</dt><dd>+2</dd></div></dl></div>
        <a href="/veto" class="veto-cta">Plan your next match <strong>Open map veto ↗</strong></a>
      </aside>
      <section class="standings-panel" aria-labelledby="standings-title">
        <div class="section-heading"><div><span class="eyebrow">OVERALL RANKINGS</span><h2 id="standings-title">Team standings</h2></div><span class="count-badge">{totalTeams} teams</span></div>
        <div class="standings-scroll" tabindex="0" role="region" aria-label="Team standings, scroll horizontally on small screens">
          <table class="standings-table"><thead><tr><th scope="col">Rank</th><th scope="col">Team</th><th scope="col">Kills</th><th scope="col">Placement</th><th scope="col">Total</th></tr></thead><tbody>
            {standings.map((team, index) => <tr class:list={[index < 4 ? 'top-four' : index < 10 ? 'top-ten' : '']}><td class="position">{String(index + 1).padStart(2, '0')}</td><td><a class="team-identity" href={`/teams/${team.id}`}><img src={team.logo} width="34" height="34" alt="" onerror="this.onerror=null; this.src='/logos/default.png'" /><span>{team.name}<small class="mobile-points">{team.killPoints} kills · {team.placementPoints} placement</small>{team.isTournamentWinner && (
              <small class="qualified-label">
                <img src="/icons/crown.png" alt="" class="inline-icon" />
                Qualified · Tournament winner
              </small>
            )}</span></a></td><td>{team.killPoints}</td><td>{team.placementPoints}</td><td class="total-points">{team.totalScore}</td></tr>)}
          </tbody></table>
        </div>
        <p class="table-note"><img src="/icons/crown.png" alt="" class="inline-icon" /> Tournament winners qualify automatically. All-Star has 10 spots total; remaining spots are decided by standings placement. Repeat winners count once. Standings places remain provisional until all four monthly tournaments are complete.</p>
      </section>
    </div>
    <div class="section-heading below-heading"><div><span class="eyebrow">INDIVIDUAL PERFORMANCE</span><h2>Players making the difference</h2></div><a href="/players">All players ↗</a></div>
    <section class="leaderboards" aria-label="Player leaders">
      {leaderboards.map(board => <article class="leaderboard"><div class="board-heading"><h3>{board.title}</h3><span>{board.label}</span></div>{board.entries.map(({player, value}, index) => <a class:list={['player-row', index < 3 && `medal-${index + 1}`]} href={`/players/${player.id}`}><span class="player-rank">{index + 1}</span><img src={player.data.avatar || '/players/default.png'} alt="" width="42" height="42" loading="lazy" onerror="this.onerror=null; this.src='/players/default.png'" /><span class="player-name">{player.data.ign}<small>{teamName(player.data.team)}</small></span><strong>{value}</strong></a>)}{board.entries.length === 0 && <p class="empty-copy">No recorded awards yet.</p>}</article>)}
    </section>
    <div class="bottom-grid">
      <section class="bottom-panel"><div class="section-heading"><h2>Tournament winners</h2><a href="/tournament">View all ↗</a></div>
        {tournaments.filter(t => t.winnerTeams.length).map(t => <article class="winner-event"><a class="event-name" href={`/tournament/${t.id}`}>{t.name} ↗</a>{t.winnerTeams.map(w => <a class:list={['podium-row', `medal-${w.place}`]} href={`/teams/${w.team.id}`}><span class="podium-place"><img
          src={
            w.place === 1
              ? '/icons/gold-medal.png'
              : w.place === 2
              ? '/icons/silver-medal.png'
              : '/icons/bronze-medal.png'
          }
          alt=""
          class="podium-icon"
        /></span><span>{w.team.data.name}</span><small>{w.place === 1 ? 'Champion' : w.place === 2 ? 'Runner-up' : 'Third place'}</small></a>)}</article>)}
        {!tournaments.some(t => t.winnerTeams.length) && <p class="empty-copy">The next champion is yet to be decided.</p>}
      </section>
      <section class="bottom-panel"><div class="section-heading"><h2>Upcoming matches</h2><a href="/matches">Schedule ↗</a></div>{upcomingMatches.slice(0,5).map(m => <a class="fixture" href={`/matches/${m.id}`}><time datetime={m.data.date}>{m.data.date}</time><strong>{teamName(m.data.team1Id)} <span>vs</span> {teamName(m.data.team2Id)}</strong></a>)}{!upcomingMatches.length && <div class="empty-fixtures"><span class="eyebrow">YOU'RE ALL CAUGHT UP</span><h3>Waiting for the next matchup</h3><p>Upcoming matches will appear here when the schedule is announced.</p><a href="/matches">Browse match results ↗</a></div>}</section>
    </div>
  </div>
</Layout>
<style>
