---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const teams = await getCollection('teams');
const players = await getCollection('players');
const matches = await getCollection('matches');

const totalTeams = teams.length;
const totalPlayers = players.length;
const totalMatches = matches.length;
const completedMatches = matches.filter(m => m.data.status === 'completed');
const upcomingMatches = matches.filter(m => m.data.status !== 'completed');
const totalKills = players.reduce((sum, p) => sum + p.data.stats.kills, 0);

// Calculate placement points from Final and Bronze Match
function getPlacementPoints(teamId) {
  const finalMatch = matches.find(m => m.data.round === 'Final' && m.data.status === 'completed');
  const bronzeMatch = matches.find(m => m.data.round === 'Bronze Match' && m.data.status === 'completed');
  if (finalMatch) {
    if (finalMatch.data.winner === teamId) return 10;
    if (finalMatch.data.team1 === teamId || finalMatch.data.team2 === teamId) return 6;
  }
  if (bronzeMatch) {
    if (bronzeMatch.data.winner === teamId) return 4;
    if (bronzeMatch.data.team1 === teamId || bronzeMatch.data.team2 === teamId) return 2;
  }
  return 0;
}

// Calculate kill points (sum of player kills)
function getTeamKillPoints(teamId) {
  return players.filter(p => p.data.team === teamId).reduce((sum, p) => sum + p.data.stats.kills, 0);
}

// Calculate team record from matches
function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (m.data.team1 === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (m.data.team2 === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

// Team standings
const standings = teams.map(team => {
  const killPoints = getTeamKillPoints(team.id);
  const placementPoints = getPlacementPoints(team.id);
  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    killPoints,
    placementPoints,
    totalScore: killPoints + placementPoints,
  };
}).sort((a, b) => b.totalScore - a.totalScore);

// Top 5 fraggers
const topFraggers = [...players].sort((a, b) => b.data.stats.kills - a.data.stats.kills).slice(0, 5);
const topFraggersWithKD = topFraggers.map(p => ({
  ...p,
  kd: (p.data.stats.kills / Math.max(p.data.stats.deaths, 1)).toFixed(2),
}));

// Top 5 assists
const topAssistsPlayers = [...players].sort((a, b) => b.data.stats.assists - a.data.stats.assists).slice(0, 5);

// Tournament winner (1st-3rd from Final and Bronze Match)
const finalMatch = matches.find(m => m.data.round === 'Final' && m.data.status === 'completed');
const bronzeMatch = matches.find(m => m.data.round === 'Bronze Match' && m.data.status === 'completed');

let winnerTeams = [];

if (finalMatch) {
  const winner = teams.find(t => t.id === finalMatch.data.winner);
  const runnerUp = teams.find(t => t.id === (finalMatch.data.team1 === finalMatch.data.winner ? finalMatch.data.team2 : finalMatch.data.team1));
  const thirdPlace = bronzeMatch ? teams.find(t => t.id === bronzeMatch.data.winner) : null;

  if (winner) winnerTeams.push({ team: winner, place: 1 });
  if (runnerUp) winnerTeams.push({ team: runnerUp, place: 2 });
  if (thirdPlace) winnerTeams.push({ team: thirdPlace, place: 3 });
}
---

<Layout title="CFL Esports ID Tournament Hub - Home" current="Home">
  <div class="container">
    <div class="page-header">
      <h1>CFL Esports ID Tournament Hub</h1>
      <p>Crossfire competitive tournament tracker — teams, players, and match results.</p>
    </div>

    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-box">
        <div class="stat-value">{totalTeams}</div>
        <div class="stat-label">Total Teams</div>
      </div>
      <div class="stat-box">
        <div class="stat-value">{totalPlayers}</div>
        <div class="stat-label">Total Players</div>
      </div>
      <div class="stat-box">
        <div class="stat-value">{totalMatches}</div>
        <div class="stat-label">Fixtures Played</div>
      </div>
      <div class="stat-box">
        <div class="stat-value">{upcomingMatches.length}</div>
        <div class="stat-label">Upcoming</div>
      </div>
      <div class="stat-box">
        <div class="stat-value">{totalKills}</div>
        <div class="stat-label">Total Kills</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem;">Team Standings</h2>
    <div class="table-wrap" style="margin-bottom: 2rem;">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Team</th>
            <th>Kill Points</th>
            <th>Placement Points</th>
            <th>Total Score</th>
          </tr>
        </thead>
        <tbody>
          {standings.map((team, index) => (
            <tr class={index === 0 ? 'rank-gold' : index === 1 ? 'rank-silver' : index === 2 ? 'rank-bronze' : ''}>
              <td style="color: var(--text-muted);">{index + 1}</td>
              <td><a href={`/teams/${team.id}`}><strong>{team.name}</strong></a></td>
              <td class="kda"><span class="kill">{team.killPoints}</span></td>
              <td>{team.placementPoints > 0 ? <span style="color: #f59e0b; font-weight: 700;">{team.placementPoints}</span> : '0'}</td>
              <td style="font-weight: 700; color: var(--accent);">{team.totalScore}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="grid grid-3">
      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--accent);">Top Fraggers</h3>
        <div class="top-list">
          {topFraggersWithKD.map((p, i) => (
            <div class="top-list-item">
              <span class="top-rank">{i + 1}</span>
              <div class="avatar">{p.data.ign.charAt(0).toUpperCase()}</div>
              <div class="top-info">
                <a href={`/players/${p.id}`}><strong>{p.data.ign}</strong></a>
                <div style="color: var(--text-secondary); font-size: 0.85rem;">
                  <span class="kda"><span class="kill">{p.data.stats.kills}</span>/<span class="death">{p.data.stats.deaths}</span>/<span class="assist">{p.data.stats.assists}</span></span>
                  <span style="margin-left: 0.5rem;">K/D: {p.kd}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--accent);">Top Assists</h3>
        <div class="top-list">
          {topAssistsPlayers.map((p, i) => (
            <div class="top-list-item">
              <span class="top-rank">{i + 1}</span>
              <div class="avatar">{p.data.ign.charAt(0).toUpperCase()}</div>
              <div class="top-info">
                <a href={`/players/${p.id}`}><strong>{p.data.ign}</strong></a>
                <div style="color: var(--text-secondary); font-size: 0.85rem;">
                  {p.data.stats.assists} assists
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--accent);">Tournament Winner</h3>
        {winnerTeams.length > 0 ? (
          <div class="winner-list">
            {winnerTeams.map((wt) => (
              <div class={`top-list-item ${wt.place === 1 ? 'rank-gold' : wt.place === 2 ? 'rank-silver' : 'rank-bronze'}`}>
                <span class="top-rank">{wt.place === 1 ? '🥇' : wt.place === 2 ? '🥈' : '🥉'}</span>
                <div class="avatar">{wt.team.data.tag.charAt(0)}</div>
                <div class="top-info">
                  <a href={`/teams/${wt.team.id}`}><strong>{wt.team.data.name}</strong></a>
                  <div style="color: var(--text-secondary); font-size: 0.85rem;">
                    {wt.place === 1 ? 'Champion' : wt.place === 2 ? 'Runner-up' : 'Third Place'}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p style="color: var(--text-secondary); font-size: 0.9rem;">Tournament in progress.</p>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Team standings rank highlight */
  .rank-gold {
    background: rgba(255, 215, 0, 0.12);
    border-left: 3px solid #ffd700;
  }
  .rank-gold td:first-child {
    color: #ffd700 !important;
    font-weight: 700;
  }
  .rank-silver {
    background: rgba(192, 192, 192, 0.12);
    border-left: 3px solid #c0c0c0;
  }
  .rank-silver td:first-child {
    color: #c0c0c0 !important;
    font-weight: 700;
  }
  .rank-bronze {
    background: rgba(205, 127, 50, 0.12);
    border-left: 3px solid #cd7f32;
  }
  .rank-bronze td:first-child {
    color: #cd7f32 !important;
    font-weight: 700;
  }

  /* Top fraggers / assists / winner list */
  .top-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .top-list-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 6px;
  }
  .top-list-item:hover {
    background: var(--bg-card-hover);
  }
  .top-rank {
    font-weight: 700;
    color: var(--text-muted);
    min-width: 1.5rem;
    text-align: center;
  }
  .top-info {
    flex: 1;
  }

  /* Winner list */
  .winner-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .winner-list .top-list-item {
    padding: 0.75rem;
    border-radius: 8px;
  }
</style>
