g{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.section-heading h2{font-size:20px;letter-spacing:-.45px}.section-heading a{font-size:14px;white-space:nowrap}.count-badge{font-size:13px;padding:5px 10px;border:1px solid var(--border);border-radius:20px;color:var(--text-muted)}.standings-scroll{overflow-x:auto}.standings-table{width:100%;border-collapse:separate;border-spacing:0 6px;font-size:15px}.standings-table th{background:transparent;font-size:12px;letter-spacing:.06em;color:var(--text-muted);padding:0 14px 6px;text-align:right}.standings-table th:nth-child(-n+2){text-align:left}.standings-table td{background:var(--bg-card);border:0;padding:11px 14px;text-align:right;font-variant-numeric:tabular-nums}.standings-table td:first-child{border-radius:6px 0 0 6px;text-align:left;width:50px}.standings-table td:nth-child(2){text-align:left}.standings-table td:last-child{border-radius:0 6px 6px 0}.standings-table .leader td{background:#34302c}.position{font-size:14px;color:var(--text-muted);font-weight:700}.leader .position{color:var(--accent)}.team-identity{display:flex;align-items:center;gap:12px;color:var(--text-primary);font-weight:650;line-height:1.3}.team-identity img{object-fit:contain;flex-shrink:0}.team-identity small{display:block;font-size:12px;color:var(--accent);font-weight:500;margin-top:3px}.total-points{font-weight:800;color:var(--accent)}.table-note{font-size:12px;color:var(--text-muted);margin-top:10px}.below-heading{margin-top:38px}.leaderboards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.leaderboard,.bottom-panel{background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;padding:20px}.board-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.board-heading h3{font-size:16px}.board-heading>span{font-size:12px;text-transform:uppercase;color:var(--text-muted)}.player-row{display:flex;align-items:center;gap:10px;padding:13px 0;border-bottom:1px solid var(--border);color:var(--text-primary)}.player-row:last-child{border:0}.player-rank{font-size:13px;color:var(--text-muted);width:12px}.player-row img{border-radius:6px;object-fit:cover;background:var(--bg-card)}.player-name{flex:1;min-width:0;font-size:15px;overflow-wrap:anywhere}.player-name small{display:block;font-size:12px;color:var(--text-muted);margin-top:2px}.player-row>strong{font-size:19px;font-variant-numeric:tabular-nums}.player-row:first-of-type>strong{color:var(--accent)}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:28px}.event-name{display:block;font-size:14px;color:var(--text-muted);margin:18px 0 10px}.podium-row{display:flex;align-items:center;gap:12px;padding:13px 0;color:var(--text-primary);font-size:15px}.podium-place{color:var(--accent);font-weight:700}.podium-row small{margin-left:auto;color:var(--text-muted);font-size:12px}.empty-fixtures{padding:28px 4px}.empty-fixtures h3{font-size:19px;margin:12px 0 8px}.empty-fixtures p,.empty-copy{font-size:15px;color:var(--text-muted);margin-bottom:18px}.empty-fixtures a{font-size:14px}.fixture{display:block;border-top:1px solid var(--border);padding:15px 0}.fixture time{display:block;color:var(--text-muted);font-size:13px}.fixture strong{font-size:14px;color:var(--text-primary)}.fixture span{color:var(--accent);margin:0 6px}
@media(max-width:900px){.standings-layout{grid-template-columns:190px minmax(0,1fr);gap:18px}.season-panel{padding:18px}.season-panel h2{font-size:23px}.leaderboards{gap:12px}.leaderboard{padding:14px}.standings-table td,.standings-table th{padding-left:10px;padding-right:10px}}
@media(max-width:640px){.dashboard{padding-top:22px}.dashboard-heading{align-items:start}.dashboard-heading h1{font-size:28px}.dashboard-heading p{font-size:14px}.outline-link{display:none}.standings-layout{display:flex;flex-direction:column}.standings-panel{order:0}.season-panel{order:1;width:100%;margin-top:8px}.season-panel h2{font-size:22px}.season-panel h2 br{display:none}.season-counts{grid-template-columns:repeat(2,1fr);margin:18px 0}.season-counts div:last-child{grid-column:auto}.scoring dl{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.veto-cta{margin-top:14px}.standings-table{font-size:14px;min-width:0;width:100%;table-layout:fixed}.standings-table th:first-child{width:36px}.standings-table th:last-child{width:58px}.team-identity{gap:8px}.team-identity img{width:28px;height:28px}.section-heading h2{font-size:18px}.leaderboards,.bottom-grid{grid-template-columns:1fr}.leaderboard{padding:18px}.below-heading{margin-top:28px}.below-heading .eyebrow{font-size:12px}.player-row{padding:12px 0}.bottom-panel{padding:18px}.podium-row{gap:8px}.dashboard-heading{margin-bottom:24px}}
