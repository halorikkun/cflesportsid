---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const matches = (await getCollection('matches')).sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const playersMap = new Map(allPlayers.map(p => [p.id, p]));
---

<Layout title="Matches - CFL Tournament Hub" current="Matches">
  <div class="container">
    <div class="page-header">
      <h1>Matches</h1>
      <p>{matches.length} matches across all CFL tournaments.</p>
    </div>

    <div class="grid grid-2">
      {matches.map(m => {
        const t1 = teamsMap.get(m.data.team1);
        const t2 = teamsMap.get(m.data.team2);
        const mvpPlayer = m.data.mvp ? playersMap.get(m.data.mvp) : undefined;
        const team1Name = t1 ? t1.data.name : m.data.team1;
        const team2Name = t2 ? t2.data.name : m.data.team2;
        const scoreText = m.data.status === 'completed'
          ? `${m.data.score1} - ${m.data.score2}`
          : 'VS';
        return (
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
              <div>
                <span class={`badge badge-${m.data.status}`}>{m.data.status}</span>
                <div style="margin-top: 0.5rem; color: var(--text-secondary); font-size: 0.85rem;">
                  {m.data.tournament} · {m.data.round}
                </div>
              </div>
              <div style="text-align: right; color: var(--text-muted); font-size: 0.85rem;">
                {m.data.date}
                {m.data.map && <div>Map: {m.data.map}</div>}
                {m.data.duration && <div>Duration: {m.data.duration}</div>}
              </div>
            </div>

            <div class="score-display" style="justify-content: center; padding: 1rem 0;">
              <a href={`/teams/${m.data.team1}`}>{team1Name}</a>
              <span class="vs">{scoreText}</span>
              <a href={`/teams/${m.data.team2}`}>{team2Name}</a>
            </div>

            {m.data.status === 'completed' && mvpPlayer && (
              <div style="text-align: center; color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.5rem;">
                MVP: <a href={`/players/${mvpPlayer.id}`}>{mvpPlayer.data.ign}</a>
              </div>
            )}

            {m.data.status === 'completed' && (
              <div style="display: flex; justify-content: space-around; margin-top: 1rem; font-size: 0.8rem; color: var(--text-muted);">
                <div>
                  {team1Name}: <span class="kda"><span class="kill">{m.data.stats1.kills}</span>/<span class="death">{m.data.stats1.deaths}</span>/<span class="assist">{m.data.stats1.assists}</span></span>
                </div>
                <div>
                  {team2Name}: <span class="kda"><span class="kill">{m.data.stats2.kills}</span>/<span class="death">{m.data.stats2.deaths}</span>/<span class="assist">{m.data.stats2.assists}</span></span>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</Layout>
