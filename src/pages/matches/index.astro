---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTeams = await getCollection('teams');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));

const roundOrder = {
  'Final': 8, 'Bronze Match': 7, 'Semi Final': 6, 'Quarter Final': 5,
  'Top 16': 4, 'Third Round': 3, 'Second Round': 2, 'First Round': 1,
};

const matches = (await getCollection('matches')).sort((a, b) => {
  if (a.data.status !== b.data.status) {
    if (a.data.status === 'upcoming') return -1;
    if (b.data.status === 'upcoming') return 1;
    if (a.data.status === 'live') return -1;
    if (b.data.status === 'live') return 1;
  }
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  if (dateA !== dateB) return dateB - dateA;
  const rA = roundOrder[a.data.round] || 99;
  const rB = roundOrder[b.data.round] || 99;
  return rB - rA;
});

function getTeamKDA(match, teamId) {
  const team = teamsMap.get(teamId);
  if (!team || !team.data.players) return { kills: 0, deaths: 0, assists: 0 };
  const teamPlayerUids = new Set(team.data.players);
  let kills = 0, deaths = 0, assists = 0;
  if (match.data.playerStats) {
    match.data.playerStats.forEach(ps => {
      if (!teamPlayerUids.has(ps.uid)) return;
      if (ps.rounds) {
        ps.rounds.forEach(r => {
          kills += r.kills || 0;
          deaths += r.deaths || 0;
          assists += r.assists || 0;
        });
      }
    });
  }
  return { kills, deaths, assists };
}

const rounds = [...new Set(matches.map(m => m.data.round))];
---

<Layout title="Matches - CFL Esports ID Tournament Hub" current="Matches">
  <div class="container">
    <div class="page-header">
      <h1>Matches</h1>
      <p>Search, sort, and filter all matches</p>
    </div>

    <div class="matches-toolbar">
      <input type="text" id="searchInput" placeholder="Search tournament or team..." class="matches-search" />
      <select id="statusFilter" class="matches-select">
        <option value="">All Status</option>
        <option value="upcoming">Upcoming</option>
        <option value="completed">Completed</option>
      </select>
      <select id="roundFilter" class="matches-select">
        <option value="">All Rounds</option>
        {rounds.map(r => <option value={r}>{r}</option>)}
      </select>
    </div>

    <div id="sortBar" class="matches-sortbar">
      <span class="sort-label">Sort by:</span>
      <button class="sort-btn active" data-column="default">Default ↓</button>
      <button class="sort-btn" data-column="tournament">Tournament ↓</button>
      <button class="sort-btn" data-column="date">Date ↓</button>
      <button class="sort-btn" data-column="round">Round ↓</button>
      <button class="sort-btn" data-column="status">Status ↓</button>
    </div>

    <div id="matchesGrid" class="matches-grid">
      {matches.map(m => {
        const t1 = teamsMap.get(m.data.team1);
        const t2 = teamsMap.get(m.data.team2);
        const team1Name = t1 ? t1.data.name : m.data.team1;
        const team2Name = t2 ? t2.data.name : m.data.team2;
        const team1Tag = t1 ? t1.data.tag : m.data.team1;
        const team2Tag = t2 ? t2.data.tag : m.data.team2;
        const scoreText = m.data.status === 'completed' ? `${m.data.score1} - ${m.data.score2}` : 'VS';
        const t1Won = m.data.winner === m.data.team1;
        const t2Won = m.data.winner === m.data.team2;
        
        // Use CSS variables instead of inline color styles
        const t1Color = m.data.status === 'completed' ? (t1Won ? 'var(--win)' : 'var(--text-muted)') : 'var(--text-primary)';
        const t2Color = m.data.status === 'completed' ? (t2Won ? 'var(--win)' : 'var(--text-muted)') : 'var(--text-primary)';
        
        const stats1 = getTeamKDA(m, m.data.team1);
        const stats2 = getTeamKDA(m, m.data.team2);
        const searchText = (m.data.tournament + ' ' + team1Name + ' ' + team2Name + ' ' + team1Tag + ' ' + team2Tag).toLowerCase();
        
        return (
          <a href={`/matches/${m.id}`} class="match-card"
            data-search={searchText}
            data-status={m.data.status}
            data-round={m.data.round}
            data-date={m.data.date}
            data-round-order={roundOrder[m.data.round] || 99}
            data-tournament={m.data.tournament}
            style={`--t1-color: ${t1Color}; --t2-color: ${t2Color};`}
          >
            <div class="match-card-header">
              <div class="match-card-tournament">{m.data.tournament}</div>
              <div class="match-card-date">{m.data.date}</div>
              <div class="match-card-round">
                <span class={`badge badge-${m.data.status}`}>{m.data.round}</span>
              </div>
            </div>

            <div class="match-card-score">
              <div class="match-card-team team-a">
                <img 
                  src={t1?.data.logo || `/logos/${team1Tag}.png`} 
                  alt={team1Name} 
                  class="team-logo"
                  onerror="this.onerror=null; this.src='/logos/default.png'"
                />
                <span style={`color: ${t1Color};`}>{team1Name}</span>
              </div>
              <span class="vs">{scoreText}</span>
              <div class="match-card-team team-b">
                <img 
                  src={t2?.data.logo || `/logos/${team2Tag}.png`} 
                  alt={team2Name} 
                  class="team-logo"
                  onerror="this.onerror=null; this.src='/logos/default.png'"
                />
                <span style={`color: ${t2Color};`}>{team2Name}</span>
              </div>
            </div>

            {m.data.status === 'completed' && (stats1.kills > 0 || stats2.kills > 0) && (
              <div class="match-card-kda">
                <div>
                  <span class="match-card-kda-team1">{team1Tag}</span>: 
                  <span class="kda"><span class="kill">{stats1.kills}</span>/<span class="death">{stats1.deaths}</span>/<span class="assist">{stats1.assists}</span></span>
                </div>
                <div>
                  <span class="match-card-kda-team2">{team2Tag}</span>: 
                  <span class="kda"><span class="kill">{stats2.kills}</span>/<span class="death">{stats2.deaths}</span>/<span class="assist">{stats2.assists}</span></span>
                </div>
              </div>
            )}
          </a>
        );
      })}
    </div>

    <p id="noResults" class="no-results">No matches found.</p>
    <div class="pagination" id="pagination"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput');
      const statusFilter = document.getElementById('statusFilter');
      const roundFilter = document.getElementById('roundFilter');
      const grid = document.getElementById('matchesGrid');
      const noResults = document.getElementById('noResults');
      const cards = Array.from(grid.querySelectorAll('.match-card'));
      const sortBtns = document.querySelectorAll('.sort-btn');
      const pagination = document.getElementById('pagination');
      const perPage = 10;
      
      let currentPage = 1;
      let sortColumn = 'default';
      let sortDirection = 'desc';

      function getVisibleCards() {
        const search = searchInput.value.toLowerCase();
        const status = statusFilter.value;
        const round = roundFilter.value;
        return cards.filter(card => {
          const matchesSearch = !search || card.dataset.search.includes(search);
          const matchesStatus = !status || card.dataset.status === status;
          const matchesRound = !round || card.dataset.round === round;
          return matchesSearch && matchesStatus && matchesRound;
        });
      }

      function sortCards(visible) {
        visible.sort((a, b) => {
          let result = 0;
          switch(sortColumn) {
            case 'tournament':
              result = a.dataset.tournament.localeCompare(b.dataset.tournament);
              break;
            case 'date':
              result = new Date(a.dataset.date).getTime() - new Date(b.dataset.date).getTime();
              break;
            case 'round':
              result = parseInt(a.dataset.roundOrder) - parseInt(b.dataset.roundOrder);
              break;
            case 'status':
              const statusOrder = { 'upcoming': 0, 'live': 1, 'completed': 2 };
              result = (statusOrder[a.dataset.status] || 0) - (statusOrder[b.dataset.status] || 0);
              break;
            default:
              const aUpcoming = a.dataset.status === 'upcoming' ? 0 : 1;
              const bUpcoming = b.dataset.status === 'upcoming' ? 0 : 1;
              if (aUpcoming !== bUpcoming) result = aUpcoming - bUpcoming;
              else {
                const dateDiff = new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime();
                if (dateDiff !== 0) result = dateDiff;
                else result = parseInt(b.dataset.roundOrder) - parseInt(a.dataset.roundOrder);
              }
              break;
          }
          return sortDirection === 'desc' ? result : -result;
        });
      }

      function render() {
        const visible = getVisibleCards();
        sortCards(visible);

        cards.forEach(card => { card.style.display = 'none'; grid.appendChild(card); });

        const totalPages = Math.ceil(visible.length / perPage);
        if (currentPage > totalPages) currentPage = 1;

        const start = (currentPage - 1) * perPage;
        const end = start + perPage;
        visible.slice(start, end).forEach(card => { card.style.display = ''; grid.appendChild(card); });

        noResults.style.display = visible.length === 0 ? 'block' : 'none';
        renderPagination(totalPages);
      }

      function renderPagination(totalPages) {
        pagination.innerHTML = '';
        if (totalPages <= 1) return;

        const prev = document.createElement('button');
        prev.className = 'page-btn';
        prev.textContent = '‹';
        prev.disabled = currentPage === 1;
        prev.addEventListener('click', () => { currentPage--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
        pagination.appendChild(prev);

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
          btn.textContent = i;
          btn.addEventListener('click', () => { currentPage = i; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
          pagination.appendChild(btn);
        }

        const next = document.createElement('button');
        next.className = 'page-btn';
        next.textContent = '›';
        next.disabled = currentPage === totalPages;
        next.addEventListener('click', () => { currentPage++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
        pagination.appendChild(next);
      }

      sortBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const col = btn.dataset.column;
          if (sortColumn === col) {
            sortDirection = sortDirection === 'desc' ? 'asc' : 'desc';
          } else {
            sortColumn = col;
            sortDirection = 'desc';
          }
          sortBtns.forEach(b => {
            b.classList.remove('active');
            b.textContent = b.textContent.replace(/ [↑↓]$/, '');
          });
          btn.classList.add('active');
          btn.textContent = btn.textContent.replace(/ [↑↓]$/, '') + ' ' + (sortDirection === 'desc' ? '↓' : '↑');
          render();
        });
      });

      searchInput.addEventListener('input', () => { currentPage = 1; render(); });
      statusFilter.addEventListener('change', () => { currentPage = 1; render(); });
      roundFilter.addEventListener('change', () => { currentPage = 1; render(); });
      render();
    });
  </script>
</Layout>

<style>
  .matches-toolbar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 600px) {
    .matches-toolbar { flex-direction: column; }
    .matches-search { width: 100%; }
  }

  .matches-search, .matches-select {
    padding: 0.6rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 0.9rem;
  }
  .matches-search { flex: 1; min-width: 200px; }
  .matches-select { cursor: pointer; }
  .matches-search:focus, .matches-select:focus { outline: none; border-color: var(--accent); }

  .matches-sortbar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .sort-label { color: var(--text-muted); font-size: 0.85rem; margin-right: 0.25rem; }
  
  .sort-btn {
    padding: 0.4rem 0.85rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
    font-weight: 600;
  }
  .sort-btn:hover { border-color: var(--border-hover); color: var(--text-primary); }
  .sort-btn.active {
    background: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* NEW: 2-Column Grid on Desktop */
  .matches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
  }

  /* NEW: Premium Match Card Styling */
  .match-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }
  .match-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(255, 77, 46, 0.15);
  }

  .match-card-header { text-align: center; margin-bottom: 1rem; }
  .match-card-tournament { font-size: 0.85rem; color: var(--text-secondary); font-weight: 600; }
  .match-card-date { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
  .match-card-round { margin-top: 0.5rem; }

  .match-card-score {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .match-card-team1 { color: var(--t1-color); text-align: right; flex: 1; }
  .match-card-team2 { color: var(--t2-color); text-align: left; flex: 1; }
  .vs { color: var(--text-muted); font-weight: 400; font-size: 0.9rem; }

  .match-card-team {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
  }

  .match-card-team.team-b {
    flex-direction: row-reverse;
    text-align: right;
  }

  .team-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 4px;
    flex-shrink: 0;
    background: transparent;
  }

  .match-card-kda {
    display: flex;
    justify-content: space-around;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .match-card-kda-team1 { color: var(--t1-color); font-weight: 600; margin-right: 0.25rem; }
  .match-card-kda-team2 { color: var(--t2-color); font-weight: 600; margin-right: 0.25rem; }

  .no-results { text-align: center; color: var(--text-muted); display: none; padding: 2rem; }
</style>