---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');
  return matches.map(m => ({
    params: { id: m.id },
    props: { match: m },
  }));
}

const { match } = Astro.props;
const m = match;
const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const playersMap = new Map(allPlayers.map(p => [p.data.uid, p]));

const t1 = teamsMap.get(m.data.team1);
const t2 = teamsMap.get(m.data.team2);
const team1Name = t1 ? t1.data.name : m.data.team1;
const team2Name = t2 ? t2.data.name : m.data.team2;
const team1Tag = t1 ? t1.data.tag : m.data.team1;
const team2Tag = t2 ? t2.data.tag : m.data.team2;
const t1Won = m.data.winner === m.data.team1;
const t2Won = m.data.winner === m.data.team2;
const t1Color = m.data.status === 'completed' ? (t1Won ? '#f59e0b' : '#6b7280') : 'var(--text-primary)';
const t2Color = m.data.status === 'completed' ? (t2Won ? '#f59e0b' : '#6b7280') : 'var(--text-primary)';

// Round details: per-round map name and MVP (by UID)
const roundDetails = m.data.roundDetails || [];
const maps = roundDetails.map(rd => rd.map || '');
const roundMVPuids = roundDetails.map(rd => rd.mvp || null);

// numRounds = max of playerStats rounds and roundDetails length
const numRounds = Math.max(
  ...((m.data.playerStats || []).map(ps => (ps.rounds || []).length)),
  roundDetails.length,
  0
);

// Get player stats with player info (filter out null/missing uids)
const playerStats = (m.data.playerStats || [])
  .filter(ps => ps.uid)
  .map(ps => {
    const player = playersMap.get(ps.uid);
    const team = player ? teamsMap.get(player.data.team) : null;
    const rounds = ps.rounds || [];
    return {
      uid: ps.uid,
      ign: player ? player.data.ign : (ps.ign || ps.uid),
      teamName: team ? team.data.name : '—',
      teamTag: team ? team.data.tag : '—',
      teamId: player ? player.data.team : '',
      rounds,
      totalKills: rounds.reduce((s, r) => s + (r.kills || 0), 0),
      totalDeaths: rounds.reduce((s, r) => s + (r.deaths || 0), 0),
      totalAssists: rounds.reduce((s, r) => s + (r.assists || 0), 0),
    };
  });

// Split by team
const team1Players = playerStats.filter(p => p.teamId === m.data.team1);
const team2Players = playerStats.filter(p => p.teamId === m.data.team2);

// Team totals
const team1Kills = team1Players.reduce((s, p) => s + p.totalKills, 0);
const team1Deaths = team1Players.reduce((s, p) => s + p.totalDeaths, 0);
const team1Assists = team1Players.reduce((s, p) => s + p.totalAssists, 0);
const team2Kills = team2Players.reduce((s, p) => s + p.totalKills, 0);
const team2Deaths = team2Players.reduce((s, p) => s + p.totalDeaths, 0);
const team2Assists = team2Players.reduce((s, p) => s + p.totalAssists, 0);

// ===== MVP =====
function getRoundMVP(roundIdx) {
  const uid = roundMVPuids[roundIdx];
  if (!uid) return null;
  const player = playersMap.get(uid);
  const ps = playerStats.find(p => p.uid === uid);
  const r = ps && ps.rounds[roundIdx] ? ps.rounds[roundIdx] : null;
  return {
    uid,
    ign: player ? player.data.ign : (ps ? ps.ign : uid),
    kills: r ? (r.kills || 0) : 0,
    deaths: r ? (r.deaths || 0) : 0,
    assists: r ? (r.assists || 0) : 0,
  };
}

function kda(k, d, a) {
  return (k + a) / Math.max(d, 1);
}

function calcOverallMVP() {
  let best = null;
  let bestKDA = -1;
  for (const p of playerStats) {
    if (p.totalKills + p.totalAssists === 0) continue;
    const val = kda(p.totalKills, p.totalDeaths, p.totalAssists);
    if (val > bestKDA) {
      bestKDA = val;
      best = { uid: p.uid, ign: p.ign, kills: p.totalKills, deaths: p.totalDeaths, assists: p.totalAssists, kda: val };
    }
  }
  return best;
}

const roundMVPs = numRounds > 0
  ? Array.from({ length: numRounds }, (_, i) => getRoundMVP(i))
  : [];
const overallMVP = calcOverallMVP();
---

<Layout title={`${team1Name} vs ${team2Name} - CFL Esports ID Tournament Hub`} current="Matches">
  <div class="container">
    <div class="page-header">
      <h1>{team1Name} vs {team2Name}</h1>
      <p>{m.data.tournament} · {m.data.round} · {m.data.date}</p>
    </div>
    <a href="/matches" class="back-link">← Back to Matches</a>

    <div class="match-detail-scoreboard">
      <div class="match-detail-team" style={`color: ${t1Color};`}>
        <a href={`/teams/${m.data.team1}`} style={`color: ${t1Color};`}>{team1Name}</a>
        <span style="font-size: 0.85rem; color: var(--text-muted);">[{team1Tag}]</span>
      </div>
      <div class="match-detail-score">
        {m.data.status === 'completed' ? `${m.data.score1} - ${m.data.score2}` : 'VS'}
      </div>
      <div class="match-detail-team" style={`color: ${t2Color};`}>
        <a href={`/teams/${m.data.team2}`} style={`color: ${t2Color};`}>{team2Name}</a>
        <span style="font-size: 0.85rem; color: var(--text-muted);">[{team2Tag}]</span>
      </div>
    </div>

    <div style="text-align: center; margin-bottom: 2rem;">
      <span class={`badge badge-${m.data.status}`}>{m.data.status === 'completed' ? (t1Won ? `${team1Name} wins` : `${team2Name} wins`) : m.data.status}</span>
    </div>

    {m.data.status === 'completed' && playerStats.length > 0 && (
      <>
        {roundDetails.length > 0 && (
          <section style="margin-bottom: 2rem;">
            <h2 style="margin-bottom: 1rem;">Maps &amp; MVP</h2>
            <div class="mvp-grid">
              {Array.from({ length: numRounds }, (_, i) => {
                const mvp = roundMVPs[i];
                const mapName = maps[i] || 'TBD';
                return (
                  <div class="mvp-card">
                    <div class="mvp-round-label">Round {i + 1}</div>
                    <div class="mvp-map-name">{mapName}</div>
                    {mvp ? (
                      <>
                        <div class="mvp-label">Round MVP</div>
                        <div class="mvp-player-name">{mvp.ign}</div>
                        <div class="mvp-kda">
                          <span class="kill">{mvp.kills}</span>/<span class="death">{mvp.deaths}</span>/<span class="assist">{mvp.assists}</span>
                        </div>
                      </>
                    ) : (
                      <div style="font-size: 0.85rem; color: var(--text-muted);">No MVP</div>
                    )}
                  </div>
                );
              })}
            </div>

            {overallMVP && (
              <div class="overall-mvp">
                <div class="overall-mvp-label">Match MVP</div>
                <div class="overall-mvp-name">{overallMVP.ign}</div>
                <div class="overall-mvp-kda">
                  <span class="kill">{overallMVP.kills}</span>/<span class="death">{overallMVP.deaths}</span>/<span class="assist">{overallMVP.assists}</span>
                  <span class="overall-mvp-ratio">KDA {overallMVP.kda.toFixed(2)}</span>
                </div>
              </div>
            )}
          </section>
        )}

        <h2 style="margin-bottom: 1rem;">Team Stats</h2>
        <div class="stat-grid" style="margin-bottom: 2rem;">
          <div class="stat-box">
            <div class="stat-value" style="font-size: 1.25rem;">
              <span class="kda"><span class="kill">{team1Kills}</span>/<span class="death">{team1Deaths}</span>/<span class="assist">{team1Assists}</span></span>
            </div>
            <div class="stat-label">{team1Tag} K/D/A</div>
          </div>
          <div class="stat-box">
            <div class="stat-value" style="font-size: 1.25rem;">
              <span class="kda"><span class="kill">{team2Kills}</span>/<span class="death">{team2Deaths}</span>/<span class="assist">{team2Assists}</span></span>
            </div>
            <div class="stat-label">{team2Tag} K/D/A</div>
          </div>
        </div>

        <h2 style="margin-bottom: 1rem;">Player Stats</h2>

        {team1Players.length > 0 && (
          <div style="margin-bottom: 2rem;">
            <h3 style="margin-bottom: 0.75rem; color: {t1Color};">
              <a href={`/teams/${m.data.team1}`} style={`color: ${t1Color};`}>{team1Name}</a>
              <span style="font-size: 0.85rem; color: var(--text-muted);"> [{team1Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}{maps[i] ? ` — ${maps[i]}` : ''}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team1Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td style="color: var(--text-muted);">—</td>
                      ))}
                      <td class="kda" style="font-weight: 700;"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {team2Players.length > 0 && (
          <div style="margin-bottom: 2rem;">
            <h3 style="margin-bottom: 0.75rem; color: {t2Color};">
              <a href={`/teams/${m.data.team2}`} style={`color: ${t2Color};`}>{team2Name}</a>
              <span style="font-size: 0.85rem; color: var(--text-muted);"> [{team2Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}{maps[i] ? ` — ${maps[i]}` : ''}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team2Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td style="color: var(--text-muted);">—</td>
                      ))}
                      <td class="kda" style="font-weight: 700;"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {numRounds <= 1 && (
          <div class="table-wrap" style="margin-bottom: 2rem;">
            <table>
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Team</th>
                  <th>Kills</th>
                  <th>Deaths</th>
                  <th>Assists</th>
                </tr>
              </thead>
              <tbody>
                {playerStats.map(p => (
                  <tr>
                    <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                    <td style="color: var(--text-muted);">{p.teamTag}</td>
                    <td class="kda"><span class="kill">{p.totalKills}</span></td>
                    <td class="kda"><span class="death">{p.totalDeaths}</span></td>
                    <td class="kda"><span class="assist">{p.totalAssists}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )}

    {m.data.status !== 'completed' && (
      <div style="text-align: center; color: var(--text-muted); padding: 2rem;">
        Match stats will be available after the match is completed.
      </div>
    )}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }
  .match-detail-scoreboard {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 0;
  }
  .match-detail-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .match-detail-score {
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .match-detail-scoreboard {
      flex-direction: column;
      gap: 1rem;
    }
  }
  .mvp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .mvp-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
  }
  .mvp-round-label {
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .mvp-map-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .mvp-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .mvp-player-name {
    font-size: 1rem;
    font-weight: 700;
    color: #facc15;
    margin-bottom: 0.25rem;
  }
  .mvp-kda {
    font-size: 0.85rem;
    color: var(--text-primary);
  }
  .overall-mvp {
    background: linear-gradient(135deg, var(--bg-card), rgba(255, 77, 46, 0.08));
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
  }
  .overall-mvp-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .overall-mvp-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: #facc15;
    margin-bottom: 0.25rem;
  }
  .overall-mvp-kda {
    font-size: 1.1rem;
    color: var(--accent);
    font-weight: 700;
  }
  .overall-mvp-ratio {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.9rem;
    margin-left: 0.5rem;
  }
</style>
