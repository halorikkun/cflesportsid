---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');
  return matches.map(m => ({
    params: { id: m.id },
    props: { match: m },
  }));
}

const { match } = Astro.props;
const m = match;
const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const playersMap = new Map(allPlayers.map(p => [p.data.uid, p]));

const t1 = teamsMap.get(m.data.team1);
const t2 = teamsMap.get(m.data.team2);
const team1Name = t1 ? t1.data.name : m.data.team1;
const team2Name = t2 ? t2.data.name : m.data.team2;
const team1Tag = t1 ? t1.data.tag : m.data.team1;
const team2Tag = t2 ? t2.data.tag : m.data.team2;
const t1Won = m.data.winner === m.data.team1;
const t2Won = m.data.winner === m.data.team2;
const t1Color = m.data.status === 'completed' ? (t1Won ? '#f59e0b' : '#6b7280') : 'var(--text-primary)';
const t2Color = m.data.status === 'completed' ? (t2Won ? '#f59e0b' : '#6b7280') : 'var(--text-primary)';

// Get player stats with player info
const playerStats = (m.data.playerStats || []).map(ps => {
  const player = playersMap.get(ps.uid);
  const team = player ? teamsMap.get(player.data.team) : null;
  return {
    uid: ps.uid,
    ign: player ? player.data.ign : ps.uid,
    teamName: team ? team.data.name : '—',
    teamTag: team ? team.data.tag : '—',
    teamId: player ? player.data.team : '',
    rounds: ps.rounds || [],
    totalKills: (ps.rounds || []).reduce((s, r) => s + (r.kills || 0), 0),
    totalDeaths: (ps.rounds || []).reduce((s, r) => s + (r.deaths || 0), 0),
    totalAssists: (ps.rounds || []).reduce((s, r) => s + (r.assists || 0), 0),
  };
});

// Split by team
const team1Players = playerStats.filter(p => p.teamId === m.data.team1);
const team2Players = playerStats.filter(p => p.teamId === m.data.team2);

// Team totals
const team1Kills = team1Players.reduce((s, p) => s + p.totalKills, 0);
const team1Deaths = team1Players.reduce((s, p) => s + p.totalDeaths, 0);
const team1Assists = team1Players.reduce((s, p) => s + p.totalAssists, 0);
const team2Kills = team2Players.reduce((s, p) => s + p.totalKills, 0);
const team2Deaths = team2Players.reduce((s, p) => s + p.totalDeaths, 0);
const team2Assists = team2Players.reduce((s, p) => s + p.totalAssists, 0);

const numRounds = Math.max(...playerStats.map(p => p.rounds.length), 0);
---

<Layout title={`${team1Name} vs ${team2Name} - CFL Esports ID Tournament Hub`} current="Matches">
  <div class="container">
    <div class="page-header">
      <h1>{team1Name} vs {team2Name}</h1>
      <p>{m.data.tournament} · {m.data.round} · {m.data.date}</p>
    </div>

    <div class="match-detail-scoreboard">
      <div class="match-detail-team" style={`color: ${t1Color};`}>
        <a href={`/teams/${m.data.team1}`} style={`color: ${t1Color};`}>{team1Name}</a>
        <span style="font-size: 0.85rem; color: var(--text-muted);">[{team1Tag}]</span>
      </div>
      <div class="match-detail-score">
        {m.data.status === 'completed' ? `${m.data.score1} - ${m.data.score2}` : 'VS'}
      </div>
      <div class="match-detail-team" style={`color: ${t2Color};`}>
        <a href={`/teams/${m.data.team2}`} style={`color: ${t2Color};`}>{team2Name}</a>
        <span style="font-size: 0.85rem; color: var(--text-muted);">[{team2Tag}]</span>
      </div>
    </div>

    <div style="text-align: center; margin-bottom: 2rem;">
      <span class={`badge badge-${m.data.status}`}>{m.data.status === 'completed' ? (t1Won ? `${team1Name} wins` : `${team2Name} wins`) : m.data.status}</span>
    </div>

    {m.data.status === 'completed' && playerStats.length > 0 && (
      <>
        <h2 style="margin-bottom: 1rem;">Team Stats</h2>
        <div class="stat-grid" style="margin-bottom: 2rem;">
          <div class="stat-box">
            <div class="stat-value" style="font-size: 1.25rem;">
              <span class="kda"><span class="kill">{team1Kills}</span>/<span class="death">{team1Deaths}</span>/<span class="assist">{team1Assists}</span></span>
            </div>
            <div class="stat-label">{team1Tag} K/D/A</div>
          </div>
          <div class="stat-box">
            <div class="stat-value" style="font-size: 1.25rem;">
              <span class="kda"><span class="kill">{team2Kills}</span>/<span class="death">{team2Deaths}</span>/<span class="assist">{team2Assists}</span></span>
            </div>
            <div class="stat-label">{team2Tag} K/D/A</div>
          </div>
        </div>

                <h2 style="margin-bottom: 1rem;">Player Stats</h2>

        {/* Team 1 players */}
        {team1Players.length > 0 && (
          <div style="margin-bottom: 2rem;">
            <h3 style="margin-bottom: 0.75rem; color: {t1Color};">
              <a href={`/teams/${m.data.team1}`} style={`color: ${t1Color};`}>{team1Name}</a>
              <span style="font-size: 0.85rem; color: var(--text-muted);"> [{team1Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team1Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td style="color: var(--text-muted);">—</td>
                      ))}
                      <td class="kda" style="font-weight: 700;"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* Team 2 players */}
        {team2Players.length > 0 && (
          <div style="margin-bottom: 2rem;">
            <h3 style="margin-bottom: 0.75rem; color: {t2Color};">
              <a href={`/teams/${m.data.team2}`} style={`color: ${t2Color};`}>{team2Name}</a>
              <span style="font-size: 0.85rem; color: var(--text-muted);"> [{team2Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team2Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td style="color: var(--text-muted);">—</td>
                      ))}
                      <td class="kda" style="font-weight: 700;"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}


        {numRounds <= 1 && (
          <div class="table-wrap" style="margin-bottom: 2rem;">
            <table>
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Team</th>
                  <th>Kills</th>
                  <th>Deaths</th>
                  <th>Assists</th>
                </tr>
              </thead>
              <tbody>
                {playerStats.map(p => (
                  <tr>
                    <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                    <td style="color: var(--text-muted);">{p.teamTag}</td>
                    <td class="kda"><span class="kill">{p.totalKills}</span></td>
                    <td class="kda"><span class="death">{p.totalDeaths}</span></td>
                    <td class="kda"><span class="assist">{p.totalAssists}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )}

    {m.data.status !== 'completed' && (
      <div style="text-align: center; color: var(--text-muted); padding: 2rem;">
        Match stats will be available after the match is completed.
      </div>
    )}
  </div>
</Layout>

<style>
  .match-detail-scoreboard {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 0;
  }
  .match-detail-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .match-detail-score {
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .match-detail-scoreboard {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
