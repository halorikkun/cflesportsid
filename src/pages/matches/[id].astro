---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

import {
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchWinnerId,
  getMatchTournamentId,
  getRoundMapId,
} from '../../utils/content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');
  return matches.map(m => ({
    params: { id: m.id },
    props: { match: m },
  }));
}

const { match } = Astro.props;
const m = match;

const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const allTournaments = await getCollection('tournaments');
const allMaps = await getCollection('maps');

const teamsMap = new Map(
  allTeams.map((team) => [team.id, team])
);

const playersMap = new Map(
  allPlayers.map((player) => [player.data.uid, player])
);

const tournamentsMap = new Map(
  allTournaments.map((tournament) => [tournament.id, tournament])
);

const mapsMap = new Map(
  allMaps.map((map) => [map.id, map])
);

const team1Id = getMatchTeam1Id(m);
const team2Id = getMatchTeam2Id(m);
const winnerId = getMatchWinnerId(m);
const tournamentId = getMatchTournamentId(m);

const t1 = team1Id ? teamsMap.get(team1Id) : undefined;
const t2 = team2Id ? teamsMap.get(team2Id) : undefined;

const tournament = tournamentId
  ? tournamentsMap.get(tournamentId)
  : undefined;

const team1Name = t1?.data.name ?? team1Id ?? 'TBD';
const team2Name = t2?.data.name ?? team2Id ?? 'TBD';

const team1Tag = t1?.data.tag ?? team1Id ?? 'TBD';
const team2Tag = t2?.data.tag ?? team2Id ?? 'TBD';

const t1Won = Boolean(winnerId && winnerId === team1Id);
const t2Won = Boolean(winnerId && winnerId === team2Id);

const t1Color = m.data.status === 'completed' ? (t1Won ? 'var(--win)' : 'var(--text-muted)') : 'var(--text-primary)';
const t2Color = m.data.status === 'completed' ? (t2Won ? 'var(--win)' : 'var(--text-muted)') : 'var(--text-primary)';

const roundDetails = m.data.roundDetails || [];
const roundMapNames = roundDetails.map((rd) => {
  const mapId = getRoundMapId(rd);
  return mapsMap.get(mapId)?.data.name ?? 'TBD';
});
const roundMVPuids = roundDetails.map(rd => rd.mvp || null);

const numRounds = Math.max(
  ...((m.data.playerStats || []).map(ps => (ps.rounds || []).length)),
  roundDetails.length,
  0
);

const playerStats = (m.data.playerStats || [])
  .filter(ps => ps.uid)
  .map(ps => {
    const player = playersMap.get(ps.uid);
    const team = ps.teamId ? teamsMap.get(ps.teamId) : undefined;
    const rounds = ps.rounds || [];
    return {
      uid: ps.uid,
      ign: player ? player.data.ign : (ps.ign || ps.uid),
      teamName: team ? team.data.name : '—',
      teamTag: team ? team.data.tag : '—',
      teamId: ps.teamId,
      rounds,
      totalKills: rounds.reduce((s, r) => s + (r.kills || 0), 0),
      totalDeaths: rounds.reduce((s, r) => s + (r.deaths || 0), 0),
      totalAssists: rounds.reduce((s, r) => s + (r.assists || 0), 0),
    };
  });

const team1Players = playerStats.filter(p => p.teamId === team1Id);
const team2Players = playerStats.filter(p => p.teamId === team2Id);

const team1Kills = team1Players.reduce((s, p) => s + p.totalKills, 0);
const team1Deaths = team1Players.reduce((s, p) => s + p.totalDeaths, 0);
const team1Assists = team1Players.reduce((s, p) => s + p.totalAssists, 0);
const team2Kills = team2Players.reduce((s, p) => s + p.totalKills, 0);
const team2Deaths = team2Players.reduce((s, p) => s + p.totalDeaths, 0);
const team2Assists = team2Players.reduce((s, p) => s + p.totalAssists, 0);

function getRoundMVP(roundIdx) {
  const uid = roundMVPuids[roundIdx];
  if (!uid) return null;
  const player = playersMap.get(uid);
  const ps = playerStats.find(p => p.uid === uid);
  const r = ps && ps.rounds[roundIdx] ? ps.rounds[roundIdx] : null;
  return {
    uid,
    ign: player ? player.data.ign : (ps ? ps.ign : uid),
    kills: r ? (r.kills || 0) : 0,
    deaths: r ? (r.deaths || 0) : 0,
    assists: r ? (r.assists || 0) : 0,
  };
}

function kda(k, d, a) { return (k + a) / Math.max(d, 1); }

function calcOverallMVP() {
  let best = null;
  let bestKDA = -1;
  for (const p of playerStats) {
    if (p.totalKills + p.totalAssists === 0) continue;
    const val = kda(p.totalKills, p.totalDeaths, p.totalAssists);
    if (val > bestKDA) {
      bestKDA = val;
      best = { uid: p.uid, ign: p.ign, kills: p.totalKills, deaths: p.totalDeaths, assists: p.totalAssists, kda: val };
    }
  }
  return best;
}

const roundMVPs = numRounds > 0 ? Array.from({ length: numRounds }, (_, i) => getRoundMVP(i)) : [];
const overallMVP = calcOverallMVP();
---

<Layout title={`${team1Name} vs ${team2Name} - CFL Esports ID Tournament Hub`} current="Matches">
  <div class="container">
    <div class="page-header">
      <h1>{team1Name} vs {team2Name}</h1>
      <p>{tournament?.data.name ?? tournamentId ?? 'TBD'} · {m.data.round} · {m.data.date}</p>
    </div>
    <a href="/matches" class="back-link">← Back to Matches</a>

    <div class="match-detail-scoreboard">
      <div class="match-detail-team">
        <img 
          src={t1?.data.logo || `/logos/${team1Tag}.png`} 
          alt={team1Name} 
          class="team-logo-large"
          onerror="this.onerror=null; this.src='/logos/default.png'"
        />
        <a href={`/teams/${team1Id}`} style={`color: ${t1Color};`}>{team1Name}</a>
        <span class="tag">[{team1Tag}]</span>
      </div>
      <div class="match-detail-score">
        {m.data.status === 'completed' ? `${m.data.score1} - ${m.data.score2}` : 'VS'}
      </div>
      <div class="match-detail-team">
        <img 
          src={t2?.data.logo || `/logos/${team2Tag}.png`} 
          alt={team2Name} 
          class="team-logo-large"
          onerror="this.onerror=null; this.src='/logos/default.png'"
        />
        <a href={`/teams/${team2Id}`} style={`color: ${t2Color};`}>{team2Name}</a>
        <span class="tag">[{team2Tag}]</span>
      </div>
    </div>

    <div class="match-status-center">
      <span class={`badge badge-${m.data.status}`}>
        {m.data.status === 'completed' ? (t1Won ? `${team1Name} wins` : t2Won ? `${team2Name} wins` : 'Completed') : m.data.status}
      </span>
    </div>

    {m.data.status === 'completed' && playerStats.length > 0 && (
      <>
        {roundDetails.length > 0 && (
          <section class="section-spacing">
            <h2 class="section-title">Maps & MVP</h2>
            <div class="mvp-grid">
              {Array.from({ length: numRounds }, (_, i) => {
                const mvp = roundMVPs[i];
                const mapName = roundMapNames[i] || 'TBD';
                return (
                  <div class="mvp-card">
                    <div class="mvp-round-label">Round {i + 1}</div>
                    <div class="mvp-map-name">{mapName}</div>
                    {mvp ? (
                      <>
                        <div class="mvp-label">Round MVP</div>
                        <div class="mvp-player-name">{mvp.ign}</div>
                        <div class="mvp-kda">
                          <span class="kill">{mvp.kills}</span>/<span class="death">{mvp.deaths}</span>/<span class="assist">{mvp.assists}</span>
                        </div>
                      </>
                    ) : (
                      <div class="mvp-none">No MVP</div>
                    )}
                  </div>
                );
              })}
            </div>

            {overallMVP && (
              <div class="overall-mvp">
                <div class="overall-mvp-label">Match MVP</div>
                <div class="overall-mvp-name">{overallMVP.ign}</div>
                <div class="overall-mvp-kda">
                  <span class="kill">{overallMVP.kills}</span>/<span class="death">{overallMVP.deaths}</span>/<span class="assist">{overallMVP.assists}</span>
                  <span class="overall-mvp-ratio">KDA {overallMVP.kda.toFixed(2)}</span>
                </div>
              </div>
            )}
          </section>
        )}

        <h2 class="section-title">Team Stats</h2>
        <!-- NEW: Added 'team-stats-grid' class to center the 2 boxes -->
        <div class="stat-grid section-spacing team-stats-grid">
          <div class="stat-box">
            <div class="stat-value stat-value-small">
              <span class="kda"><span class="kill">{team1Kills}</span>/<span class="death">{team1Deaths}</span>/<span class="assist">{team1Assists}</span></span>
            </div>
            <div class="stat-label">{team1Tag} K/D/A</div>
          </div>
          <div class="stat-box">
            <div class="stat-value stat-value-small">
              <span class="kda"><span class="kill">{team2Kills}</span>/<span class="death">{team2Deaths}</span>/<span class="assist">{team2Assists}</span></span>
            </div>
            <div class="stat-label">{team2Tag} K/D/A</div>
          </div>
        </div>

        <h2 class="section-title">Player Stats</h2>

        {team1Players.length > 0 && (
          <div class="section-spacing" style={`--team-color: ${t1Color};`}>
            <h3 class="team-header">
              <a href={`/teams/${team1Id}`}>{team1Name}</a>
              <span class="tag"> [{team1Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table class="match-stats-table">
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}{roundMapNames[i] ? ` — ${roundMapNames[i]}` : ''}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team1Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td class="text-muted">—</td>
                      ))}
                      <td class="kda total-kda"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {team2Players.length > 0 && (
          <div class="section-spacing" style={`--team-color: ${t2Color};`}>
            <h3 class="team-header">
              <a href={`/teams/${team2Id}`}>{team2Name}</a>
              <span class="tag"> [{team2Tag}]</span>
            </h3>
            <div class="table-wrap">
              <table class="match-stats-table">
                <thead>
                  <tr>
                    <th>Player</th>
                    {numRounds > 1 && Array.from({ length: numRounds }, (_, i) => (
                      <th>Round {i + 1}{roundMapNames[i] ? ` — ${roundMapNames[i]}` : ''}</th>
                    ))}
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {team2Players.map(p => (
                    <tr>
                      <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                      {numRounds > 1 && p.rounds.map(r => (
                        <td class="kda"><span class="kill">{r.kills || 0}</span>/<span class="death">{r.deaths || 0}</span>/<span class="assist">{r.assists || 0}</span></td>
                      ))}
                      {numRounds > 1 && Array.from({ length: numRounds - p.rounds.length }, () => (
                        <td class="text-muted">—</td>
                      ))}
                      <td class="kda total-kda"><span class="kill">{p.totalKills}</span>/<span class="death">{p.totalDeaths}</span>/<span class="assist">{p.totalAssists}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {numRounds <= 1 && (
          <div class="table-wrap section-spacing">
            <table class="match-stats-table">
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Team</th>
                  <th>Kills</th>
                  <th>Deaths</th>
                  <th>Assists</th>
                </tr>
              </thead>
              <tbody>
                {playerStats.map(p => (
                  <tr>
                    <td><a href={`/players/${playersMap.get(p.uid)?.id || ''}`}><strong>{p.ign}</strong></a></td>
                    <td class="text-muted">{p.teamTag}</td>
                    <td class="kda"><span class="kill">{p.totalKills}</span></td>
                    <td class="kda"><span class="death">{p.totalDeaths}</span></td>
                    <td class="kda"><span class="assist">{p.totalAssists}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )}

    {m.data.status !== 'completed' && (
      <div class="empty-state">
        Match stats will be available after the match is completed.
      </div>
    )}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .section-spacing { margin-bottom: 2.5rem; }
  .text-muted { color: var(--text-muted); }
  .empty-state { text-align: center; color: var(--text-muted); padding: 3rem 1rem; font-size: 1.1rem; }

  .match-detail-scoreboard {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2.5rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }
  .match-detail-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .match-detail-team a {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--team-color, var(--text-primary));
    text-decoration: none;
    text-align: center;
    word-break: break-word;
    transition: opacity 0.2s;
  }
  .match-detail-team a:hover { opacity: 0.8; }
  .match-detail-team .tag { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }
  
  .match-detail-score {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent);
    padding: 0 1.5rem;
    border-left: 2px solid var(--border);
    border-right: 2px solid var(--border);
  }

  .match-status-center { text-align: center; margin-bottom: 2.5rem; }

  @media (max-width: 640px) {
    .match-detail-scoreboard { flex-direction: column; gap: 1rem; padding: 1.5rem; }
    .match-detail-score {
      border: none;
      border-top: 2px solid var(--border);
      border-bottom: 2px solid var(--border);
      padding: 0.75rem 0;
      width: 100%;
      text-align: center;
      font-size: 2rem;
    }
    .match-detail-team { width: 100%; }
  }

  .mvp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .mvp-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-align: center;
  }
  .mvp-round-label { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; font-weight: 600; }
  .mvp-map-name { font-size: 1.05rem; font-weight: 800; color: var(--accent); margin-bottom: 0.75rem; }
  .mvp-label { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.25rem; font-weight: 600; }
  .mvp-player-name { font-size: 1rem; font-weight: 700; color: #facc15; margin-bottom: 0.25rem; }
  .mvp-kda { font-size: 0.85rem; color: var(--text-primary); font-family: monospace; }
  .mvp-none { font-size: 0.85rem; color: var(--text-muted); font-style: italic; margin-top: 1rem; }

  .overall-mvp {
    background: linear-gradient(135deg, var(--bg-card), rgba(255, 77, 46, 0.08));
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }
  .overall-mvp-label { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; font-weight: 700; }
  .overall-mvp-name { font-size: 1.6rem; font-weight: 800; color: #facc15; margin-bottom: 0.25rem; }
  .overall-mvp-kda { font-size: 1.1rem; color: var(--accent); font-weight: 700; font-family: monospace; }
  .overall-mvp-ratio { color: var(--text-muted); font-weight: 400; font-size: 0.9rem; margin-left: 0.5rem; }

  .stat-value-small { font-size: 1.5rem !important; }

  /* NEW: Center the 2-column team stats grid on desktop */
  .team-stats-grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: 600px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .team-header {
    margin-bottom: 1rem;
    font-size: 1.15rem;
  }
  .team-header a { color: var(--team-color, var(--accent)); text-decoration: none; font-weight: 700; }
  .team-header a:hover { text-decoration: underline; }
  .team-header .tag { color: var(--text-muted); font-weight: 600; }

  .match-stats-table th:first-child,
  .match-stats-table td:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg-card);
    border-right: 1px solid var(--border);
    min-width: 120px;
  }
  .match-stats-table th:first-child {
    background: rgba(255, 77, 46, 0.08);
    z-index: 3;
  }
  .match-stats-table tbody tr:nth-child(even) td:first-child {
    background: rgba(255, 255, 255, 0.02);
  }
  .match-stats-table tbody tr:hover td:first-child {
    background: var(--bg-card-hover);
  }
  
  .total-kda { font-weight: 700; font-size: 0.95rem; }

  @media (max-width: 640px) {
    .team-logo-large {
      width: 48px;
      height: 48px;
    }
  }

  @media (max-width: 600px) {
    /* Stack the team stats on very small screens */
    .team-stats-grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
  }
</style>