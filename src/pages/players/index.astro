---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTeams = await getCollection('teams');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const allMatches = await getCollection('matches');

function getMatchesPlayed(uid) {
  return allMatches.filter(m =>
    m.data.playerStats && m.data.playerStats.some(ps => ps.uid === uid)
  ).length;
}

const players = (await getCollection('players')).map(p => {
  const team = p.data.team ? teamsMap.get(p.data.team) : undefined;
  const kd = (p.data.stats.kills / Math.max(p.data.stats.deaths, 1)).toFixed(2);
  const matchesPlayed = getMatchesPlayed(p.data.uid || p.id);
  return {
    id: p.id,
    ign: p.data.ign,
    teamName: team ? team.data.name : '—',
    teamId: team ? team.id : '',
    kills: p.data.stats.kills,
    deaths: p.data.stats.deaths,
    assists: p.data.stats.assists,
    kd: parseFloat(kd),
    kdDisplay: kd,
    matches: matchesPlayed,
  };
});

// Unique team names for filter dropdown
const teamNames = [...new Set(players.map(p => p.teamName).filter(t => t !== '—'))].sort();
---

<Layout title="Players - CFL Esports ID Tournament Hub" current="Players">
  <div class="container">
    <div class="page-header">
      <h1>Players</h1>
      <p>Search, sort, and filter all players</p>
    </div>

    <div class="players-toolbar">
      <input type="text" id="searchInput" placeholder="Search player or team..." class="players-search" />
      <select id="teamFilter" class="players-filter">
        <option value="">All Teams</option>
        {teamNames.map(name => (
          <option value={name.toLowerCase()}>{name}</option>
        ))}
      </select>
      <select id="sortSelect" class="players-sort">
        <option value="kills-desc">Kills (High–Low)</option>
        <option value="kills-asc">Kills (Low–High)</option>
        <option value="deaths-desc">Deaths (High–Low)</option>
        <option value="deaths-asc">Deaths (Low–High)</option>
        <option value="assists-desc">Assists (High–Low)</option>
        <option value="assists-asc">Assists (Low–High)</option>
        <option value="kd-desc">KDA Ratio (High–Low)</option>
        <option value="kd-asc">KDA Ratio (Low–High)</option>
        <option value="matches-desc">Matches (High–Low)</option>
        <option value="matches-asc">Matches (Low–High)</option>
        <option value="ign-asc">Name (A–Z)</option>
        <option value="ign-desc">Name (Z–A)</option>
      </select>
    </div>

    <div class="table-wrap">
      <table id="playersTable">
        <thead>
          <tr>
            <th>Player</th>
            <th>Team</th>
            <th>Kills</th>
            <th>Deaths</th>
            <th>Assists</th>
            <th>KDA Ratio</th>
            <th>Matches</th>
          </tr>
        </thead>
        <tbody id="playersBody">
          {players.map(p => (
            <tr data-ign={p.ign.toLowerCase()} data-team={p.teamName.toLowerCase()}
                data-kills={p.kills} data-deaths={p.deaths} data-assists={p.assists}
                data-kd={p.kd} data-matches={p.matches}>
              <td><a href={`/players/${p.id}`}><strong>{p.ign}</strong></a></td>
              <td>{p.teamId ? <a href={`/teams/${p.teamId}`}>{p.teamName}</a> : '—'}</td>
              <td class="kda"><span class="kill">{p.kills}</span></td>
              <td class="kda"><span class="death">{p.deaths}</span></td>
              <td class="kda"><span class="assist">{p.assists}</span></td>
              <td class={p.kd >= 1 ? 'kd-positive' : 'kd-negative'}>{p.kdDisplay}</td>
              <td>{p.matches}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="noResults" style="text-align: center; color: var(--text-muted); display: none; padding: 2rem;">No players found.</p>
  </div>

  <script>
    const searchInput = document.getElementById('searchInput');
    const teamFilter = document.getElementById('teamFilter');
    const sortSelect = document.getElementById('sortSelect');
    const tbody = document.getElementById('playersBody');
    const noResults = document.getElementById('noResults');
    const rows = Array.from(tbody.querySelectorAll('tr'));

    function applyFilters() {
      const search = searchInput.value.toLowerCase();
      const team = teamFilter.value;
      const sortValue = sortSelect.value;
      const [key, dir] = sortValue.split('-');
      const isNumeric = ['kills', 'deaths', 'assists', 'kd', 'matches'].includes(key);
      const asc = dir === 'asc';

      // Sort
      rows.sort((a, b) => {
        let valA, valB;
        if (isNumeric) {
          valA = parseFloat(a.dataset[key]);
          valB = parseFloat(b.dataset[key]);
          return asc ? valA - valB : valB - valA;
        } else {
          valA = a.dataset[key];
          valB = b.dataset[key];
          return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
      });

      // Filter + re-append
      let visible = 0;
      rows.forEach(row => {
        const matchesSearch = !search || row.dataset.ign.includes(search) || row.dataset.team.includes(search);
        const matchesTeam = !team || row.dataset.team === team;
        const show = matchesSearch && matchesTeam;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
        tbody.appendChild(row);
      });

      noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', applyFilters);
    teamFilter.addEventListener('change', applyFilters);
    sortSelect.addEventListener('change', applyFilters);
    applyFilters();
  </script>
</Layout>

<style>
  .players-toolbar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .players-search {
    flex: 1;
    min-width: 200px;
    padding: 0.5rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 0.9rem;
  }
  .players-filter, .players-sort {
    padding: 0.5rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .players-search:focus, .players-filter:focus, .players-sort:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>
