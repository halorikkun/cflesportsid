---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const players = await getCollection('players');
  return players.map(player => ({
    params: { id: player.id },
    props: { player },
  }));
}

const { player } = Astro.props;
const allTeams = await getCollection('teams');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const team = player.data.team ? teamsMap.get(player.data.team) : undefined;
const allMatches = await getCollection('matches');

const playerMatches = allMatches.filter(m => 
  m.data.playerStats && m.data.playerStats.some(ps => ps.uid === player.data.uid)
);

const matchesPlayed = playerMatches.length;
const kd = (player.data.stats.kills / Math.max(player.data.stats.deaths, 1)).toFixed(2);
const kdClass = parseFloat(kd) >= 1 ? 'kd-positive' : 'kd-negative';
const hasSocials = Object.values(player.data.socials).some(v => v);

// Calculate MVP count from roundDetails across all matches this player participated in
let mvpCount = 0;
const mvpMatches = [];
playerMatches.forEach(m => {
  const roundDetails = m.data.roundDetails || [];
  const mvpsThisMatch = roundDetails.filter(rd => rd.mvp === player.data.uid);
  if (mvpsThisMatch.length > 0) {
    mvpCount += mvpsThisMatch.length;
    mvpMatches.push({
      match: m,
      mvpRounds: mvpsThisMatch.map(rd => rd.round_number),
      maps: mvpsThisMatch.map(rd => rd.map),
    });
  }
});
---

<Layout title={`${player.data.ign} - CFL Tournament Hub`} current="Players">
  <div class="container">
    <div style="display: flex; align-items: center; gap: 1.5rem; margin: 3rem 0 2rem;">
      <div class="avatar" style="width: 80px; height: 80px; font-size: 2rem;">
        {player.data.ign.charAt(0).toUpperCase()}
      </div>
      <div>
        <h1>{player.data.ign}</h1>
        <p style="color: var(--text-secondary);">
          {player.data.name}
          {team && <span> · <a href={`/teams/${team.id}`}>{team.data.name}</a></span>}
          {player.data.country && <span> · {player.data.country}</span>}
        </p>
      </div>
      {mvpCount > 0 && (
        <div style="margin-left: auto; text-align: center;">
          <div style="font-size: 2rem; font-weight: 800; color: #facc15;">{mvpCount}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">
            {mvpCount === 1 ? 'MVP Award' : 'MVP Awards'}
          </div>
        </div>
      )}
    </div>
    <a href="/players" class="back-link">← Back to Players</a>

    {player.data.bio && (
      <p style="color: var(--text-secondary); max-width: 600px; margin-bottom: 2rem;">{player.data.bio}</p>
    )}

    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-box stat-kills">
        <div class="stat-value">{player.data.stats.kills}</div>
        <div class="stat-label">Kills</div>
      </div>
      <div class="stat-box stat-deaths">
        <div class="stat-value">{player.data.stats.deaths}</div>
        <div class="stat-label">Deaths</div>
      </div>
      <div class="stat-box stat-assists">
        <div class="stat-value">{player.data.stats.assists}</div>
        <div class="stat-label">Assists</div>
      </div>
      <div class="stat-box stat-kd">
        <div class="stat-value" class={kdClass}>{kd}</div>
        <div class="stat-label">K/D Ratio</div>
      </div>
      <div class="stat-box stat-matches">
        <div class="stat-value">{matchesPlayed}</div>
        <div class="stat-label">Matches</div>
      </div>
      <div class="stat-box stat-mvp">
        <div class="stat-value">{mvpCount}</div>
        <div class="stat-label">MVP Awards</div>
      </div>
    </div>

    {hasSocials && (
      <div style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 0.75rem;">Socials</h3>
        <div style="display: flex; gap: 1rem;">
          {player.data.socials.discord && (
            <span class="badge" style="background: #5865F2; color: white;">Discord: {player.data.socials.discord}</span>
          )}
          {player.data.socials.youtube && (
            <a href={`https://youtube.com/${player.data.socials.youtube}`} class="badge" style="background: #FF0000; color: white;">YouTube</a>
          )}
          {player.data.socials.twitch && (
            <a href={`https://twitch.tv/${player.data.socials.twitch}`} class="badge" style="background: #9146FF; color: white;">Twitch</a>
          )}
        </div>
      </div>
    )}

    {mvpMatches.length > 0 && (
      <div style="margin-bottom: 2rem;">
        <h2 style="margin-bottom: 1rem;">MVP Awards</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>MVP Rounds</th>
              </tr>
            </thead>
            <tbody>
              {mvpMatches.map(({ match: m, mvpRounds, maps }) => {
                const t1 = teamsMap.get(m.data.team1);
                const t2 = teamsMap.get(m.data.team2);
                const matchName = (t1 ? t1.data.name : m.data.team1) + ' vs ' + (t2 ? t2.data.name : m.data.team2);
                return (
                  <tr>
                    <td style="color: var(--text-muted);">{m.data.date}</td>
                    <td>{m.data.tournament}</td>
                    <td>{m.data.round}</td>
                    <td><a href={`/matches/${m.id}`}>{matchName}</a></td>
                    <td>
                      {mvpRounds.map((rn, i) => (
                        <span class="badge badge-completed" style="margin-right: 0.4rem;">
                          R{rn} — {maps[i] || ''}
                        </span>
                      ))}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {playerMatches.length > 0 && (
      <div>
        <h2 style="margin-bottom: 1rem;">Recent Matches</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>K/D/A</th>
              </tr>
            </thead>
            <tbody>
              {playerMatches.slice(0, 10).map(m => {
                const t1 = teamsMap.get(m.data.team1);
                const t2 = teamsMap.get(m.data.team2);
                const matchName = (t1 ? t1.data.name : m.data.team1) + ' vs ' + (t2 ? t2.data.name : m.data.team2);
                const ps = m.data.playerStats.find(ps => ps.uid === player.data.uid);
                let pKills = 0, pDeaths = 0, pAssists = 0;
                if (ps && ps.rounds) {
                  ps.rounds.forEach(r => {
                    pKills += r.kills;
                    pDeaths += r.deaths;
                    pAssists += r.assists;
                  });
                }
                const wonMVP = (m.data.roundDetails || []).some(rd => rd.mvp === player.data.uid);
                return (
                  <tr>
                    <td style="color: var(--text-muted);">{m.data.date}</td>
                    <td>{m.data.tournament}</td>
                    <td>{m.data.round}</td>
                    <td><a href={`/matches/${m.id}`}>{matchName}</a></td>
                    <td>
                      <span class="kda"><span class="kill">{pKills}</span>/<span class="death">{pDeaths}</span>/<span class="assist">{pAssists}</span></span>
                      {wonMVP && <span class="badge badge-completed" style="margin-left: 0.5rem;">MVP</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }
  .stat-kills {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.3);
  }
  .stat-kills .stat-value { color: #4ade80; }
  .stat-deaths {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.3);
  }
  .stat-deaths .stat-value { color: #f87171; }
  .stat-assists {
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.3);
  }
  .stat-assists .stat-value { color: #c084fc; }
  .stat-kd {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .stat-kd .stat-value { color: #fbbf24; }
  .stat-matches {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .stat-matches .stat-value { color: #60a5fa; }
  .stat-mvp {
    background: rgba(250, 204, 21, 0.12);
    border-color: rgba(250, 204, 21, 0.3);
  }
  .stat-mvp .stat-value { color: #facc15; }
</style>
