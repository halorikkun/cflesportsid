---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const players = await getCollection('players');
  return players.map(player => ({
    params: { id: player.id },
    props: { player },
  }));
}

const { player } = Astro.props;
const allTeams = await getCollection('teams');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const team = player.data.team ? teamsMap.get(player.data.team) : undefined;
const allMatches = await getCollection('matches');

const playerMatches = allMatches.filter(m => 
  m.data.playerStats && m.data.playerStats.some(ps => ps.uid === player.data.uid)
);

const matchesPlayed = playerMatches.length;
const kd = ((player.data.stats?.kills || 0) / Math.max(player.data.stats?.deaths || 1, 1)).toFixed(2);
const kdClass = parseFloat(kd) >= 1 ? 'kd-positive' : 'kd-negative';
const hasSocials = player.data.socials && Object.values(player.data.socials).some(v => v);

let mvpCount = 0;
const mvpMatches = [];
playerMatches.forEach(m => {
  const roundDetails = m.data.roundDetails || [];
  const mvpsThisMatch = roundDetails.filter(rd => rd.mvp === player.data.uid);
  if (mvpsThisMatch.length > 0) {
    mvpCount += mvpsThisMatch.length;
    mvpMatches.push({
      match: m,
      mvpRounds: mvpsThisMatch.map(rd => rd.round_number),
      maps: mvpsThisMatch.map(rd => rd.map),
    });
  }
});

const initial = player.data.ign.charAt(0).toUpperCase();
---

<Layout title={`${player.data.ign} - CFL Tournament Hub`} current="Players">
  <div class="container">
    
    <!-- NEW: Premium Detail Hero -->
    <div class="detail-hero">
      <div class="avatar avatar-large">{initial}</div>
      <div class="detail-hero-info">
        <h1>{player.data.ign}</h1>
        <p class="hero-subtitle">
          {player.data.name}
          {team && <span> · <a href={`/teams/${team.id}`}>{team.data.name}</a></span>}
          {player.data.country && <span> · {player.data.country}</span>}
        </p>
      </div>
      
      {mvpCount > 0 && (
        <div class="hero-mvp">
          <div class="mvp-value">{mvpCount}</div>
          <div class="mvp-label">{mvpCount === 1 ? 'MVP Award' : 'MVP Awards'}</div>
        </div>
      )}
    </div>

    <a href="/players" class="back-link">← Back to Players</a>

    {player.data.bio && (
      <p class="player-description">{player.data.bio}</p>
    )}

    <h2 class="section-title">Career Statistics</h2>
    <div class="stat-grid section-spacing">
      <div class="stat-box stat-kills">
        <div class="stat-value">{player.data.stats?.kills || 0}</div>
        <div class="stat-label">Kills</div>
      </div>
      <div class="stat-box stat-deaths">
        <div class="stat-value">{player.data.stats?.deaths || 0}</div>
        <div class="stat-label">Deaths</div>
      </div>
      <div class="stat-box stat-assists">
        <div class="stat-value">{player.data.stats?.assists || 0}</div>
        <div class="stat-label">Assists</div>
      </div>
      <div class="stat-box stat-kd">
        <div class={kdClass}>{kd}</div>
        <div class="stat-label">K/D Ratio</div>
      </div>
      <div class="stat-box stat-matches">
        <div class="stat-value">{matchesPlayed}</div>
        <div class="stat-label">Matches</div>
      </div>
      <div class="stat-box stat-mvp">
        <div class="stat-value">{mvpCount}</div>
        <div class="stat-label">MVP Awards</div>
      </div>
    </div>

    {hasSocials && (
      <div class="section-spacing">
        <h3 class="section-title">Socials</h3>
        <div class="socials-list">
          {player.data.socials?.discord && (
            <span class="badge badge-discord">Discord: {player.data.socials.discord}</span>
          )}
          {player.data.socials?.youtube && (
            <a href={`https://youtube.com/${player.data.socials.youtube}`} target="_blank" rel="noopener noreferrer" class="badge badge-youtube">YouTube</a>
          )}
          {player.data.socials?.twitch && (
            <a href={`https://twitch.tv/${player.data.socials.twitch}`} target="_blank" rel="noopener noreferrer" class="badge badge-twitch">Twitch</a>
          )}
        </div>
      </div>
    )}

    {mvpMatches.length > 0 && (
      <div class="section-spacing">
        <h2 class="section-title">MVP Awards</h2>
        <div class="table-wrap">
          <table class="match-history-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>MVP Rounds</th>
              </tr>
            </thead>
            <tbody>
              {mvpMatches.map(({ match: m, mvpRounds, maps }) => {
                const t1 = teamsMap.get(m.data.team1);
                const t2 = teamsMap.get(m.data.team2);
                const matchName = (t1 ? t1.data.name : m.data.team1) + ' vs ' + (t2 ? t2.data.name : m.data.team2);
                return (
                  <tr>
                    <td>{m.data.date}</td>
                    <td>{m.data.tournament}</td>
                    <td>{m.data.round}</td>
                    <td><a href={`/matches/${m.id}`} class="match-link">{matchName}</a></td>
                    <td>
                      <div class="mvp-rounds">
                        {mvpRounds.map((rn, i) => (
                          <span class="badge badge-completed">
                            R{rn} — {maps[i] || ''}
                          </span>
                        ))}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {playerMatches.length > 0 && (
      <div>
        <h2 class="section-title">Recent Matches</h2>
        <div class="table-wrap">
          <table class="match-history-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>K/D/A</th>
              </tr>
            </thead>
            <tbody>
              {playerMatches.slice(0, 10).map(m => {
                const t1 = teamsMap.get(m.data.team1);
                const t2 = teamsMap.get(m.data.team2);
                const matchName = (t1 ? t1.data.name : m.data.team1) + ' vs ' + (t2 ? t2.data.name : m.data.team2);
                const ps = m.data.playerStats.find(ps => ps.uid === player.data.uid);
                
                let pKills = 0, pDeaths = 0, pAssists = 0;
                if (ps && ps.rounds) {
                  ps.rounds.forEach(r => {
                    pKills += r.kills || 0;
                    pDeaths += r.deaths || 0;
                    pAssists += r.assists || 0;
                  });
                }
                
                const wonMVP = (m.data.roundDetails || []).some(rd => rd.mvp === player.data.uid);
                
                return (
                  <tr>
                    <td>{m.data.date}</td>
                    <td>{m.data.tournament}</td>
                    <td>{m.data.round}</td>
                    <td><a href={`/matches/${m.id}`} class="match-link">{matchName}</a></td>
                    <td>
                      <div class="match-kda">
                        <span class="kda">
                          <span class="kill">{pKills}</span> / <span class="death">{pDeaths}</span> / <span class="assist">{pAssists}</span>
                        </span>
                        {wonMVP && <span class="badge badge-completed">MVP</span>}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .player-description {
    color: var(--text-secondary);
    max-width: 700px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .section-spacing { margin-bottom: 2.5rem; }

  /* Hero MVP Box */
  .hero-mvp {
    margin-left: auto;
    text-align: center;
    background: var(--bg-primary);
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .mvp-value { font-size: 2rem; font-weight: 800; color: #facc15; line-height: 1; }
  .mvp-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }

  /* Custom Stat Box Variants */
  .stat-kills { background: rgba(34, 197, 94, 0.12); border-color: rgba(34, 197, 94, 0.3); }
  .stat-kills .stat-value { color: #4ade80; }
  
  .stat-deaths { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.3); }
  .stat-deaths .stat-value { color: #f87171; }
  
  .stat-assists { background: rgba(168, 85, 247, 0.12); border-color: rgba(168, 85, 247, 0.3); }
  .stat-assists .stat-value { color: #c084fc; }
  
  .stat-kd { background: rgba(245, 158, 11, 0.12); border-color: rgba(245, 158, 11, 0.3); }
  .stat-kd .stat-value { color: #fbbf24; }
  
  .stat-matches { background: rgba(59, 130, 246, 0.12); border-color: rgba(59, 130, 246, 0.3); }
  .stat-matches .stat-value { color: #60a5fa; }
  
  .stat-mvp { background: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.3); }
  .stat-mvp .stat-value { color: #facc15; }

  /* Socials */
  .socials-list { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .badge-discord { background: #5865F2; color: white; }
  .badge-youtube { background: #FF0000; color: white; text-decoration: none; }
  .badge-twitch { background: #9146FF; color: white; text-decoration: none; }
  .badge-youtube:hover, .badge-twitch:hover { opacity: 0.9; }

  /* Table Helpers */
  .match-link { color: var(--text-primary); font-weight: 600; text-decoration: none; }
  .match-link:hover { color: var(--accent); }
  
  .mvp-rounds { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .match-kda { display: flex; align-items: center; gap: 0.5rem; }

  /* Mobile Hero Adjustment */
  @media (max-width: 600px) {
    .detail-hero { flex-direction: column; text-align: center; gap: 1rem; }
    .hero-mvp { margin-left: 0; width: 100%; }
    .hero-subtitle { display: flex; flex-direction: column; gap: 0.25rem; }
  }
</style>