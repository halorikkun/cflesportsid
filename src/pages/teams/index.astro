---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allMatches = await getCollection('matches');
const completedMatches = allMatches.filter(m => m.data.status === 'completed');

function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (m.data.team1 === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (m.data.team2 === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

const teams = (await getCollection('teams')).sort((a, b) => {
  const recA = getTeamRecord(a.id);
  const recB = getTeamRecord(b.id);
  return recB.wins - recA.wins;
});
---

<Layout title="Teams - CFL Tournament Hub" current="Teams">
  <div class="container">
    <div class="page-header">
      <h1>Teams</h1>
      <p>{teams.length} teams competing in CFL tournaments.</p>
    </div>

    <div style="display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap;">
      <input type="text" id="searchInput" placeholder="Search team name or tag..."
        style="flex: 1; min-width: 200px; padding: 0.5rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text-primary); font-size: 0.9rem;" />
      <select id="sortSelect" style="padding: 0.5rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text-primary); font-size: 0.9rem;">
        <option value="wins-desc">Most Wins</option>
        <option value="wins-asc">Least Wins</option>
        <option value="losses-desc">Most Losses</option>
        <option value="losses-asc">Least Losses</option>
        <option value="name-asc">Name (A-Z)</option>
        <option value="name-desc">Name (Z-A)</option>
        <option value="players-desc">Most Players</option>
      </select>
    </div>

    <div id="teamsGrid" class="grid grid-2">
      {teams.map(team => {
        const record = getTeamRecord(team.id);
        const searchText = (team.data.name + ' ' + team.data.tag).toLowerCase();
        return (
          <a href={`/teams/${team.id}`} class="card team-card" style="text-decoration: none; color: inherit;"
            data-search={searchText}
            data-wins={record.wins}
            data-losses={record.losses}
            data-players={team.data.players.length}
            data-name={team.data.name.toLowerCase()}
          >
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
              <div class="avatar" style="width: 56px; height: 56px; font-size: 1.3rem;">
                {team.data.tag.charAt(0)}
              </div>
              <div>
                <h3 style="font-size: 1.1rem;">{team.data.name}</h3>
                <span style="color: var(--text-muted); font-size: 0.8rem;">
                  [{team.data.tag}] · {team.data.region}
                </span>
              </div>
            </div>
            {team.data.description && (
              <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1rem;">
                {team.data.description}
              </p>
            )}
            <div class="stat-grid">
              <div class="stat-box" style="min-width: 80px; padding: 0.5rem;">
                <div class="stat-value" style="font-size: 1.2rem; color: var(--win);">{record.wins}</div>
                <div class="stat-label">Wins</div>
              </div>
              <div class="stat-box" style="min-width: 80px; padding: 0.5rem;">
                <div class="stat-value" style="font-size: 1.2rem; color: var(--loss);">{record.losses}</div>
                <div class="stat-label">Losses</div>
              </div>
              <div class="stat-box" style="min-width: 80px; padding: 0.5rem;">
                <div class="stat-value" style="font-size: 1.2rem; color: #f59e0b;">{team.data.players.length}</div>
                <div class="stat-label">Players</div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <p id="noResults" style="text-align: center; color: var(--text-muted); display: none; padding: 2rem;">No teams found.</p>
  </div>

  <script>
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const grid = document.getElementById('teamsGrid');
    const noResults = document.getElementById('noResults');
    const cards = Array.from(grid.querySelectorAll('.team-card'));

    function applyFilters() {
      const search = searchInput.value.toLowerCase();
      const sort = sortSelect.value;

      let visible = cards.filter(card => !search || card.dataset.search.includes(search));

      visible.sort((a, b) => {
        switch(sort) {
          case 'wins-desc': return parseInt(b.dataset.wins) - parseInt(a.dataset.wins);
          case 'wins-asc': return parseInt(a.dataset.wins) - parseInt(b.dataset.wins);
          case 'losses-desc': return parseInt(b.dataset.losses) - parseInt(a.dataset.losses);
          case 'losses-asc': return parseInt(a.dataset.losses) - parseInt(b.dataset.losses);
          case 'name-asc': return a.dataset.name.localeCompare(b.dataset.name);
          case 'name-desc': return b.dataset.name.localeCompare(a.dataset.name);
          case 'players-desc': return parseInt(b.dataset.players) - parseInt(a.dataset.players);
          default: return 0;
        }
      });

      visible.forEach(card => grid.appendChild(card));
      cards.forEach(card => { card.style.display = visible.includes(card) ? '' : 'none'; });
      noResults.style.display = visible.length === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', applyFilters);
    sortSelect.addEventListener('change', applyFilters);
  </script>
</Layout>
