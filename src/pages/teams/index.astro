---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats } from '../../utils/statistics';

const allMatches = await getCollection('matches');
const completedMatches = allMatches.filter(m => m.data.status === 'completed');

const calculated = calculateStatistics(allMatches);

const allPlayers = await getCollection('players');
const playersByUid = {};
allPlayers.forEach(p => {
  if (p.data.uid) playersByUid[p.data.uid] = p;
});

const teams = (await getCollection('teams')).map(team => {
  const record = calculated.teams.get(team.id) ?? emptyStats();
  let teamPlayers = team.data.players
    .map(uid => playersByUid[uid])
    .filter(Boolean);
    
  if (teamPlayers.length === 0) {
    teamPlayers = allPlayers.filter(p => p.data.team === team.id);
  }
  
  const { kills: totalKills, deaths: totalDeaths, assists: totalAssists } =
    record;

  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    region: team.data.region,
    wins: record.wins,
    losses: record.losses,
    totalKills,
    totalDeaths,
    totalAssists,
    players: teamPlayers.map(p => ({
      id: p.id,
      ign: p.data.ign,
      uid: p.data.uid,
      status: p.data.status || 'active',
    })),
    playerCount: teamPlayers.length,
  };
});
---

<Layout title="Teams - CFL Esports ID Tournament Hub" current="Teams">
  <div class="container">
    <div class="page-header">
      <h1>Teams</h1>
      <p>Search, sort, and filter all competing teams</p>
    </div>

    <div class="teams-toolbar">
      <input type="text" id="searchInput" placeholder="Search team name or tag..." class="teams-search" />
      <select id="sortSelect" class="teams-sort">
        <option value="name-asc">Name (A–Z)</option>
        <option value="name-desc">Name (Z–A)</option>
        <option value="wins-desc">Wins (High–Low)</option>
        <option value="wins-asc">Wins (Low–High)</option>
        <option value="losses-desc">Losses (High–Low)</option>
        <option value="losses-asc">Losses (Low–High)</option>
        <option value="kills-desc">Kills (High–Low)</option>
        <option value="kills-asc">Kills (Low–High)</option>
      </select>
    </div>

    <div class="teams-grid" id="teamsGrid">
      {teams.map(team => (
        <div class="team-card"
          data-name={team.name.toLowerCase()}
          data-tag={team.tag.toLowerCase()}
          data-wins={team.wins}
          data-losses={team.losses}
          data-kills={team.totalKills}
        >
          <div class="team-card-header">
            <img 
              src={team.logo || `/logos/${team.tag}.png`} 
              alt={team.name} 
              class="team-logo-small"
              onerror="this.onerror=null; this.src='/logos/default.png'"
            />
            <a href={`/teams/${team.id}`} class="team-name-link"><strong>{team.name}</strong></a>
            <span class="team-tag">[{team.tag}]</span>
            <span class="team-region">{team.region}</span>
          </div>

          <div class="team-card-stats">
            <div class="team-stat-group">
              <div class="team-stat-item">
                <span class="team-stat-label">Kills</span>
                <span class="text-win">{team.totalKills}</span>
              </div>
              <div class="team-stat-item">
                <span class="team-stat-label">Deaths</span>
                <span class="text-loss">{team.totalDeaths}</span>
              </div>
              <div class="team-stat-item">
                <span class="team-stat-label">Assists</span>
                <span class="text-assist">{team.totalAssists}</span>
              </div>
            </div>
            <div class="team-stat-group team-stat-wl">
              <div class="team-stat-item">
                <span class="team-stat-label">Wins</span>
                <span class="text-win">{team.wins}</span>
              </div>
              <div class="team-stat-item">
                <span class="team-stat-label">Losses</span>
                <span class="text-loss">{team.losses}</span>
              </div>
            </div>
          </div>

          <div class="team-players">
            <div class="team-players-label">Roster ({team.playerCount})</div>
            <!-- NEW: Wrapped in roster-list for scrollable containment -->
            <div class="roster-list">
              {team.players.map(p => (
                <div class="player-row">
                  <a href={`/players/${p.id}`} class="player-ign">{p.ign}</a>
                  <span class="player-uid">{p.uid}</span>
                  <span class={`player-status ${p.status === 'active' ? 'status-active' : 'status-inactive'}`}>
                    {p.status === 'active' ? 'Active' : 'Inactive'}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <p id="noResults" class="no-results">No teams found.</p>
    <div class="pagination" id="pagination"></div>
  </div>

  <script>
    // ... (Your existing JS remains exactly the same, it's perfect!) ...
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const grid = document.getElementById('teamsGrid');
    const noResults = document.getElementById('noResults');
    const pagination = document.getElementById('pagination');
    const cards = Array.from(grid.querySelectorAll('.team-card'));
    const perPage = 10;
    let currentPage = 1;

    function getVisibleCards() {
      const search = searchInput.value.toLowerCase();
      return cards.filter(card => {
        const matchesSearch = !search || card.dataset.name.includes(search) || card.dataset.tag.includes(search);
        return matchesSearch;
      });
    }

    function sortCards(visible) {
      const sortValue = sortSelect.value;
      const [key, dir] = sortValue.split('-');
      const isNumeric = ['wins', 'losses', 'kills'].includes(key);
      const asc = dir === 'asc';
      visible.sort((a, b) => {
        let valA, valB;
        if (isNumeric) {
          valA = parseFloat(a.dataset[key]);
          valB = parseFloat(b.dataset[key]);
          return asc ? valA - valB : valB - valA;
        } else {
          valA = a.dataset[key];
          valB = b.dataset[key];
          return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
      });
    }

    function render() {
      const visible = getVisibleCards();
      sortCards(visible);

      cards.forEach(card => { card.style.display = 'none'; grid.appendChild(card); });

      const totalPages = Math.ceil(visible.length / perPage);
      if (currentPage > totalPages) currentPage = 1;

      const start = (currentPage - 1) * perPage;
      const end = start + perPage;
      visible.slice(start, end).forEach(card => { card.style.display = ''; grid.appendChild(card); });

      noResults.style.display = visible.length === 0 ? 'block' : 'none';
      
      pagination.innerHTML = '';
      if (totalPages > 1) {
        const prev = document.createElement('button');
        prev.className = 'page-btn';
        prev.textContent = '‹';
        prev.disabled = currentPage === 1;
        prev.addEventListener('click', () => { currentPage--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
        pagination.appendChild(prev);

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
          btn.textContent = i;
          btn.addEventListener('click', () => { currentPage = i; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
          pagination.appendChild(btn);
        }

        const next = document.createElement('button');
        next.className = 'page-btn';
        next.textContent = '›';
        next.disabled = currentPage === totalPages;
        next.addEventListener('click', () => { currentPage++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
        pagination.appendChild(next);
      }
    }

    searchInput.addEventListener('input', () => { currentPage = 1; render(); });
    sortSelect.addEventListener('change', () => { currentPage = 1; render(); });
    render();
  </script>
</Layout>

<style>
  /* NEW: Responsive grid instead of single column */
  .teams-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); 
    gap: 1.5rem;
  }

  .teams-toolbar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  
  /* NEW: Stack toolbar on very small screens */
  @media (max-width: 480px) {
    .teams-toolbar { flex-direction: column; }
    .teams-search { width: 100%; }
    .teams-grid { 
      grid-template-columns: 1fr; 
    }
  }

  .teams-search, .teams-sort {
    padding: 0.6rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 0.9rem;
  }
  .teams-search { flex: 1; min-width: 200px; }
  .teams-sort { cursor: pointer; }
  .teams-sort:focus, .teams-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .team-card {
    /* Inherits global .card styles, ensuring equal height in grid */
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .team-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .team-name-link { font-size: 1.1rem; }
  .team-tag { color: var(--text-muted); font-size: 0.85rem; font-weight: 600; }
  .team-region {
    margin-left: auto;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: var(--accent-dim);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .team-card-stats {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .team-stat-group { display: flex; gap: 1.5rem; }
  .team-stat-wl { flex-direction: row; }
  .team-stat-item { display: flex; flex-direction: column; gap: 0.15rem; text-align: center; }
  .team-stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  /* NEW: Utility classes to replace inline styles */
  .text-win { color: var(--win); font-weight: 700; }
  .text-loss { color: var(--loss); font-weight: 700; }
  .text-assist { color: var(--assist); font-weight: 700; }

  .team-players {
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
    margin-top: auto; /* Pushes to bottom of card */
  }
  .team-players-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  /* NEW: Scrollable roster container */
  .roster-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 180px; /* Prevents card from getting too tall */
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .roster-list::-webkit-scrollbar { width: 4px; }
  .roster-list::-webkit-scrollbar-track { background: transparent; }
  .roster-list::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 4px; }

  .player-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .player-row:last-child { border-bottom: none; }
  .player-ign {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px; /* Prevents long names from breaking layout */
  }
  .player-ign:hover { color: var(--accent); }
  .player-uid {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .player-status {
    margin-left: auto;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    flex-shrink: 0;
  }
  
  .status-active { background: rgba(34, 197, 94, 0.15); color: var(--win); }
  .status-inactive { background: rgba(156, 163, 175, 0.15); color: var(--text-muted); }
  
  .no-results { text-align: center; color: var(--text-muted); display: none; padding: 2rem; }
</style>