---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allMatches = await getCollection('matches');
const completedMatches = allMatches.filter(m => m.data.status === 'completed');

function getTeamRecord(teamId) {
  let wins = 0, losses = 0;
  completedMatches.forEach(m => {
    if (m.data.team1 === teamId) {
      if (m.data.score1 > m.data.score2) wins++;
      else if (m.data.score1 < m.data.score2) losses++;
    } else if (m.data.team2 === teamId) {
      if (m.data.score2 > m.data.score1) wins++;
      else if (m.data.score2 < m.data.score1) losses++;
    }
  });
  return { wins, losses };
}

const allPlayers = await getCollection('players');

function getTeamKills(teamId) {
  return allPlayers.filter(p => p.data.team === teamId).reduce((sum, p) => sum + p.data.stats.kills, 0);
}

const teams = (await getCollection('teams')).map(team => {
  const record = getTeamRecord(team.id);
  const kills = getTeamKills(team.id);
  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    region: team.data.region,
    wins: record.wins,
    losses: record.losses,
    players: team.data.players.length,
    kills,
  };
});
---

<Layout title="Teams - CFL Tournament Hub" current="Teams">
  <div class="container">
    <div class="page-header">
      <h1>Teams</h1>
      <p>{teams.length} teams competing in CFL tournaments.</p>
    </div>

    <div style="display: flex; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <input type="text" id="searchInput" placeholder="Search team name or tag..."
        style="flex: 1; min-width: 200px; padding: 0.5rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text-primary); font-size: 0.9rem;" />
    </div>

    <div id="sortBar" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center;">
      <span style="color: var(--text-muted); font-size: 0.85rem;">Sort by:</span>
    </div>

    <div class="table-wrap">
      <table id="teamsTable">
        <thead>
          <tr>
            <th class="sortable" data-key="name" style="cursor: pointer;">Team <span class="arrow"></span></th>
            <th class="sortable" data-key="tag" style="cursor: pointer;">Tag <span class="arrow"></span></th>
            <th class="sortable" data-key="wins" data-numeric="true" style="cursor: pointer;">Wins <span class="arrow"></span></th>
            <th class="sortable" data-key="losses" data-numeric="true" style="cursor: pointer;">Losses <span class="arrow"></span></th>
            <th class="sortable" data-key="players" data-numeric="true" style="cursor: pointer;">Players <span class="arrow"></span></th>
            <th class="sortable" data-key="kills" data-numeric="true" style="cursor: pointer;">Kills <span class="arrow"></span></th>
          </tr>
        </thead>
        <tbody id="teamsBody">
          {teams.map(team => (
            <tr data-name={team.name.toLowerCase()} data-tag={team.tag.toLowerCase()}
                data-wins={team.wins} data-losses={team.losses} data-players={team.players} data-kills={team.kills}>
              <td><a href={`/teams/${team.id}`}><strong>{team.name}</strong></a></td>
              <td style="color: var(--text-muted);">[{team.tag}]</td>
              <td style="color: var(--win); font-weight: 700;">{team.wins}</td>
              <td style="color: var(--loss); font-weight: 700;">{team.losses}</td>
              <td style="color: #f59e0b; font-weight: 700;">{team.players}</td>
              <td class="kda"><span class="kill">{team.kills}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="noResults" style="text-align: center; color: var(--text-muted); display: none; padding: 2rem;">No teams found.</p>
  </div>

  <script>
    const searchInput = document.getElementById('searchInput');
    const tbody = document.getElementById('teamsBody');
    const noResults = document.getElementById('noResults');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const headers = document.querySelectorAll('.sortable');
    let sortKey = 'name';
    let sortDir = 'asc';
    let isNumeric = false;

    function sortRows() {
      rows.sort((a, b) => {
        let valA, valB;
        if (isNumeric) {
          valA = parseFloat(a.dataset[sortKey]);
          valB = parseFloat(b.dataset[sortKey]);
        } else {
          valA = a.dataset[sortKey];
          valB = b.dataset[sortKey];
        }
        let result;
        if (isNumeric) result = valA - valB;
        else result = valA.localeCompare(valB);
        return sortDir === 'asc' ? result : -result;
      });
      rows.forEach(row => tbody.appendChild(row));
    }

    function applyFilters() {
      const search = searchInput.value.toLowerCase();
      let visible = 0;
      rows.forEach(row => {
        const matchesSearch = !search || row.dataset.name.includes(search) || row.dataset.tag.includes(search);
        row.style.display = matchesSearch ? '' : 'none';
        if (matchesSearch) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    headers.forEach(header => {
      const arrow = header.querySelector('.arrow');
      header.addEventListener('click', () => {
        const key = header.dataset.key;
        isNumeric = header.dataset.numeric === 'true';
        if (sortKey === key) {
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = key;
          sortDir = isNumeric ? 'desc' : 'asc';
        }
        headers.forEach(h => {
          h.style.color = '';
          h.querySelector('.arrow').textContent = '';
        });
        header.style.color = 'var(--accent)';
        arrow.textContent = sortDir === 'asc' ? ' ↑' : ' ↓';
        sortRows();
      });
    });

    // Default sort
    const defaultHeader = document.querySelector('[data-key="name"]');
    defaultHeader.style.color = 'var(--accent)';
    defaultHeader.querySelector('.arrow').textContent = ' ↑';
    sortRows();

    searchInput.addEventListener('input', applyFilters);
  </script>
</Layout>
