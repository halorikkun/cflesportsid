---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats } from '../../utils/statistics';

const allMatches = await getCollection('matches');
const calculated = calculateStatistics(allMatches);

const allPlayers = await getCollection('players');
const playersByUid = {};

allPlayers.forEach(p => {
  if (p.data.uid) playersByUid[p.data.uid] = p;
});

const teams = (await getCollection('teams')).map(team => {
  const record = calculated.teams.get(team.id) ?? emptyStats();

  let teamPlayers = team.data.players
    .map(uid => playersByUid[uid])
    .filter(Boolean);

  if (teamPlayers.length === 0) {
    teamPlayers = allPlayers.filter(p => p.data.team === team.id);
  }

  const {
    kills: totalKills,
    deaths: totalDeaths,
    assists: totalAssists
  } = record;

  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    logo: team.data.logo,
    region: team.data.region,

    // Team identity color from team JSON.
    // Neutral gray is used when no color is defined.
    color: team.data.color || '#777B82',

    wins: record.wins,
    losses: record.losses,
    totalKills,
    totalDeaths,
    totalAssists,

    players: teamPlayers.map(p => ({
      id: p.id,
      ign: p.data.ign,
      uid: p.data.uid,
      status: p.data.status || 'active',
    })),

    playerCount: teamPlayers.length,
  };
});
---

<Layout title="Teams - CFL Esports ID Tournament Hub" current="Teams">
  <div class="container">

    <div class="page-header">
      <h1>Teams</h1>
      <p>Search, sort, and filter all competing teams</p>
    </div>

    <div class="teams-toolbar">
      <input
        type="text"
        id="searchInput"
        aria-label="Search teams"
        placeholder="Search team name or tag..."
        class="teams-search"
      />

      <select
        id="sortSelect"
        aria-label="Sort teams"
        class="teams-sort"
      >
        <option value="name-asc">Name (A–Z)</option>
        <option value="name-desc">Name (Z–A)</option>
        <option value="wins-desc">Wins (High–Low)</option>
        <option value="wins-asc">Wins (Low–High)</option>
        <option value="losses-desc">Losses (High–Low)</option>
        <option value="losses-asc">Losses (Low–High)</option>
        <option value="kills-desc">Kills (High–Low)</option>
        <option value="kills-asc">Kills (Low–High)</option>
      </select>
    </div>

    <div class="teams-grid" id="teamsGrid">

      {teams.map(team => (
        <div
          class="team-card club-card"
          style={`--team-color: ${team.color};`}
          data-name={team.name.toLowerCase()}
          data-tag={team.tag.toLowerCase()}
          data-wins={team.wins}
          data-losses={team.losses}
          data-kills={team.totalKills}
        >

          <div class="club-identity">
            <img
              src={team.logo || `/logos/${team.tag}.webp`}
              alt=""
              width="64"
              height="64"
              onerror="this.onerror=null; this.src='/logos/default.webp'"
            />

            <h2>{team.name}</h2>
          </div>

          <div class="club-meta">
            <strong>{team.tag}</strong>

            <span>
              {team.region === 'ID'
                ? 'Indonesia'
                : team.region}
            </span>
          </div>

          <a
            class="club-info"
            href={`/teams/${team.id}`}
          >
            Team info
            <span aria-hidden="true">→</span>
          </a>

        </div>
      ))}

    </div>

    <p id="noResults" class="no-results">
      No teams found.
    </p>

  </div>

  <script>
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const grid = document.getElementById('teamsGrid');
    const noResults = document.getElementById('noResults');

    const cards = Array.from(
      grid.querySelectorAll('.team-card')
    );

    function getVisibleCards() {
      const search = searchInput.value
        .toLowerCase()
        .trim();

      return cards.filter(card => {
        return (
          !search ||
          card.dataset.name.includes(search) ||
          card.dataset.tag.includes(search)
        );
      });
    }

    function sortCards(visible) {
      const [key, dir] =
        sortSelect.value.split('-');

      const isNumeric =
        ['wins', 'losses', 'kills'].includes(key);

      const asc = dir === 'asc';

      visible.sort((a, b) => {
        let valA = a.dataset[key] ?? '';
        let valB = b.dataset[key] ?? '';

        if (isNumeric) {
          valA = Number(valA);
          valB = Number(valB);

          return asc
            ? valA - valB
            : valB - valA;
        }

        return asc
          ? valA.localeCompare(valB)
          : valB.localeCompare(valA);
      });
    }

    function render() {
      const visible = getVisibleCards();

      sortCards(visible);

      cards.forEach(card => {
        card.style.display = 'none';
      });

      visible.forEach(card => {
        card.style.display = '';
        grid.appendChild(card);
      });

      noResults.style.display =
        visible.length === 0
          ? 'block'
          : 'none';
    }

    searchInput.addEventListener('input', render);
    sortSelect.addEventListener('change', render);

    render();
  </script>

</Layout>

<style>

  /* =========================
     GRID
     ========================= */

  .teams-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }


  /* =========================
     TOOLBAR
     ========================= */

  .teams-toolbar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .teams-search,
  .teams-sort {
    padding: 0.6rem 0.75rem;

    background: var(--bg-card);
    color: var(--text-primary);

    border: 1px solid var(--border);
    border-radius: var(--radius);

    font-size: 0.9rem;
  }

  .teams-search {
    flex: 1;
    min-width: 200px;
  }

  .teams-sort {
    cursor: pointer;
  }

  .teams-search:focus,
  .teams-sort:focus {
    outline: none;
    border-color: var(--accent);
  }


  /* =========================
     TEAM CARD
     ========================= */

  .team-card {
    position: relative;

    height: 100%;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    /*
     * TEAM COLOR
     *
     * The color comes from:
     * team.data.color
     *
     * NOT from the logo.
     */

    border-color:
      color-mix(
        in srgb,
        var(--team-color) 35%,
        var(--border)
      );

    border-top:
      3px solid var(--team-color);

    transition:
      border-color 150ms ease;
  }

  .team-card:hover {
    border-color:
      color-mix(
        in srgb,
        var(--team-color) 65%,
        var(--border)
      );

    border-top-color:
      var(--team-color);
  }


  /* =========================
     CLUB IDENTITY
     ========================= */

  .club-identity {
    position: relative;
    z-index: 1;
  }

  .club-identity img {
    object-fit: contain;
  }


  /* =========================
     CLUB META
     ========================= */

  .club-meta {
    position: relative;
    z-index: 1;
  }


  /* =========================
     TEAM INFO
     ========================= */

  /*
   * Deliberately stays CFL orange.
   * Team color = identity.
   * Orange = interaction/action.
   */

  .club-info {
    position: relative;
    z-index: 2;

    color: var(--accent);
  }

  .club-info:hover {
    color: var(--accent-hover);
  }


  /* =========================
     NO RESULTS
     ========================= */

  .no-results {
    display: none;

    padding: 2rem;

    color: var(--text-muted);

    text-align: center;
  }


  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 480px) {

    .teams-toolbar {
      flex-direction: column;
    }

    .teams-search {
      width: 100%;
    }

    .teams-grid {
      grid-template-columns: 1fr;
    }

  }

  .team-card.club-card {
    background:
      color-mix(
        in srgb,
        var(--team-color) 14%,
        #272624
      ) !important;

    border: 1px solid
      color-mix(
        in srgb,
        var(--team-color) 32%,
        #45423e
      ) !important;

    border-top: 3px solid var(--team-color) !important;
  }

  .team-card.club-card .club-info {
    background:
      color-mix(
        in srgb,
        var(--team-color) 10%,
        #211f1d
      ) !important;

    border-top: 1px solid
      color-mix(
        in srgb,
        var(--team-color) 25%,
        #45423e
      ) !important;

    color: var(--accent) !important;
  }

  .team-card.club-card .club-info span {
    color: var(--accent) !important;
  }

</style>