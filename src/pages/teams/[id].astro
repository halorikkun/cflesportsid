---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const teams = await getCollection('teams');
  return teams.map(team => ({
    params: { id: team.id },
    props: { team },
  }));
}

const { team } = Astro.props;
const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));
const playersMap = new Map(allPlayers.map(p => [p.id, p]));
const teamPlayers = team.data.players.map(pid => playersMap.get(pid)).filter(Boolean);
const allMatches = await getCollection('matches');

const teamMatches = allMatches.filter(
  m => m.data.team1 === team.id || m.data.team2 === team.id
);

const completedMatches = teamMatches.filter(m => m.data.status === 'completed');

let wins = 0, losses = 0;
completedMatches.forEach(m => {
  if (m.data.team1 === team.id) {
    if (m.data.score1 > m.data.score2) wins++;
    else if (m.data.score1 < m.data.score2) losses++;
  } else if (m.data.team2 === team.id) {
    if (m.data.score2 > m.data.score1) wins++;
    else if (m.data.score2 < m.data.score1) losses++;
  }
});
const matchesPlayed = completedMatches.length;

let totalKills = 0, totalDeaths = 0, totalAssists = 0;
teamPlayers.forEach(p => {
  totalKills += p.data.stats.kills;
  totalDeaths += p.data.stats.deaths;
  totalAssists += p.data.stats.assists;
});

// Round priority for sorting (Final first)
const roundPriority = {
  'Final': 1,
  'Semifinal': 2,
  'Quarter Final': 3,
  'Top 16': 4,
  'Round 3': 5,
  'Round 2': 6,
  'Round 1': 7,
};

// Sort match history: by date first (newest first), then by round priority
const sortedMatches = [...teamMatches].sort((a, b) => {
  const dateA = new Date(a.data.date).getTime() || 0;
  const dateB = new Date(b.data.date).getTime() || 0;
  if (dateB !== dateA) return dateB - dateA;
  const prioA = roundPriority[a.data.round] || 99;
  const prioB = roundPriority[b.data.round] || 99;
  return prioA - prioB;
});
---

<Layout title={`${team.data.name} - CFL Esports ID Tournament Hub`} current="Teams">
  <div class="container">
    <div class="page-header">
      <h1>{team.data.name} <span style="color: var(--text-muted); font-size: 1rem;">[{team.data.tag}]</span></h1>
      <p style="font-size: 1.1rem; color: var(--accent); font-weight: 600;">{team.data.region} · {teamPlayers.filter(p => (p.data.status || 'active') === 'active').length} active players</p>
    </div>


    {team.data.description && (
      <p style="color: var(--text-secondary); margin-bottom: 2rem; max-width: 600px;">{team.data.description}</p>
    )}

    <h2 style="margin-bottom: 1rem;">Team Record</h2>
    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-box">
        <div class="stat-value">{matchesPlayed}</div>
        <div class="stat-label">Matches</div>
      </div>
      <div class="stat-box stat-box-win">
        <div class="stat-value">{wins}</div>
        <div class="stat-label">Wins</div>
      </div>
      <div class="stat-box stat-box-loss">
        <div class="stat-value">{losses}</div>
        <div class="stat-label">Losses</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem;">Match Stats</h2>
    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-box stat-box-kill">
        <div class="stat-value">{totalKills}</div>
        <div class="stat-label">Kills</div>
      </div>
      <div class="stat-box stat-box-death">
        <div class="stat-value">{totalDeaths}</div>
        <div class="stat-label">Deaths</div>
      </div>
      <div class="stat-box stat-box-assist">
        <div class="stat-value">{totalAssists}</div>
        <div class="stat-label">Assists</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem;">Roster</h2>
    <div class="grid grid-3" style="margin-bottom: 2rem;">
      {teamPlayers.map(player => (
        <div class="card" style="text-decoration: none; color: inherit;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div class="avatar">{player.data.ign.charAt(0).toUpperCase()}</div>
            <div style="flex: 1;">
              <strong>{player.data.ign}</strong>
              <div style="color: var(--text-muted); font-size: 0.8rem;">{player.data.role}</div>
            </div>
            <span class={`badge ${player.data.status === 'inactive' ? 'badge-upcoming' : 'badge-completed'}`}>
              {player.data.status === 'inactive' ? 'Inactive' : 'Active'}
            </span>
          </div>
        </div>
      ))}
    </div>

    {sortedMatches.length > 0 && (
      <div>
        <h2 style="margin-bottom: 1rem;">Match History</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Opponent</th>
                <th>Score</th>
                <th>Result</th>
              </tr>
            </thead>
            <tbody>
              {sortedMatches.map(m => {
                const isTeam1 = m.data.team1 === team.id;
                const opponentId = isTeam1 ? m.data.team2 : m.data.team1;
                const opponent = teamsMap.get(opponentId);
                const myScore = isTeam1 ? m.data.score1 : m.data.score2;
                const oppScore = isTeam1 ? m.data.score2 : m.data.score1;
                const won = m.data.winner === team.id;
                const resultBadge = m.data.status === 'completed'
                  ? (won ? 'badge-win' : 'badge-loss')
                  : 'badge-upcoming';
                const resultText = m.data.status === 'completed'
                  ? (won ? 'Win' : 'Loss')
                  : m.data.status;
                return (
                  <tr>
                    <td style="color: var(--text-muted);">{m.data.date}</td>
                    <td>{m.data.tournament}</td>
                    <td>{m.data.round}</td>
                    <td><a href={`/teams/${opponentId}`}>{opponent ? opponent.data.name : opponentId}</a></td>
                    <td>{myScore} - {oppScore}</td>
                    <td><span class={`badge ${resultBadge}`}>{resultText}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</Layout>
